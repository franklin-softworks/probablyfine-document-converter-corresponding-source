+// BUG-80 (same input and settings give the same output bytes): the redline's identifier, which ODF export writes as the tracked change's id ("ct<digits>"), used to be the
+// redline object's ADDRESS: different on every run, so two conversions of one document wrote different files. It is now the redline's position in the document's
+// redline table (sorted by document position, so it is the same on every run and unique within the document). A redline that is not in the table keeps the address.
+static OUString lcl_GetRedlineIdentifier(const SwRangeRedline& rRedline)
+{
+    const SwRedlineTable& rTable = rRedline.GetDoc().getIDocumentRedlineAccess().GetRedlineTable();
+    const SwRedlineTable::size_type nPos = rTable.GetPos(&rRedline);
+    if (nPos != SwRedlineTable::npos)
+        return OUString::number(static_cast<sal_Int64>(nPos));
+    return OUString::number(sal::static_int_cast<sal_Int64>(reinterpret_cast<sal_IntPtr>(&rRedline)));
+}
