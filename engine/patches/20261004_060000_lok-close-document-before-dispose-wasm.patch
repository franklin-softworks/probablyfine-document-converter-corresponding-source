+// WASM: live task-frame count, for the frame-leak measurement in the destructor below.
+static void lcl_logLiveFrames(const char* pWhen)
+{
+    try
+    {
+        uno::Reference<frame::XDesktop2> xDesktop
+            = frame::Desktop::create(comphelper::getProcessComponentContext());
+        uno::Reference<frame::XFrames> xFrames = xDesktop->getFrames();
+        std::cerr << "[LOK] frames alive " << pWhen << ": "
+                  << (xFrames.is() ? xFrames->getCount() : -1) << std::endl;
+    }
+    catch (const uno::Exception&)
+    {
+        std::cerr << "[LOK] frames alive " << pWhen << ": unknown" << std::endl;
+    }
+}
