+                    const EditTextObject& rTextObj(rSdrBlockTextPrimitive.getOutlinerParaObject().GetTextObject());
+                    const sal_Int32 nParas(rTextObj.GetParagraphCount());
+                    bool bAgree(nParas > 0);
+                    SvxAdjust eCommon(SvxAdjust::Left);
+                    for (sal_Int32 nPara = 0; bAgree && nPara < nParas; ++nPara)
+                    {
+                        const SfxItemSet& rParaSet(rTextObj.GetParaAttribs(nPara));
+                        if (rParaSet.GetItemState(EE_PARA_JUST, false) != SfxItemState::SET)
+                        {
+                            bAgree = false;
