+                        else if (eAdjust != eCommon)
+                            bAgree = false;
+                    }
+                    if (bAgree)
+                    {
+                        bLift = true;
+                        bNoWrapGrowBlock = true;
+                        eNoWrapGrowAdjust = eCommon;
+                    }
+                }
