     return Contains( _rAnchoredObj );
 }
@@ -298,6 +310,8 @@
     else
     {
         maSortedObjLst.erase( aDelPosIter );
+        if (lcl_IsFlyInContent(_rAnchoredObj))
+            --mnFlysInContent;
     }
 }
 
