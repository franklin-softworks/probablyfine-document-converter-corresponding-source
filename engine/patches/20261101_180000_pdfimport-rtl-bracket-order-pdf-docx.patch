+namespace {
+
+bool lcl_isRtlLetter(sal_uInt32 c)
+{
+    return (c >= 0x0590 && c <= 0x08FF) || (c >= 0xFB1D && c <= 0xFDFF) || (c >= 0xFE70 && c <= 0xFEFF);
+}
+
+// the closing bracket that pairs with an opening one, or 0
+sal_uInt32 lcl_closerOf(sal_uInt32 c)
+{
+    switch (c)
+    {
+        case '(': return ')';
+        case '[': return ']';
+        case '{': return '}';
+        case '<': return '>';
+        case 0x00AB: return 0x00BB;   // « »
+        case 0x2039: return 0x203A;   // ‹ ›
+        default: return 0;
+    }
+}
+
+bool lcl_isCloser(sal_uInt32 c)
+{
+    return c == ')' || c == ']' || c == '}' || c == '>' || c == 0x00BB || c == 0x203A;
+}
+
+}
+
+// BUG-42: count the bracket pairs of a font by the order they appear in the stream. A pair that reads
+// opener-first is visual order (the glyph is stored as it looks); a closer with no opener before it,
+// seen in right-to-left text, is a logical code point drawn mirrored. Only pairs in a line that has
+// right-to-left letters count, so Latin "(a)" in the same font does not vote.
+// "LUSIXU+TheMixArab-Bold" and "TheMixArab" are one family: drop the subset prefix and the style suffix.
+OUString PDFIProcessor::bracketFamilyOf(sal_Int32 nFontId) const
+{
+    OUString aName = getFont(nFontId).familyName;
+    const sal_Int32 nPlus = aName.indexOf('+');
+    if (nPlus == 6)
+        aName = aName.copy(nPlus + 1);
+    const sal_Int32 nCut = aName.indexOf(u'-', 1);
+    sal_Int32 nEnd = nCut >= 0 ? nCut : aName.getLength();
+    const sal_Int32 nComma = aName.indexOf(',');
+    if (nComma >= 0 && nComma < nEnd)
+        nEnd = nComma;
+    return aName.copy(0, nEnd);
+}
+
+void PDFIProcessor::noteBracketGlyph(sal_Int32 nFontId, std::u16string_view aGlyph)
+{
+    BracketOrder& rEntry = m_aBracketOrder[bracketFamilyOf(nFontId)];
+    for (sal_Int32 i = 0; i < static_cast<sal_Int32>(aGlyph.size());)
+    {
+        const sal_uInt32 c = o3tl::iterateCodePoints(aGlyph, &i);
+        if (lcl_isRtlLetter(c))
+        {
+            rEntry.bRtlSeen = true;
+        }
+        else if (const sal_uInt32 nCloser = lcl_closerOf(c))
+        {
+            if (rEntry.aClosers.size() < 64)
+                rEntry.aClosers.push_back(nCloser);
+        }
+        else if (lcl_isCloser(c))
+        {
+            if (!rEntry.aClosers.empty() && rEntry.aClosers.back() == c)
+            {
+                rEntry.aClosers.pop_back();
+                if (rEntry.bRtlSeen)
+                    ++rEntry.nVisual;
+            }
+            else if (rEntry.bRtlSeen)
+            {
+                ++rEntry.nLogical;
+            }
+        }
+    }
+}
+
+bool PDFIProcessor::isLogicalBracketFont(sal_Int32 nFontId) const
+{
+    const auto it = m_aBracketOrder.find(bracketFamilyOf(nFontId));
+    return it != m_aBracketOrder.end() && it->second.nLogical >= 3
+           && it->second.nLogical > 2 * it->second.nVisual;
+}
+
 /* Produce mirrored-image for each code point which has the Bidi_Mirrored property, within a string.
    This need to be done in forward order.
 */
diff --git a/sdext/source/pdfimport/tree/writertreevisiting.cxx b/sdext/source/pdfimport/tree/writertreevisiting.cxx
--- a/sdext/source/pdfimport/tree/writertreevisiting.cxx
+++ b/sdext/source/pdfimport/tree/writertreevisiting.cxx
@@ -175,8 +175,10 @@
 
     if (isRTL)  // If so, reverse string
     {
-        // First, produce mirrored-image for each code point which has the Bidi_Mirrored property.
-        str = PDFIProcessor::SubstituteBidiMirrored(str);
+        // First, produce mirrored-image for each code point which has the Bidi_Mirrored property,
+        // unless this font stores the logical code point of its brackets already (BUG-42).
+        if (!m_rEmitContext.rProcessor.isLogicalBracketFont(elem.FontId))
+            str = PDFIProcessor::SubstituteBidiMirrored(str);
         // Then, reverse the code points in the string, in backward order.
         str = ::comphelper::string::reverseCodePoints(str);
     }
