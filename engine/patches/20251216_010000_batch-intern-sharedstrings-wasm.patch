+// Fast ASCII-only uppercase conversion to avoid UNO service calls for common cases.
+// Returns empty OUString if string contains non-ASCII characters.
+OUString fastAsciiUppercase(const OUString& rStr)
+{
+    const sal_Int32 nLen = rStr.getLength();
+    const sal_Unicode* pChars = rStr.getStr();
+
+    // First pass: check if all ASCII and if any lowercase
+    bool bHasLowercase = false;
+    for (sal_Int32 i = 0; i < nLen; ++i)
+    {
+        sal_Unicode c = pChars[i];
+        if (c > 127)
+            return OUString(); // Non-ASCII, caller must use CharClass
+        if (c >= 'a' && c <= 'z')
+            bHasLowercase = true;
+    }
+
+    // If no lowercase, the string is already uppercase
+    if (!bHasLowercase)
+        return rStr;
+
+    // Convert to uppercase
+    OUStringBuffer aBuf(nLen);
+    for (sal_Int32 i = 0; i < nLen; ++i)
+    {
+        sal_Unicode c = pChars[i];
+        if (c >= 'a' && c <= 'z')
+            aBuf.append(static_cast<sal_Unicode>(c - 32));
+        else
+            aBuf.append(c);
+    }
+    return aBuf.makeStringAndClear();
+}
+}
