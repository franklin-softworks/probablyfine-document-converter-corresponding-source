+void SharedStringPool::internBatch(const std::vector<OUString>& rStrings, size_t nChunkSize)
+{
+    if (rStrings.empty())
+        return;
+
+    // Use default chunk size if not specified
+    if (nChunkSize == 0)
+        nChunkSize = rStrings.size();
+
+    // Process strings in chunks to allow progress reporting and reduce lock contention
+    const size_t nTotal = rStrings.size();
+
+    for (size_t nStart = 0; nStart < nTotal; nStart += nChunkSize)
+    {
+        const size_t nEnd = std::min(nStart + nChunkSize, nTotal);
+
+        // Hold lock for the duration of this chunk
+        std::scoped_lock<std::mutex> aGuard(mpImpl->maMutex);
+
+        for (size_t i = nStart; i < nEnd; ++i)
+        {
+            const OUString& rStr = rStrings[i];
+            StringWithHash aStrWithHash(rStr);
+
+            // Check if already in pool
+            auto [mapIt, bInserted] = mpImpl->maStrMap.emplace(aStrWithHash, rStr);
+            if (!bInserted)
+                continue; // Already exists, skip
+
+            // New string - compute uppercase
+            // Try fast ASCII path first to avoid expensive UNO call
+            OUString aUpper = fastAsciiUppercase(rStr);
+            if (aUpper.isEmpty() && !rStr.isEmpty())
+            {
+                // Non-ASCII string, must use CharClass (UNO service)
+                aUpper = mpImpl->mrCharClass.uppercase(rStr);
+            }
+
+            if (aUpper == rStr)
+                continue; // Already uppercase mapping
+
+            // Insert lower->upper mapping
+            StringWithHash aUpperWithHash(aUpper);
+            auto mapIt2 = mpImpl->maStrMap.find(aUpperWithHash);
+            if (mapIt2 != mpImpl->maStrMap.end())
+            {
+                // Upper string already exists
+                mapIt->second = mapIt2->first.str;
+            }
+            else
+            {
+                // Insert new upper->upper mapping
+                mapIt->second = aUpper;
+                mpImpl->maStrMap.emplace_hint(mapIt2, aUpperWithHash, aUpper);
+            }
+        }
+    }
+}
+#endif
