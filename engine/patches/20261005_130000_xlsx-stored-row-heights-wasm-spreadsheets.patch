diff --git a/sc/source/filter/oox/worksheethelper.cxx b/sc/source/filter/oox/worksheethelper.cxx
--- a/sc/source/filter/oox/worksheethelper.cxx
+++ b/sc/source/filter/oox/worksheethelper.cxx
@@ -83,6 +83,36 @@
 
 namespace oox::xls {
 
+#ifdef __EMSCRIPTEN__
+namespace {
+struct StoredHeightRows { ScDocument* pDoc; SCTAB nTab; SCROW nStart; SCROW nEnd; };
+// FG-154: rows temporarily marked manual by convertRows(). One import at a time
+// in this single-threaded build; entries are keyed by document and released by
+// WorkbookGlobals::finalize() after the optimal-height pass.
+std::vector<StoredHeightRows>& storedHeightRows()
+{
+    static std::vector<StoredHeightRows> aRows;
+    return aRows;
+}
+}
+
+void resetStoredRowHeights()
+{
+    storedHeightRows().clear();
+}
+
+void releaseStoredRowHeights(ScDocument& rDoc)
+{
+    auto& rRows = storedHeightRows();
+    for (const auto& r : rRows)
+        if (r.pDoc == &rDoc)
+            rDoc.SetManualHeight(r.nStart, r.nEnd, r.nTab, false);
+    rRows.erase(std::remove_if(rRows.begin(), rRows.end(),
+                               [&rDoc](const StoredHeightRows& r) { return r.pDoc == &rDoc; }),
+                rRows.end());
+}
+#endif
+
 using namespace ::com::sun::star;
 using namespace ::com::sun::star::beans;
 using namespace ::com::sun::star::drawing;
@@ -1266,6 +1296,18 @@
         rDoc.SetRowHeightOnly(nStartRow, nEndRow, nTab, nHeight);
         if(rModel.mbCustomHeight)
             rDoc.SetManualHeight( nStartRow, nEndRow, nTab, true );
+#ifdef __EMSCRIPTEN__
+        // FG-154: a height the file stores (ht present, not customHeight) is
+        // trusted as Excel does: held as manual during the optimal-height pass,
+        // which then measures only rows the file left without a height. On a
