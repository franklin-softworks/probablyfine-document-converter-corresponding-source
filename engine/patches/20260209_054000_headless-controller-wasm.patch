@@ -156,12 +156,20 @@ static sal_Int32 m_nInReschedule = 0;  /// static counter for rescheduling
 
 static void reschedule()
 {
+#ifdef __EMSCRIPTEN__
+    // In WASM, Application::Reschedule() can cause deadlocks when called
+    // repeatedly during long operations like PDF export. The reschedule
+    // is meant to keep the UI responsive, but in headless WASM mode
+    // there's no UI to update, so we can safely skip it.
+    (void)m_nInReschedule; // suppress unused variable warning
+#else
     if ( m_nInReschedule == 0 )
     {
         ++m_nInReschedule;
         Application::Reschedule();
         --m_nInReschedule;
     }
+#endif
 }
 
