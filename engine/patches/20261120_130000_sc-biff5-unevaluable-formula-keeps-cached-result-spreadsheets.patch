+// BUG-90: an array formula that cannot be evaluated (ocBad: an external reference whose file is not there) is not made into a matrix, which would show #NAME? in every cell; the
+// cells keep the results the file cached (the FORMULA numbers at their records, the STRING records as they come). BIFF5 reads its ARRAY records BEFORE the cells (the prefetch
+// pass), so nothing is set here: the range is only remembered.
+void ImportExcel::DropUnresolvedArray( std::unique_ptr<ScTokenArray>& pResult, const ScRange& rRange )
+{
+    if (pResult && pResult->HasOpCode(ocBad))
+    {
+        maUnresolvedArrays.push_back(rRange);
+        pResult.reset();
+    }
+}
