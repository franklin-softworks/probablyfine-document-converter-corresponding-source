@@ -176,6 +203,27 @@ void ImportExcel::Formula(
     GetXFRangeBuffer().SetXF(aScPos, nXF);
 }
 
+bool ImportExcel::IsInUnresolvedArray( const ScAddress& rPos ) const
+{
+    for (const ScRange& rRange : maUnresolvedArrays)
+        if (rRange.Contains(rPos))
+            return true;
+    return false;
+}
+
+// STRING (BIFF3 to BIFF5): the cached string result of the FORMULA record before it. Only a formula that could not be evaluated (BUG-90) keeps it: every other formula
+// recalculates, as before.
+void ImportExcel::FormulaString25()
+{
+    if (!mbLastFormulaPosValid)
+        return;
+    if (!mbExtStringPending && !IsInUnresolvedArray(maLastFormulaPos))
+        return;
+    const OUString aString = aIn.ReadByteString( true );
+    GetDocImport().setStringCell(maLastFormulaPos, aString);
+    mbExtStringPending = false;
+}
