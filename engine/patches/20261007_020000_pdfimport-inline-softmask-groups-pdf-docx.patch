         void setSkipImages ( bool bSkipImages );
 #if POPPLER_CHECK_VERSION(21, 3, 0)
+        // FG-174/175: poppler draws a soft mask's form (an ExtGState /SMask group)
+        // through the ordinary drawing calls. This device has no transparency
+        // groups, so that content used to land on the page as visible content:
+        // grey luminosity shadings, mask images as black boxes. Track which open
+        // groups are soft-mask groups and paint nothing inside them; the masked
+        // content then draws unmasked.
+#if POPPLER_CHECK_VERSION(25, 9, 0)
+        virtual void beginTransparencyGroup(GfxState*, const std::array<double, 4>&,
+                                            GfxColorSpace*, bool, bool, bool forSoftMask) override
+#else
+        virtual void beginTransparencyGroup(GfxState*, const double*,
+                                            GfxColorSpace*, bool, bool, bool forSoftMask) override
+#endif
+        {
+            m_aGroupIsSoftMask.push_back(forSoftMask);
+            if (forSoftMask)
+                ++m_nSoftMaskDepth;
+        }
+        virtual void endTransparencyGroup(GfxState*) override
+        {
+            if (m_aGroupIsSoftMask.empty())
+                return;
+            if (m_aGroupIsSoftMask.back())
+                --m_nSoftMaskDepth;
+            m_aGroupIsSoftMask.pop_back();
+        }
+
