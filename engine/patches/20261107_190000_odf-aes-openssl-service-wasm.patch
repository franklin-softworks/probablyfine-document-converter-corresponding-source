diff --git a/comphelper/source/crypto/OpenSSLContextSupplier.cxx b/comphelper/source/crypto/OpenSSLContextSupplier.cxx
new file mode 100644
--- /dev/null
+++ b/comphelper/source/crypto/OpenSSLContextSupplier.cxx
@@ -0,0 +1,163 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * The XNSSInitializer service over OpenSSL, for builds without NSS (WebAssembly): the package code asks the UNO service
+ * com.sun.star.xml.crypto.NSSInitializer for exactly two things, a digest context (the manifest checksum) and an AES-CBC /
+ * AES-GCM cipher context. This is a port of ONSSInitializer::get{Digest,Cipher}Context
+ * (xmlsecurity/source/xmlsec/nss/nssinitializer.cxx, which incorporates work covered by the Apache License 2.0 notice
+ * in that file). Everything NSS-specific (profiles, certificates, signatures) fails closed: there is no NSS here.
+ */
+
+#include <sal/config.h>
+
+#include <com/sun/star/beans/NamedValue.hpp>
+#include <com/sun/star/lang/IllegalArgumentException.hpp>
+#include <com/sun/star/xml/crypto/CipherID.hpp>
+#include <com/sun/star/xml/crypto/DigestID.hpp>
+#include <com/sun/star/xml/crypto/NSSProfile.hpp>
+#include <com/sun/star/xml/crypto/XNSSInitializer.hpp>
+#include <com/sun/star/lang/XServiceInfo.hpp>
+#include <com/sun/star/uno/XComponentContext.hpp>
+#include <cppuhelper/implbase.hxx>
+#include <cppuhelper/supportsservice.hxx>
+
+#include <openssl/err.h>
+#include <openssl/evp.h>
+
+#include "OpenSSLCipherContext.hxx"
+#include "OpenSSLDigestContext.hxx"
+
+using namespace ::com::sun::star;
+
+namespace
+{
+inline constexpr OUString NSS_SERVICE_NAME = u"com.sun.star.xml.crypto.NSSInitializer"_ustr;
+
+class OpenSSLContextSupplier
+    : public cppu::WeakImplHelper<css::xml::crypto::XNSSInitializer, css::lang::XServiceInfo>
+{
+public:
+    OpenSSLContextSupplier() = default;
+
+    /* XNSSInitializer: there is no NSS, so there is no profile and nothing is initialised (callers: certificate dialogs
+       and the NSS security environment, none of which exists in this build) */
+    virtual OUString SAL_CALL getNSSPath() override { return OUString(); }
+    virtual sal_Bool SAL_CALL getIsNSSinitialized() override { return false; }
+    virtual css::uno::Sequence<css::xml::crypto::NSSProfile> SAL_CALL getNSSProfiles() override
+    {
+        return css::uno::Sequence<css::xml::crypto::NSSProfile>();
+    }
+
+    /* XDigestContextSupplier: ref nssinitializer.cxx 543-583 */
+    virtual css::uno::Reference<css::xml::crypto::XDigestContext> SAL_CALL
+    getDigestContext(::sal_Int32 nDigestID, const css::uno::Sequence<css::beans::NamedValue>& aParams) override
+    {
+        const EVP_MD* pMd = nullptr;
+        sal_Int32 nDigestLength = 0;
+        bool b1KData = false;
+        if (nDigestID == css::xml::crypto::DigestID::SHA256 || nDigestID == css::xml::crypto::DigestID::SHA256_1K)
+        {
+            pMd = EVP_sha256();
+            nDigestLength = 32;
+            b1KData = (nDigestID == css::xml::crypto::DigestID::SHA256_1K);
+        }
+        else if (nDigestID == css::xml::crypto::DigestID::SHA1 || nDigestID == css::xml::crypto::DigestID::SHA1_1K)
+        {
+            pMd = EVP_sha1();
+            nDigestLength = 20;
+            b1KData = (nDigestID == css::xml::crypto::DigestID::SHA1_1K);
+        }
+        else if (nDigestID == css::xml::crypto::DigestID::SHA512 || nDigestID == css::xml::crypto::DigestID::SHA512_1K)
+        {
+            pMd = EVP_sha512();
+            nDigestLength = 64;
+            b1KData = (nDigestID == css::xml::crypto::DigestID::SHA512_1K);
+        }
+        else
+            throw css::lang::IllegalArgumentException(u"Unexpected digest requested."_ustr,
+                                                      css::uno::Reference<css::uno::XInterface>(), 1);
+
+        if (aParams.hasElements())
+            throw css::lang::IllegalArgumentException(u"Unexpected arguments provided for digest creation."_ustr,
+                                                      css::uno::Reference<css::uno::XInterface>(), 2);
+
+        EVP_MD_CTX* pContext = EVP_MD_CTX_new();
+        if (!pContext || EVP_DigestInit_ex(pContext, pMd, nullptr) != 1)
+        {
+            ERR_clear_error();
+            if (pContext)
+                EVP_MD_CTX_free(pContext);
+            return nullptr;
+        }
+
+        return new comphelper::opensslctx::OpenSSLDigestContext(pContext, nDigestLength, b1KData);
+    }
+
+    /* XCipherContextSupplier: ref nssinitializer.cxx 585-620 */
+    virtual css::uno::Reference<css::xml::crypto::XCipherContext> SAL_CALL
+    getCipherContext(::sal_Int32 nCipherID, const css::uno::Sequence<::sal_Int8>& aKey,
+                     const css::uno::Sequence<::sal_Int8>& aInitializationVector, sal_Bool bEncryption,
+                     const css::uno::Sequence<css::beans::NamedValue>& aParams) override
+    {
+        comphelper::opensslctx::OpenSSLCipherContext::Kind eKind;
+        bool bW3CPadding = false;
+        switch (nCipherID)
+        {
+            case css::xml::crypto::CipherID::AES_CBC_W3C_PADDING:
+                eKind = comphelper::opensslctx::OpenSSLCipherContext::Kind::AesCbc;
+                bW3CPadding = true;
+                break;
+            case css::xml::crypto::CipherID::AES_GCM_W3C:
+                eKind = comphelper::opensslctx::OpenSSLCipherContext::Kind::AesGcm;
+                break;
+            default:
+                throw css::lang::IllegalArgumentException(u"Unexpected cipher requested."_ustr,
+                                                          css::uno::Reference<css::uno::XInterface>(), 1);
+        }
+
+        if (aKey.getLength() != 16 && aKey.getLength() != 24 && aKey.getLength() != 32)
+            throw css::lang::IllegalArgumentException(u"Unexpected key length."_ustr,
+                                                      css::uno::Reference<css::uno::XInterface>(), 2);
+
+        if (aParams.hasElements())
+            throw css::lang::IllegalArgumentException(u"Unexpected arguments provided for cipher creation."_ustr,
+                                                      css::uno::Reference<css::uno::XInterface>(), 5);
+
+        // the IV length is checked explicitly: 16 (CBC) or 12 (GCM)
+        if (aInitializationVector.getLength() != (eKind == comphelper::opensslctx::OpenSSLCipherContext::Kind::AesGcm ? 12 : 16))
+            throw css::lang::IllegalArgumentException(u"Unexpected length of initialization vector."_ustr,
+                                                      css::uno::Reference<css::uno::XInterface>(), 3);
+
+        return comphelper::opensslctx::OpenSSLCipherContext::Create(eKind, aKey, aInitializationVector, bEncryption,
+                                                                    bW3CPadding);
+    }
+
+    /* XServiceInfo */
+    virtual OUString SAL_CALL getImplementationName() override
+    {
+        return u"com.sun.star.comp.comphelper.OpenSSLContextSupplier"_ustr;
+    }
+    virtual sal_Bool SAL_CALL supportsService(const OUString& rServiceName) override
+    {
+        return cppu::supportsService(this, rServiceName);
+    }
+    virtual css::uno::Sequence<OUString> SAL_CALL getSupportedServiceNames() override
+    {
+        return { NSS_SERVICE_NAME };
+    }
+};
+} // namespace
+
+extern "C" SAL_DLLPUBLIC_EXPORT css::uno::XInterface*
+com_sun_star_comp_comphelper_OpenSSLContextSupplier_get_implementation(
+    css::uno::XComponentContext* /*pCtx*/, css::uno::Sequence<css::uno::Any> const& /*rSeq*/)
+{
+    return cppu::acquire(new OpenSSLContextSupplier);
+}
+
