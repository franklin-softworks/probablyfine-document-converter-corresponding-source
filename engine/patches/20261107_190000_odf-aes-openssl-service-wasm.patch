new file mode 100644
--- /dev/null
+++ b/comphelper/source/crypto/OpenSSLCleansingBuffer.hxx
@@ -0,0 +1,106 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <sal/config.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+
+#include <openssl/crypto.h>
+
+namespace comphelper::opensslctx
+{
+#ifdef ODFAES_TEST_HOOK
+// Test builds only: called with every block just before it is freed, after it was wiped, so a test can check that it is all zero.
+inline void (*g_pBeforeFree)(const unsigned char* pBlock, std::size_t nCapacity) = nullptr;
+#endif
+
+/**
+ * A byte buffer for secrets (a key, a plaintext that is being encrypted, a plaintext that was just decrypted).
+ *
+ * A plain std::vector or css::uno::Sequence that grows frees its OLD storage without wiping it, which leaves a copy of
+ * the document in freed heap for every growth step. This one grows by hand: allocate, copy, OPENSSL_cleanse the old
+ * block, free it; and it wipes in its destructor and in clear(). It grows geometrically (the reference implementation
+ * reallocated the whole buffer on every chunk: quadratic copying for a large entry).
+ */
+class CleansingBuffer
+{
+    unsigned char* m_pData = nullptr;
+    std::size_t m_nSize = 0;
+    std::size_t m_nCapacity = 0;
+
+    static void release(unsigned char* pBlock, std::size_t nCapacity)
+    {
+        if (!pBlock)
+            return;
+        OPENSSL_cleanse(pBlock, nCapacity);
+#ifdef ODFAES_TEST_HOOK
+        if (g_pBeforeFree)
+            g_pBeforeFree(pBlock, nCapacity);
+#endif
+        delete[] pBlock;
+    }
+
+public:
+    CleansingBuffer() = default;
+    CleansingBuffer(const CleansingBuffer&) = delete;
+    CleansingBuffer& operator=(const CleansingBuffer&) = delete;
+    ~CleansingBuffer() { clear(); }
+
+    std::size_t size() const { return m_nSize; }
+    unsigned char* data() { return m_pData; }
+    const unsigned char* data() const { return m_pData; }
+
+    /// make room for at least nWanted bytes in total; the old block is wiped and freed
+    void reserve(std::size_t nWanted)
+    {
+        if (nWanted <= m_nCapacity)
+            return;
+        std::size_t nNew = std::max<std::size_t>({ nWanted, m_nCapacity * 2, 64 });
+        unsigned char* pNew = new unsigned char[nNew];
+        if (m_nSize)
+            std::memcpy(pNew, m_pData, m_nSize);
+        release(m_pData, m_nCapacity);
+        m_pData = pNew;
+        m_nCapacity = nNew;
+    }
+
+    void append(const void* pBytes, std::size_t nBytes)
+    {
+        if (!nBytes)
+            return;
+        reserve(m_nSize + nBytes);
+        std::memcpy(m_pData + m_nSize, pBytes, nBytes);
+        m_nSize += nBytes;
+    }
+
+    /// set the size to nSize; bytes beyond the old size are zero
+    void resize(std::size_t nSize)
+    {
+        reserve(nSize);
+        if (nSize > m_nSize)
+            std::memset(m_pData + m_nSize, 0, nSize - m_nSize);
+        m_nSize = nSize;
+    }
+
+    void clear()
+    {
+        release(m_pData, m_nCapacity);
+        m_pData = nullptr;
+        m_nSize = 0;
+        m_nCapacity = 0;
+    }
+};
+
+} // namespace comphelper::opensslctx
+
