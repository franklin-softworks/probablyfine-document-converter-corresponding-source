+++ b/comphelper/source/crypto/OpenSSLDigestContext.cxx
@@ -0,0 +1,101 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * This file is a port of xmlsecurity/source/xmlsec/nss/digestcontext.cxx (which incorporates work covered by the
+ * Apache License 2.0 notice in that file) from NSS PK11 to OpenSSL EVP. The "ref NNN" comments name the lines of
+ * that file each block follows.
+ */
+
+#include <sal/config.h>
+
+#include <com/sun/star/lang/DisposedException.hpp>
+
+#include <openssl/err.h>
+#include <openssl/evp.h>
+
+#include "OpenSSLDigestContext.hxx"
+
+using namespace ::com::sun::star;
+
+namespace comphelper::opensslctx
+{
+// ref 28-33
+OpenSSLDigestContext::~OpenSSLDigestContext() { Free(); }
+
+void OpenSSLDigestContext::Free()
+{
+    if (m_pContext)
+    {
+        EVP_MD_CTX_free(m_pContext);
+        m_pContext = nullptr;
+    }
+}
+
+// ref 35-65
+void SAL_CALL OpenSSLDigestContext::updateDigest(const uno::Sequence<sal_Int8>& aData)
+{
+    std::scoped_lock aGuard(m_aMutex);
+
+    if (m_bBroken)
+        throw uno::RuntimeException();
+
+    if (m_bDisposed)
+        throw lang::DisposedException();
+
+    // the _1K variants hash the first 1024 bytes only and ignore the rest
+    if (m_b1KData && m_nDigested >= 1024)
+        return;
+
+    sal_Int32 nToDigest = aData.getLength();
+    if (m_b1KData && m_nDigested + nToDigest > 1024)
+        nToDigest = 1024 - m_nDigested;
+
+    if (nToDigest > 0
+        && EVP_DigestUpdate(m_pContext, aData.getConstArray(), static_cast<size_t>(nToDigest)) != 1)
+    {
+        ERR_clear_error();
+        Free();
+        m_bBroken = true;
+        throw uno::RuntimeException();
+    }
+
+    m_nDigested += nToDigest;
+}
+
+// ref 67-90
+uno::Sequence<sal_Int8> SAL_CALL OpenSSLDigestContext::finalizeDigestAndDispose()
+{
+    std::scoped_lock aGuard(m_aMutex);
+
+    if (m_bBroken)
+        throw uno::RuntimeException();
+
+    if (m_bDisposed)
+        throw lang::DisposedException();
+
+    uno::Sequence<sal_Int8> aResult(m_nDigestLength);
+    unsigned int nResultLen = 0;
+    if (EVP_DigestFinal_ex(m_pContext, reinterpret_cast<unsigned char*>(aResult.getArray()), &nResultLen) != 1
+        || nResultLen != static_cast<unsigned int>(m_nDigestLength))
+    {
+        ERR_clear_error();
+        Free();
+        m_bBroken = true;
+        throw uno::RuntimeException();
+    }
+
+    Free();
+    m_bDisposed = true;
+
+    aResult.realloc(nResultLen);
+    return aResult;
+}
+
+} // namespace comphelper::opensslctx
+
