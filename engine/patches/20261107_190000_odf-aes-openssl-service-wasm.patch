+
+#pragma once
+
+#include <com/sun/star/xml/crypto/XDigestContext.hpp>
+
+#include <cppuhelper/implbase.hxx>
+#include <mutex>
+
+typedef struct evp_md_ctx_st EVP_MD_CTX;
+
+namespace comphelper::opensslctx
+{
+/// XDigestContext over OpenSSL EVP: a port of ODigestContext (xmlsecurity/source/xmlsec/nss/digestcontext.cxx).
+class OpenSSLDigestContext : public cppu::WeakImplHelper<css::xml::crypto::XDigestContext>
+{
+private:
+    std::mutex m_aMutex;
+
+    EVP_MD_CTX* m_pContext;
+    sal_Int32 const m_nDigestLength;
+    bool const m_b1KData;
+    sal_Int32 m_nDigested;
+
+    bool m_bDisposed;
+    bool m_bBroken;
+
+    void Free();
+
+public:
+    /// takes ownership of pContext (an initialised digest context)
+    OpenSSLDigestContext(EVP_MD_CTX* pContext, sal_Int32 nDigestLength, bool b1KData)
+        : m_pContext(pContext)
+        , m_nDigestLength(nDigestLength)
+        , m_b1KData(b1KData)
+        , m_nDigested(0)
+        , m_bDisposed(false)
+        , m_bBroken(false)
+    {
+    }
+
+    virtual ~OpenSSLDigestContext() override;
+
+    // XDigestContext
+    virtual void SAL_CALL updateDigest(const css::uno::Sequence<sal_Int8>& aData) override;
+    virtual css::uno::Sequence<sal_Int8> SAL_CALL finalizeDigestAndDispose() override;
+};
+
+} // namespace comphelper::opensslctx
+
