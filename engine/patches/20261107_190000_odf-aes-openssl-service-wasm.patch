+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <com/sun/star/xml/crypto/XCipherContext.hpp>
+
+#include <cppuhelper/implbase.hxx>
+#include <mutex>
+
+#include "OpenSSLCleansingBuffer.hxx"
+
+typedef struct evp_cipher_ctx_st EVP_CIPHER_CTX;
+
+namespace comphelper::opensslctx
+{
+/**
+ * XCipherContext over OpenSSL EVP: a line-for-line port of OCipherContext (xmlsecurity/source/xmlsec/nss/ciphercontext.cxx),
+ * which does the same job over NSS PK11. Only the primitive calls differ; the buffering, the hold-back of the last block(s),
+ * the W3C padding and the GCM framing are the reference's, so files interoperate with every other implementation. See
+ * docs/design/odf-aes-openssl.md for the table of reference lines and the stated deviations.
+ */
+class OpenSSLCipherContext : public cppu::WeakImplHelper<css::xml::crypto::XCipherContext>
+{
+public:
+    enum class Kind
+    {
+        AesCbc,
+        AesGcm
+    };
+
+private:
+    std::mutex m_aMutex;
+
+    EVP_CIPHER_CTX* m_pContext; // AES-CBC only; AES-GCM is done in one shot at finalise
+    CleansingBuffer m_aKey;
+    CleansingBuffer m_aGcmBuffer; // AES-GCM: everything that was fed in (plaintext when encrypting)
+
+    sal_Int32 m_nBlockSize;
+    css::uno::Sequence<sal_Int8> m_aLastBlock;
+    css::uno::Sequence<sal_Int8> m_AESGCMIV; // non-empty means AES-GCM
+
+    bool m_bEncryption;
+    bool m_bPadding;
+    bool m_bW3CPadding;
+    sal_Int64 m_nConverted;
+
+    bool m_bDisposed;
+    bool m_bBroken;
+
+    void Dispose();
+    /// the context is unusable from now on: wipe everything
+    void Break();
+
+    OpenSSLCipherContext()
+        : m_pContext(nullptr)
+        , m_nBlockSize(0)
+        , m_bEncryption(false)
+        , m_bPadding(false)
+        , m_bW3CPadding(false)
+        , m_nConverted(0)
+        , m_bDisposed(false)
+        , m_bBroken(false)
+    {
+    }
+
+public:
+    virtual ~OpenSSLCipherContext() override { Dispose(); }
+
+    static css::uno::Reference<css::xml::crypto::XCipherContext>
+    Create(Kind eKind, const css::uno::Sequence<sal_Int8>& aKey,
+           const css::uno::Sequence<sal_Int8>& aInitializationVector, bool bEncryption,
+           bool bW3CPadding);
+
+    // XCipherContext
+    virtual css::uno::Sequence<sal_Int8> SAL_CALL
+    convertWithCipherContext(const css::uno::Sequence<sal_Int8>& aData) override;
+    virtual css::uno::Sequence<sal_Int8> SAL_CALL finalizeCipherContextAndDispose() override;
+};
+
+} // namespace comphelper::opensslctx
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/comphelper/source/crypto/OpenSSLCipherContext.cxx b/comphelper/source/crypto/OpenSSLCipherContext.cxx
new file mode 100644
--- /dev/null
+++ b/comphelper/source/crypto/OpenSSLCipherContext.cxx
@@ -0,0 +1,507 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ *
+ * This file is a port of xmlsecurity/source/xmlsec/nss/ciphercontext.cxx (which incorporates work covered by the
+ * Apache License 2.0 notice in that file) from NSS PK11 to OpenSSL EVP. The "ref NNN" comments name the lines of
+ * that file each block follows.
+ */
+
+#include <sal/config.h>
+
+#include <com/sun/star/lang/DisposedException.hpp>
+#include <com/sun/star/lang/IllegalArgumentException.hpp>
+#include <rtl/random.h>
+#include <rtl/ref.hxx>
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+
+#include <openssl/crypto.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+
+#include "OpenSSLCipherContext.hxx"
+
+using namespace ::com::sun::star;
+
+namespace comphelper::opensslctx
+{
+namespace
+{
+constexpr sal_Int32 nAESGCMIVSize = 12;
+constexpr sal_Int32 nAESGCMTagSize = 16;
+constexpr sal_Int32 nAESBlockSize = 16;
+
+struct CtxDeleter
+{
+    void operator()(EVP_CIPHER_CTX* p) const { EVP_CIPHER_CTX_free(p); }
+};
+typedef std::unique_ptr<EVP_CIPHER_CTX, CtxDeleter> CtxPtr;
+
+const EVP_CIPHER* cbcCipher(sal_Int32 nKeyLen)
+{
+    switch (nKeyLen)
+    {
+        case 16:
+            return EVP_aes_128_cbc();
+        case 24:
+            return EVP_aes_192_cbc();
+        case 32:
+            return EVP_aes_256_cbc();
+    }
+    return nullptr;
+}
+
+const EVP_CIPHER* gcmCipher(sal_Int32 nKeyLen)
+{
+    switch (nKeyLen)
+    {
+        case 16:
+            return EVP_aes_128_gcm();
+        case 24:
+            return EVP_aes_192_gcm();
+        case 32:
+            return EVP_aes_256_gcm();
+    }
+    return nullptr;
+}
+
+void cleanse(uno::Sequence<sal_Int8>& rSeq)
+{
+    if (rSeq.hasElements())
+        OPENSSL_cleanse(rSeq.getArray(), rSeq.getLength());
+}
+
+// Sequence::realloc frees the old block as it was, and a block that held plaintext (or the unfinished last block of
+// a CBC stream) would stay readable in freed heap. Resize by hand: allocate exactly, copy, wipe the old block, swap.
+void resize(uno::Sequence<sal_Int8>& rSeq, sal_Int32 nNewLen)
+{
+    if (rSeq.getLength() == nNewLen)
+        return;
+    uno::Sequence<sal_Int8> aNew(nNewLen);
+    const sal_Int32 nKeep = std::min(nNewLen, rSeq.getLength());
+    if (nKeep > 0)
+        memcpy(aNew.getArray(), rSeq.getConstArray(), nKeep);
+    cleanse(rSeq);
+    rSeq = std::move(aNew);
+}
+
+} // namespace
+
+// ref 36-117 (OCipherContext::Create). NSS slot/key import/params become an EVP context; all argument checks are made here
+// as well as by the supplier, so the context never trusts its caller (ref asserted the IV length: release builds did not).
+uno::Reference<xml::crypto::XCipherContext>
+OpenSSLCipherContext::Create(Kind eKind, const uno::Sequence<sal_Int8>& aKey,
+                             const uno::Sequence<sal_Int8>& aInitializationVector, bool bEncryption,
+                             bool bW3CPadding)
+{
+    ::rtl::Reference<OpenSSLCipherContext> xResult = new OpenSSLCipherContext;
+
+    const sal_Int32 nKeyLen = aKey.getLength();
+    if (nKeyLen != 16 && nKeyLen != 24 && nKeyLen != 32)
+        throw lang::IllegalArgumentException(u"Unexpected key length."_ustr, uno::Reference<uno::XInterface>(), 2);
+
+    const sal_Int32 nIVLen = aInitializationVector.getLength();
+    if (nIVLen != (eKind == Kind::AesGcm ? nAESGCMIVSize : nAESBlockSize))
+        throw lang::IllegalArgumentException(u"Unexpected length of initialization vector."_ustr,
+                                             uno::Reference<uno::XInterface>(), 3);
+
+    xResult->m_aKey.append(aKey.getConstArray(), nKeyLen);
+
+    if (eKind == Kind::AesGcm)
+    {
+        // ref 58-85: the GCM parameters (IV, no AAD, 128-bit tag) are used at finalise; nothing to create now
+        xResult->m_AESGCMIV = aInitializationVector;
+    }
+    else
+    {
+        // ref 86-104: CKM_AES_CBC (no padding mechanism): EVP padding OFF; the W3C padding is added by hand at finalise
+        xResult->m_pContext = EVP_CIPHER_CTX_new();
+        if (!xResult->m_pContext)
+        {
+            ERR_clear_error();
+            throw uno::RuntimeException(u"EVP_CIPHER_CTX_new failed"_ustr);
+        }
+        if (EVP_CipherInit_ex(xResult->m_pContext, cbcCipher(nKeyLen), nullptr, xResult->m_aKey.data(),
+                              reinterpret_cast<const unsigned char*>(aInitializationVector.getConstArray()),
+                              bEncryption ? 1 : 0)
+                != 1
+            || EVP_CIPHER_CTX_set_padding(xResult->m_pContext, 0) != 1)
+        {
+            ERR_clear_error();
+            throw uno::RuntimeException(u"EVP_CipherInit_ex failed"_ustr);
+        }
+    }
+
+    xResult->m_bEncryption = bEncryption;
+    xResult->m_bW3CPadding = bW3CPadding;
+    // ref 108: PK11_GetPadMechanism(CKM_AES_CBC) is CKM_AES_CBC_PAD, which is not the mechanism itself
+    xResult->m_bPadding = bW3CPadding;
+    // ref 109-110: 16 for AES, and the reference pins 16 for GCM too
+    xResult->m_nBlockSize = nAESBlockSize;
+    return xResult;
+}
+
+// ref 119-146
+void OpenSSLCipherContext::Dispose()
+{
+    if (m_pContext)
+    {
+        EVP_CIPHER_CTX_free(m_pContext);
+        m_pContext = nullptr;
+    }
+    m_aKey.clear();
+    m_aGcmBuffer.clear();
+    cleanse(m_aLastBlock);
+    m_aLastBlock = uno::Sequence<sal_Int8>();
+    m_bDisposed = true;
+}
+
+void OpenSSLCipherContext::Break()
+{
+    m_bBroken = true;
+    ERR_clear_error();
+    Dispose();
+}
+
+// ref 148-239
+uno::Sequence<sal_Int8> SAL_CALL
+OpenSSLCipherContext::convertWithCipherContext(const uno::Sequence<sal_Int8>& aData)
+{
+    std::unique_lock aGuard(m_aMutex);
+
+    if (m_bBroken)
+        throw uno::RuntimeException();
+
+    if (m_bDisposed)
+        throw lang::DisposedException();
+
+    if (m_AESGCMIV.getLength())
+    {
+        // ref 158-168: GCM buffers everything, with the INT32 overflow guard; only finalise produces output
+        if (static_cast<std::size_t>(SAL_MAX_INT32) - nAESGCMIVSize - nAESGCMTagSize
+            <= m_aGcmBuffer.size() + static_cast<std::size_t>(aData.getLength()))
+        {
+            Break();
+            throw uno::RuntimeException(u"overflow"_ustr);
+        }
+        m_aGcmBuffer.append(aData.getConstArray(), aData.getLength());
+        return {};
+    }
+
+    uno::Sequence<sal_Int8> aToConvert;
+    if (aData.hasElements())
+    {
+        sal_Int32 nOldLastBlockLen = m_aLastBlock.getLength();
+
+        sal_Int32 nAvailableData = nOldLastBlockLen + aData.getLength();
+        sal_Int32 nToConvertLen;
+        if (m_bEncryption || !m_bW3CPadding)
+        {
+            if (nOldLastBlockLen >= m_nBlockSize) // ref 179: assert
+            {
+                Break();
+                throw uno::RuntimeException(u"invalid state"_ustr);
+            }
+            if (nAvailableData % m_nBlockSize == 0)
+                nToConvertLen = nAvailableData;
+            else if (nAvailableData < m_nBlockSize)
+                nToConvertLen = 0;
+            else
+                nToConvertLen = nAvailableData - nAvailableData % m_nBlockSize;
+        }
+        else
+        {
+            if (nOldLastBlockLen >= m_nBlockSize * 2) // ref 189: assert
+            {
+                Break();
+                throw uno::RuntimeException(u"invalid state"_ustr);
+            }
+            // decryption with W3C padding needs at least one block for finalizing
+            if (nAvailableData < m_nBlockSize * 2)
+                nToConvertLen = 0;
+            else
+                nToConvertLen = nAvailableData - nAvailableData % m_nBlockSize - m_nBlockSize;
+        }
+
+        resize(aToConvert, nToConvertLen);
+        if (nToConvertLen == 0)
+        {
+            resize(m_aLastBlock, nOldLastBlockLen + aData.getLength());
+            memcpy(m_aLastBlock.getArray() + nOldLastBlockLen, aData.getConstArray(), aData.getLength());
+            // aToConvert stays empty
+        }
+        else if (nToConvertLen < nOldLastBlockLen)
+        {
+            memcpy(aToConvert.getArray(), m_aLastBlock.getConstArray(), nToConvertLen);
+            memcpy(m_aLastBlock.getArray(), m_aLastBlock.getConstArray() + nToConvertLen,
+                   nOldLastBlockLen - nToConvertLen);
+            resize(m_aLastBlock, nOldLastBlockLen - nToConvertLen + aData.getLength());
+            memcpy(m_aLastBlock.getArray() + nOldLastBlockLen - nToConvertLen, aData.getConstArray(),
+                   aData.getLength());
+        }
+        else
+        {
+            memcpy(aToConvert.getArray(), m_aLastBlock.getConstArray(), nOldLastBlockLen);
+            if (nToConvertLen > nOldLastBlockLen)
+                memcpy(aToConvert.getArray() + nOldLastBlockLen, aData.getConstArray(),
+                       nToConvertLen - nOldLastBlockLen);
+            resize(m_aLastBlock, nAvailableData - nToConvertLen);
+            memcpy(m_aLastBlock.getArray(), aData.getConstArray() + nToConvertLen - nOldLastBlockLen,
+                   nAvailableData - nToConvertLen);
+        }
+    }
+
+    uno::Sequence<sal_Int8> aResult;
+    if (aToConvert.getLength() % m_nBlockSize != 0) // ref 222: assert
+    {
+        cleanse(aToConvert);
+        Break();
+        throw uno::RuntimeException(u"invalid state"_ustr);
+    }
+    if (aToConvert.hasElements())
+    {
+        int nResultLen = 0;
+        resize(aResult, aToConvert.getLength() + m_nBlockSize);
+        if (EVP_CipherUpdate(m_pContext, reinterpret_cast<unsigned char*>(aResult.getArray()), &nResultLen,
+                             reinterpret_cast<const unsigned char*>(aToConvert.getConstArray()),
+                             aToConvert.getLength())
+            != 1)
+        {
+            cleanse(aToConvert);
+            cleanse(aResult);
+            Break();
+            throw uno::RuntimeException(u"EVP_CipherUpdate failed"_ustr);
+        }
+
+        m_nConverted += aToConvert.getLength();
+        resize(aResult, nResultLen);
+    }
+    cleanse(aToConvert);
+
+    return aResult;
+}
+
+// ref 241-388
+uno::Sequence<sal_Int8> SAL_CALL OpenSSLCipherContext::finalizeCipherContextAndDispose()
+{
+    std::unique_lock aGuard(m_aMutex);
+
+    if (m_bBroken)
+        throw uno::RuntimeException();
+
+    if (m_bDisposed)
+        throw lang::DisposedException();
+
+    if (m_AESGCMIV.getLength())
+    {
+        // ref 251-304: AES-GCM, W3C framing IV(12) || ciphertext || tag(16), no AAD, one shot
+        const sal_Int32 nKeyLen = static_cast<sal_Int32>(m_aKey.size());
+        const EVP_CIPHER* pCipher = gcmCipher(nKeyLen);
+        const std::size_t nBuffered = m_aGcmBuffer.size();
+        uno::Sequence<sal_Int8> aResult;
+        if (!pCipher)
+        {
+            Break();
+            throw uno::RuntimeException(u"invalid state"_ustr);
+        }
+        CtxPtr xCtx(EVP_CIPHER_CTX_new());
+        if (!xCtx)
+        {
+            Break();
+            throw uno::RuntimeException(u"EVP_CIPHER_CTX_new failed"_ustr);
+        }
+        if (m_bEncryption)
+        {
+            if (nBuffered > static_cast<std::size_t>(SAL_MAX_INT32) - nAESGCMIVSize - nAESGCMTagSize)
+            {
+                Break();
+                throw uno::RuntimeException(u"overflow"_ustr);
+            }
+            // add space for IV and tag; W3C xmlenc-core1 requires the IV preceding the ciphertext
+            resize(aResult, static_cast<sal_Int32>(nBuffered) + nAESGCMIVSize + nAESGCMTagSize);
+            auto* pOut = reinterpret_cast<unsigned char*>(aResult.getArray());
+            memcpy(pOut, m_AESGCMIV.getConstArray(), nAESGCMIVSize);
+            int nOutLen = 0, nFinLen = 0;
+            std::size_t nTotal = 0;
+            bool bOk = EVP_EncryptInit_ex(xCtx.get(), pCipher, nullptr, nullptr, nullptr) == 1
+                       && EVP_CIPHER_CTX_ctrl(xCtx.get(), EVP_CTRL_GCM_SET_IVLEN, nAESGCMIVSize, nullptr) == 1
+                       && EVP_EncryptInit_ex(xCtx.get(), nullptr, nullptr, m_aKey.data(),
+                                             reinterpret_cast<const unsigned char*>(m_AESGCMIV.getConstArray()))
+                              == 1;
+            if (bOk && nBuffered)
+            {
+                bOk = EVP_EncryptUpdate(xCtx.get(), pOut + nAESGCMIVSize, &nOutLen, m_aGcmBuffer.data(),
+                                        static_cast<int>(nBuffered))
+                      == 1;
+                nTotal += nOutLen;
+            }
+            if (bOk)
+            {
+                bOk = EVP_EncryptFinal_ex(xCtx.get(), pOut + nAESGCMIVSize + nTotal, &nFinLen) == 1;
+                nTotal += nFinLen;
+            }
+            if (bOk && nTotal == nBuffered)
+                bOk = EVP_CIPHER_CTX_ctrl(xCtx.get(), EVP_CTRL_GCM_GET_TAG, nAESGCMTagSize,
+                                          pOut + nAESGCMIVSize + nTotal)
+                      == 1;
+            else
+                bOk = false;
+            if (!bOk)
+            {
+                cleanse(aResult);
+                Break();
+                throw uno::RuntimeException(u"AES-GCM encryption failed"_ustr);
+            }
+        }
+        else if (static_cast<std::size_t>(nAESGCMIVSize) + nAESGCMTagSize < nBuffered)
+        {
+            // ref 275: strictly more than IV + tag, so an empty GCM stream (28 bytes) is refused, as in the reference
+            if (0 != memcmp(m_AESGCMIV.getConstArray(), m_aGcmBuffer.data(), nAESGCMIVSize))
+            {
+                Break();
+                throw uno::RuntimeException(u"inconsistent IV"_ustr);
+            }
+            const std::size_t nCipherLen = nBuffered - nAESGCMIVSize - nAESGCMTagSize;
+            CleansingBuffer aPlain; // released to the caller only after the tag verified
+            aPlain.resize(nCipherLen);
+            int nOutLen = 0, nFinLen = 0;
+            bool bOk = EVP_DecryptInit_ex(xCtx.get(), pCipher, nullptr, nullptr, nullptr) == 1
+                       && EVP_CIPHER_CTX_ctrl(xCtx.get(), EVP_CTRL_GCM_SET_IVLEN, nAESGCMIVSize, nullptr) == 1
+                       && EVP_DecryptInit_ex(xCtx.get(), nullptr, nullptr, m_aKey.data(),
+                                             reinterpret_cast<const unsigned char*>(m_AESGCMIV.getConstArray()))
+                              == 1
+                       && EVP_DecryptUpdate(xCtx.get(), aPlain.data(), &nOutLen,
+                                            m_aGcmBuffer.data() + nAESGCMIVSize, static_cast<int>(nCipherLen))
+                              == 1
+                       // the tag is set BEFORE the final step, which is where it is verified
+                       && EVP_CIPHER_CTX_ctrl(xCtx.get(), EVP_CTRL_GCM_SET_TAG, nAESGCMTagSize,
+                                              m_aGcmBuffer.data() + nAESGCMIVSize + nCipherLen)
+                              == 1
+                       && EVP_DecryptFinal_ex(xCtx.get(), aPlain.data() + nOutLen, &nFinLen) == 1;
+            if (!bOk || static_cast<std::size_t>(nOutLen) + nFinLen != nCipherLen)
+            {
+                // wrong key and tampering both end here; aPlain is wiped by its destructor, nothing is returned
+                Break();
+                throw uno::RuntimeException(u"AES-GCM decryption failed"_ustr);
+            }
+            resize(aResult, static_cast<sal_Int32>(nCipherLen));
+            memcpy(aResult.getArray(), aPlain.data(), nCipherLen);
+        }
+        else
+        {
+            Break();
+            throw uno::RuntimeException(u"incorrect size of input"_ustr);
+        }
+        Dispose();
+        return aResult;
+    }
+
+    if (m_aLastBlock.getLength() >= m_nBlockSize * 2 || m_nConverted % m_nBlockSize != 0) // ref 306-307: asserts
+    {
+        Break();
+        throw uno::RuntimeException(u"invalid state"_ustr);
+    }
+    sal_Int32 nSizeForPadding = (m_nConverted + m_aLastBlock.getLength()) % m_nBlockSize;
+
+    // if it is decryption, the amount of data should be rounded to the block size even in case of padding
+    if ((!m_bPadding || !m_bEncryption) && nSizeForPadding)
+    {
+        // ref 311-312 throws without breaking the context; the port is stricter (WAF-approved deviation)
+        Break();
+        throw uno::RuntimeException(u"The data should contain complete blocks only."_ustr);
+    }
+
+    if (m_bW3CPadding && m_bEncryption)
+    {
+        // in this case the last block should be smaller than standard block
+        // it will be increased with the padding
+        if (m_aLastBlock.getLength() >= m_nBlockSize) // ref 318: assert
+        {
+            Break();
+            throw uno::RuntimeException(u"invalid state"_ustr);
+        }
+
+        // W3CPadding handling for encryption
+        sal_Int32 nPaddingSize = m_nBlockSize - nSizeForPadding;
+        sal_Int32 nOldLastBlockLen = m_aLastBlock.getLength();
+        resize(m_aLastBlock, nOldLastBlockLen + nPaddingSize);
+        auto pLastBlock = m_aLastBlock.getArray();
+
+        if (nPaddingSize > 1)
+        {
+            if (rtl_random_getBytes(nullptr, pLastBlock + nOldLastBlockLen, nPaddingSize - 1) != rtl_Random_E_None)
+            {
+                Break();
+                throw uno::RuntimeException(u"rtl_random_getBytes failed"_ustr);
+            }
+        }
+        pLastBlock[m_aLastBlock.getLength() - 1] = static_cast<sal_Int8>(nPaddingSize);
+    }
+
+    // finally should the last block be smaller than two standard blocks
+    uno::Sequence<sal_Int8> aResult;
+    if (m_aLastBlock.hasElements())
+    {
+        int nPrefResLen = 0;
+        resize(aResult, m_aLastBlock.getLength() + m_nBlockSize);
+        if (EVP_CipherUpdate(m_pContext, reinterpret_cast<unsigned char*>(aResult.getArray()), &nPrefResLen,
+                             reinterpret_cast<const unsigned char*>(m_aLastBlock.getConstArray()),
+                             m_aLastBlock.getLength())
+            != 1)
+        {
+            cleanse(aResult);
+            Break();
+            throw uno::RuntimeException(u"EVP_CipherUpdate failed"_ustr);
+        }
+
+        resize(aResult, nPrefResLen);
+        cleanse(m_aLastBlock);
+        resize(m_aLastBlock, 0);
+    }
+
+    sal_Int32 nPrefixLen = aResult.getLength();
+    resize(aResult, nPrefixLen + m_nBlockSize * 2);
+    int nFinalLen = 0;
+    if (EVP_CipherFinal_ex(m_pContext, reinterpret_cast<unsigned char*>(aResult.getArray() + nPrefixLen), &nFinalLen)
+        != 1)
+    {
+        cleanse(aResult);
+        Break();
+        throw uno::RuntimeException(u"EVP_CipherFinal_ex failed"_ustr);
+    }
+
+    resize(aResult, nPrefixLen + nFinalLen);
+
+    if (m_bW3CPadding && !m_bEncryption)
+    {
+        // W3CPadding handling for decryption
+        // aResult should have enough data, except if the input was completely empty
+
+        // see https://www.w3.org/TR/xmlenc-core1/#sec-Alg-Block
+        // (the last byte is a signed sal_Int8 as in the reference: 1..16 is valid, 0 and 0x80..0xFF are not)
+        if (aResult.getLength() < m_nBlockSize || aResult[aResult.getLength() - 1] <= 0
+            || m_nBlockSize < aResult[aResult.getLength() - 1])
+        {
+            cleanse(aResult);
+            Break();
+            throw uno::RuntimeException(u"incorrect size of padding"_ustr);
+        }
+
+        resize(aResult, aResult.getLength() - aResult[aResult.getLength() - 1]);
+    }
+
+    Dispose();
+
+    return aResult;
+}
+
+} // namespace comphelper::opensslctx
