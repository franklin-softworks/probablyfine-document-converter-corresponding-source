--- a/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk
+++ b/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk
@@ -32,6 +32,29 @@
 # See emscripten.py, finalize_wasm, modify_wasm = True
 # So we need WASM_BIGINT=1; ASSERTIONS=0 for production (1 adds ~1-3% overhead, 2 implies STACK_OVERFLOW_CHECK)
 gb_EMSCRIPTEN_LDFLAGS += --bind -s FORCE_FILESYSTEM=1 -s WASM_BIGINT=1 -s ERROR_ON_UNDEFINED_SYMBOLS=1 -s FETCH=1 -s ASSERTIONS=0 -s EXIT_RUNTIME=0 -s INVOKE_RUN=0 -s EXPORTED_RUNTIME_METHODS=["UTF16ToString","stringToUTF16","UTF8ToString","ccall","cwrap","addOnPreMain","addOnPostRun","registerType","throwBindingError","ClassHandle","HEAPU16","HEAPU32","FS","allocateUTF8","printErr"$(if $(ENABLE_QT6),$(COMMA)"callMain"$(COMMA)"specialHTMLTargets")]
+
+# WASM: desktop/CustomTarget_soffice_bin-emscripten-exports.mk feeds EXPORTED_FUNCTIONS a
+# response file (bridges/gcc3_wasm/exports) that wasmbridgegen generates by scanning the
+# *entire* udkapi+offapi UNO type registry, unconditionally requesting a __ZTI... typeinfo
+# export for every UNO exception type -- not just the ones this product actually links or
+# throws. bridges/source/cpp_uno/gcc3_wasm/cpp2uno.cxx getRtti() already tolerates a missing
+# export at runtime (it synthesizes a typeinfo when the lookup misses), which is what
+# EXPORTED_FUNCTIONS entries are documented to fall back to when unresolved
+# (--export-if-defined=, not a hard --export=; see the long note in
+# static/StaticLibrary_unoembind.mk, "Drop the UNO embind JavaScript glue from the WASM
+# build"). In this emsdk that fallback is never reached: an EXPORTED_FUNCTIONS entry with no
+# definition anywhere in the link is instead a hard error ("undefined exported symbol ...
+# [-Wundefined] [-Werror]"), which surfaces for any UNO exception type whose only would-be
+# definition was dropped -- confirmed for com::sun::star::deployment::* (intentionally
+# unlinked by desktop/Library_deployment.mk, "Stop linking the extension manager into WASM")
+# and, separately, for com::sun::star::reflection::InvalidTypeNameException (one of the 71
+# types the embind-glue removal left with no definition anywhere in the tree, per the
+# analysis in static/StaticLibrary_unoembind.mk). Downgrading this one diagnostic class from
+# error back to warning restores the graceful drop both of those patches' authors already
+# documented as safe and intentional -- it does not relax ERROR_ON_UNDEFINED_SYMBOLS above,
+# which still hard-fails on any *called* symbol with no definition.
+gb_EMSCRIPTEN_LDFLAGS += -Wno-error=undefined
+
 gb_EMSCRIPTEN_QTDEFS := -DQT_NO_LINKED_LIST -DQT_NO_JAVA_STYLE_ITERATORS -DQT_NO_EXCEPTIONS -DQT_NO_DEBUG -DQT_WIDGETS_LIB -DQT_GUI_LIB -DQT_CORE_LIB
 
 ifeq ($(ENABLE_EMSCRIPTEN_JSPI),TRUE)
