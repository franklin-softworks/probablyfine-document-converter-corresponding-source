+// The converter's embedded-font rights rule (docs/fonts/embedded-font-rights.md; owner
+// decisions D4, 2026-10-19, 2026-10-22). OS/2 fsType (OpenType spec, OS/2, "fsType"):
+//  - usage bits 0-3: when several are set the LEAST restrictive wins ("Version
+//    differences": "the least-restrictive permission indicated take[s] precedence"),
+//    applied to every OS/2 version; only Restricted on its own is not used;
+//  - every output: Installable, Editable or Preview & Print (owner, 2026-10-22);
+//  - 0x0100 (no subsetting) refuses only PDF output, which always subsets;
+//  - 0x0200 (bitmap embedding only) refuses every output (both embed outlines).
+// A font with NO rights information (no OS/2 table, or one too short for fsType) reads
+// as 0 (GetTTGlobalFontInfo) and is used like Installable: the user supplied the file.
+bool lcl_sufficientRights(const void* pData, tools::Long nSize, bool bPdfOnly)
+{
+    TrueTypeFont* pFont;
+    if (OpenTTFontBuffer(pData, nSize, 0, &pFont) != SFErrCodes::Ok)
+        return true; // no known restriction, as sufficientTTFRights()
+    TTGlobalFontInfo aInfo;
+    GetTTGlobalFontInfo(pFont, &aInfo);
+    CloseTTFont(pFont);
+    const sal_uInt32 nFsType = aInfo.typeFlags;
+    if (nFsType & 0x0200)
+        return false; // bitmap embedding only
+    if (bPdfOnly && (nFsType & 0x0100))
+        return false; // no subsetting
+    if (nFsType & 0x0008)
+        return true; // Editable (wins over 0x0002 and 0x0004)
+    if (nFsType & 0x0004)
+        return true; // Preview & Print: every output (owner, 2026-10-22; wins over 0x0002)
+    if (nFsType & 0x0002)
+        return false; // Restricted alone
+    return true; // Installable, or no rights information
+}
+}
+#endif
