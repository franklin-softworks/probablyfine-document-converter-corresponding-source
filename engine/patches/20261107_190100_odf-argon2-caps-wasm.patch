+            }
+            if (pReason)
+            {
+                SAL_WARN("package", "Argon2 parameters out of range");
+#ifdef __EMSCRIPTEN__
+                // as for the PBKDF2 count above: the bridge reports ENCRYPTION_REFUSED with this reason (no password helps)
