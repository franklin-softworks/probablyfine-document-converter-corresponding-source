diff --git a/sdext/source/pdfimport/xpdfwrapper/pdfioutdev_gpl.hxx b/sdext/source/pdfimport/xpdfwrapper/pdfioutdev_gpl.hxx
index 805c25a..f6025cf 100644
--- a/sdext/source/pdfimport/xpdfwrapper/pdfioutdev_gpl.hxx
+++ b/sdext/source/pdfimport/xpdfwrapper/pdfioutdev_gpl.hxx
@@ -157,4 +157,20 @@ namespace pdfi
         std::vector<bool>                       m_aGroupIsSoftMask;
         int                                     m_nSoftMaskDepth = 0;
+        // FG-176: a transparency group's constant alpha (the /ca in force at
+        // its "Do") is applied by poppler when the group is PAINTED, after its
+        // content; Gfx::drawForm resets the opacity to 1 for the content. This
+        // device has no groups, so the alpha would be lost and Illustrator
+        // blend shadows (stacks of groups at /ca 0.03, 0.06, ...) come in
+        // opaque. Instead multiply it into every fill/stroke alpha emitted
+        // inside the group. m_aSavedFillOpacity mirrors saveState/restoreState;
+        // Gfx::drawForm calls saveState immediately before the reset, so its
+        // top holds the group's alpha when beginTransparencyGroup arrives.
+        // Exact for a group of non-overlapping content; overlapping content
+        // inside one group is composited per element (slightly darker).
+        // Not covered: images and text, which carry no alpha on this path at
+        // all (neither /ca nor a group's).
+        std::vector<double>                     m_aSavedFillOpacity;
+        std::vector<double>                     m_aGroupAlphaStack;
+        double                                  m_fGroupAlpha = 1.0; ///< product of the open groups' alphas
 
         // FG-175: soft masks APPLIED. The span tracker is driven by the same
@@ -398,4 +414,15 @@ namespace pdfi
             if (forSoftMask)
                 ++m_nSoftMaskDepth;
+            // FG-176: a soft-mask group is a mask definition, not painted
+            // content, so it carries no group alpha.
+            const double fAlpha = (forSoftMask || m_aSavedFillOpacity.empty())
+                ? 1.0 : m_aSavedFillOpacity.back();
+            m_aGroupAlphaStack.push_back(m_fGroupAlpha);
+            m_fGroupAlpha *= fAlpha;
+            if (fAlpha != 1.0)
+            {
+                updateFillColor(state);
+                updateStrokeColor(state);
+            }
             if (spanTrackerActive())
                 applySpanTransition(state, m_aSpans.beginGroup(forSoftMask));
@@ -405,4 +432,11 @@ namespace pdfi
             if (spanTrackerActive())
                 applySpanTransition(state, m_aSpans.endGroup());
+            // FG-176: no colour record needed; Gfx::drawForm restores the
+            // saved state (restoreState) straight after this call.
+            if (!m_aGroupAlphaStack.empty())
+            {
+                m_fGroupAlpha = m_aGroupAlphaStack.back();
+                m_aGroupAlphaStack.pop_back();
+            }
             if (m_aGroupIsSoftMask.empty())
                 return;
