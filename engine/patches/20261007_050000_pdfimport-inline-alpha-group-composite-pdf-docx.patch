+// FG-177: transparency groups composited as ONE shape where that is exact.
+//
+// The wrapper multiplies a group's alpha into every fill it emits inside the
+// group (FG-176). That is the group's composite only where its members do
+// not overlap: n overlapping layers at alpha a show 1-(1-a)^n, the group a.
+// fahr page 17's background is two groups of 36 overlapping opaque ribbons
+// at /ca 0.30 -- per element they stacked into dark bands.
+//
+// When every element the group produced is a plain fill (no stroke, no
+// bitmap) of one colour at exactly the group's alpha, the group's composite
+// is that colour at that alpha over the UNION of the fills: emit the union
+// once. The members are already clipped and in device space (fillPath), so
+// differing clips inside the group do not matter. Anything else -- strokes,
+// text, images, several colours, an element whose own /ca was not 1, a
+// nested group (its merged element carries the inner alpha) -- keeps the
+// per-element approximation, as before this change.
+//
+// Cost is bounded: no merge when no two members' bounds overlap (per
+// element is exact then), and none above nMaxMembers / nMaxPoints (the
+// polygon cutter is quadratic in edges). Curves are subdivided first, so a
+// merged group is emitted as straight segments.
+void PDFIProcessor::beginAlphaGroup( double fAlpha )
+{
+    AlphaGroupFrame aFrame;
+    aFrame.pParent = m_pCurElement;
+    aFrame.nChildrenBefore = m_pCurElement ? m_pCurElement->Children.size() : 0;
+    aFrame.fAlpha = fAlpha;
+    m_aAlphaGroups.push_back(aFrame);
+}
+
+namespace
+{
+    basegfx::B2DPolyPolygon lcl_flattened( const basegfx::B2DPolyPolygon& rPoly )
+    {
+        return rPoly.areControlPointsUsed() ? basegfx::utils::adaptiveSubdivideByAngle(rPoly) : rPoly;
+    }
+    sal_uInt32 lcl_pointCount( const basegfx::B2DPolyPolygon& rPoly )
+    {
+        sal_uInt32 n = 0;
+        for (sal_uInt32 i = 0; i < rPoly.count(); ++i)
+            n += rPoly.getB2DPolygon(i).count();
+        return n;
+    }
+}
+
+void PDFIProcessor::endAlphaGroup()
+{
+    if (m_aAlphaGroups.empty())
+        return;
+    const AlphaGroupFrame aFrame = m_aAlphaGroups.back();
+    m_aAlphaGroups.pop_back();
+
+    Element* pParent = aFrame.pParent;
+    if (!pParent || pParent != m_pCurElement)
+        return;
+    if (pParent->Children.size() < aFrame.nChildrenBefore + 2)
+        return;
+
+    constexpr size_t nMaxMembers = 512;
+    constexpr sal_uInt32 nMaxPoints = 12000;
+
+    typedef std::list<std::unique_ptr<Element>>::iterator ChildIt;
+    std::vector<ChildIt> aMembers;
+    std::vector<basegfx::B2DRange> aRanges;
+    const GraphicsContext* pFirstGC = nullptr;
+    bool bOverlap = false;
+
+    ChildIt it = pParent->Children.begin();
+    std::advance(it, aFrame.nChildrenBefore);
+    for (; it != pParent->Children.end(); ++it)
+    {
+        PolyPolyElement* pPoly = dynamic_cast<PolyPolyElement*>(it->get());
+        if (!pPoly)
+            return; // text, an image frame, ...: not a plain fill group
+        if (pPoly->Action != PATH_FILL && pPoly->Action != PATH_EOFILL)
+            return;
+        if (pPoly->FillImage != -1)
+            return;
+        const GraphicsContext& rGC = getGraphicsContext(pPoly->GCId);
+        if (!pFirstGC)
+        {
+            // Alpha exactly the group's: the element's own /ca was 1.
+            if (!basegfx::fTools::equal(rGC.FillColor.Alpha, aFrame.fAlpha, 1e-4))
+                return;
+            pFirstGC = &rGC;
+        }
+        else if (rGC.FillColor.Red   != pFirstGC->FillColor.Red   ||
+                 rGC.FillColor.Green != pFirstGC->FillColor.Green ||
+                 rGC.FillColor.Blue  != pFirstGC->FillColor.Blue  ||
+                 rGC.FillColor.Alpha != pFirstGC->FillColor.Alpha ||
+                 rGC.BlendMode       != pFirstGC->BlendMode)
+        {
+            return;
+        }
+        if (aMembers.size() >= nMaxMembers)
+            return;
+        const basegfx::B2DRange aRange(pPoly->PolyPoly.getB2DRange());
+        if (!bOverlap)
+            for (const basegfx::B2DRange& rOther : aRanges)
+                if (aRange.overlaps(rOther)) { bOverlap = true; break; }
+        aRanges.push_back(aRange);
+        aMembers.push_back(it);
+    }
+    if (aMembers.size() < 2 || !bOverlap)
+        return;
+
+    basegfx::B2DPolyPolygonVector aInput;
+    aInput.reserve(aMembers.size());
+    sal_uInt32 nPoints = 0;
+    for (const ChildIt& rIt : aMembers)
+    {
+        basegfx::B2DPolyPolygon aPoly(lcl_flattened(static_cast<PolyPolyElement*>(rIt->get())->PolyPoly));
+        nPoints += lcl_pointCount(aPoly);
+        if (nPoints > nMaxPoints)
+            return;
+        aInput.push_back(aPoly);
+    }
+
+    const basegfx::B2DPolyPolygon aUnion(basegfx::utils::mergeToSinglePolyPolygon(aInput));
+    if (!aUnion.count())
+        return;
+
+    // The first member becomes the group: lowest z-order, its colour, its
+    // alpha (the group's). The union is solved, so nonzero and even-odd
+    // agree on it.
+    PolyPolyElement* pFirst = static_cast<PolyPolyElement*>(aMembers.front()->get());
+    pFirst->PolyPoly = aUnion;
+    pFirst->Action = PATH_FILL;
+    pFirst->updateGeometry();
+    for (size_t i = 1; i < aMembers.size(); ++i)
+        pParent->Children.erase(aMembers[i]);
+}
