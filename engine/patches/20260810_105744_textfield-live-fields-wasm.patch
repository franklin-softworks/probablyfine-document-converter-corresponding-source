 } // namespace
 
+#ifdef __EMSCRIPTEN__
+std::vector<Reference<XTextField>> TextField::createFieldsWasm(
+        const Reference<XModel>& xModel) const
+{
+    // Same mapping insertAt() uses below (msType -> UNO field service), so
+    // the WASM path is created from the identical field object native
+    // LibreOffice would have created -- including datetime's IsFixed=false,
+    // which is what makes the value recompute at render time instead of
+    // staying at the string PowerPoint cached in <a:t> at authoring time.
+    std::vector<Reference<XTextField>> aFields;
+    lclCreateTextFields(aFields, xModel, msType);
+    return aFields;
+}
+#endif
