+#ifdef __EMSCRIPTEN__
+void PDFIProcessor::parseHeartbeat()
+{
+    // FG-142: re-send the current page number. The LOK StatusIndicator
+    // forwards a value whose percent is unchanged (it only drops a lower one),
+    // so this reaches the web driver as a progress event and keeps its
+    // no-progress watchdog from stopping a page that is slow but advancing.
+    if( m_xStatusIndicator.is() && m_pCurPage )
+        m_xStatusIndicator->setValue( m_pCurPage->PageNumber );
+}
+#endif
