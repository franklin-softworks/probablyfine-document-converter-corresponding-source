+/** appendTextContent() for an embedded object, but reporting whether the object
+    actually landed in the document instead of swallowing the failure. */
+bool DomainMapper_Impl::insertOLEObject(const rtl::Reference<SwXTextEmbeddedObject>& xOLE)
+{
+    if (m_aTextAppendStack.empty() || !hasTableManager() || getTableManager().isIgnore())
+        return false;
+
+    uno::Reference<text::XTextAppendAndConvert> xTextAppendAndConvert(
+        m_aTextAppendStack.top().xTextAppend, uno::UNO_QUERY);
+    if (!xTextAppendAndConvert.is())
+        return false;
+
+    try
+    {
+        if (m_aTextAppendStack.top().xInsertPosition.is())
+            xTextAppendAndConvert->insertTextContentWithProperties(
+                xOLE, uno::Sequence<beans::PropertyValue>(),
+                m_aTextAppendStack.top().xInsertPosition);
+        else
+            xTextAppendAndConvert->appendTextContent(
+                xOLE, uno::Sequence<beans::PropertyValue>());
+    }
+    catch (const uno::Exception&)
+    {
+        TOOLS_WARN_EXCEPTION("writerfilter.dmapper", "failed to insert OLE object");
+        return false;
+    }
+
+    // An insert that raises no exception is NOT proof that anything landed.
+    // SwXFrame::attachToRange creates the OLE node only "if (xIPObj.is())" --
+    // when the embedded object cannot be created from its CLSID it takes no
+    // else branch, throws nothing, and returns leaving the frame a descriptor
+    // with no frame format. That is the whole of this bug: a formula whose
+    // CLSID is Math (078B7ABA-...) hits it in the writer-only WASM module,
+    // where Math is not linked. Ask the object whether it is really in the
+    // document rather than trusting the silence.
+    return xOLE->GetFrameFormat() != nullptr;
+}
