+#ifdef __EMSCRIPTEN__
+// FG-141: the upstream walk below collects the number of every same-type fly whose name
+// starts with the default base, sorts them and takes the first gap: O(N log N) per call,
+// O(N^2 log N) for a document that creates N frames or shapes. A large PDF imported into
+// Writer creates tens of thousands of draw objects (vision2030: 43,088), each named
+// through GetUniqueShapeName (SwFmDrawPage::add), inside the import's silent emit phase;
+// measured 282 s of a 310 s emit with the walk merely reduced to a name comparison.
+//
+// lcl_GetUniqueDefaultFlyName finds the name in O(1) amortised instead. Like upstream
+// a61128c95e32 ("improve perf of lcl_GetUniqueFlyName", reverted in f1c247acd6b8 only
+// because UITests depend on predictable names), it keeps a counter per default base
+// (sw::DefaultFlyNameState, on the SwDoc) and only ever moves it forward, so a number
+// freed after the counter passed it (a deleted or renamed object) is not reused: names
+// are the same as upstream's except that gaps are not refilled. Every candidate is
+// still checked, by the rules below, and is returned only if it is provably free.
+//
+// What "free" means is upstream's scope, widened, never narrowed:
+//  * fly frames (RES_FLYFRMFMT): no fly format has that name. Exact and current via the
+//    SpzFrameFormats (type, name) index, which SwFrameFormat::SetFormatName maintains.
+//  * draw objects (RES_DRAWFRMFMT): no draw format has that name (index, as above), no
+//    fly format has it either (not checked upstream; costs one more index lookup), and
+//    no SdrObject reachable from a draw format -- including group members -- has it.
+//    SdrObject names are not indexed anywhere, so for them the state holds a SUPERSET
+//    of the numbers in use above the counter (aDrawNumbersAbove), kept current like this
+//    (lcl_syncDrawNames):
+//      - once per document and base, a full walk: every draw format's object (exactly
+//        upstream's scope) plus every object on every page of the draw model, recursing
+//        into groups;
+//      - after that, svx::objnamelog: svx records each SdrObject name at the only two
+//        places a name can become visible -- SdrObject::SetName (any rename, import,
+//        undo/redo of a rename) and the moment an object enters an SdrObjList
+//        (SdrObjList::InsertObjectIntoContainer / ReplaceObjectInContainer: a clone,
+//        a paste, an undo-restored deletion, a group with named members; recursively).
+//        Those are the only writers of the name (SdrObjPlusData::aObjName: SetName and
+//        the clone constructor, and a clone is invisible until inserted). Each call
+//        absorbs the entries written since the previous call.
+//    An object reachable from a draw format at call time was therefore either seen by
+//    the walk, or named or inserted since, so its number is in the set. The one
+//    assumption is Writer's own invariant that a draw format's master object is in the
+//    draw page (SwDrawContact's constructor and InsertMasterIntoDrawPage insert it).
+//  * if the log has wrapped since the last call (more than objnamelog::nCapacity names
+//    written in between -- possible only when something else renames or inserts that
+//    much between two calls), the entries are gone, so the walk is simply redone.
+//  * if the counter would overflow, std::nullopt sends the caller to the upstream walk.
+//
+// Names are matched exactly: only "<base><digits>" as OUString::number writes it (no
+// sign, no leading zero) can equal a candidate, so nothing else needs remembering.
+static void lcl_noteDrawName(sw::DefaultFlyNameState& rState, std::u16string_view rBase, std::u16string_view rName)
+{
+    if (!o3tl::starts_with(rName, rBase))
+        return;
+    const std::u16string_view aDigits = rName.substr(rBase.size());
+    if (aDigits.empty() || aDigits.size() > 10 || aDigits[0] == '0')
+        return;
+    sal_Int64 nNum = 0;
+    for (const sal_Unicode c : aDigits)
+    {
+        if (c < '0' || c > '9')
+            return;
+        nNum = nNum * 10 + (c - '0');
+    }
+    if (nNum > rState.nCounter && nNum <= SAL_MAX_INT32)
+        rState.aDrawNumbersAbove.insert(static_cast<sal_Int32>(nNum));
+}
+
+static void lcl_noteDrawNamesIn(sw::DefaultFlyNameState& rState, std::u16string_view rBase, const SdrObject& rObj)
+{
+    lcl_noteDrawName(rState, rBase, rObj.GetName());
+    // tdf#122487 group members count too, as in lcl_collectUsedNums
+    if (const SdrObjList* pSub = rObj.GetSubList())
+    {
+        for (const rtl::Reference<SdrObject>& pObj : *pSub)
+            lcl_noteDrawNamesIn(rState, rBase, *pObj);
+    }
+}
+
+static void lcl_syncDrawNames(const SwDoc& rDoc, sw::DefaultFlyNameState& rState, std::u16string_view rBase)
+{
+    const sal_uInt64 nNow = svx::objnamelog::GetSerial();
+    if (rState.bDrawWalked && nNow - rState.nDrawLogSerial <= svx::objnamelog::nCapacity)
+    {
+        for (sal_uInt64 nEntry = rState.nDrawLogSerial; nEntry < nNow; ++nEntry)
+            lcl_noteDrawName(rState, rBase, svx::objnamelog::GetEntry(nEntry));
+    }
+    else
+    {
+        rState.aDrawNumbersAbove.clear();
+        for (const sw::SpzFrameFormat* pFormat : *rDoc.GetSpzFrameFormats())
+        {
+            if (pFormat->Which() != RES_DRAWFRMFMT)
+                continue;
+            if (const SdrObject* pObj = pFormat->FindSdrObject())
+                lcl_noteDrawNamesIn(rState, rBase, *pObj);
+        }
+        if (const SwDrawModel* pModel = rDoc.getIDocumentDrawModelAccess().GetDrawModel())
+        {
+            for (sal_uInt16 nPage = 0; nPage < pModel->GetPageCount(); ++nPage)
+                for (const rtl::Reference<SdrObject>& pObj : *pModel->GetPage(nPage))
+                    lcl_noteDrawNamesIn(rState, rBase, *pObj);
+            for (sal_uInt16 nPage = 0; nPage < pModel->GetMasterPageCount(); ++nPage)
+                for (const rtl::Reference<SdrObject>& pObj : *pModel->GetMasterPage(nPage))
+                    lcl_noteDrawNamesIn(rState, rBase, *pObj);
+        }
+        rState.bDrawWalked = true;
+    }
+    rState.nDrawLogSerial = nNow;
+}
+
+static std::optional<UIName> lcl_GetUniqueDefaultFlyName(const SwDoc& rDoc, sal_uInt16 eType, const OUString& rBase)
+{
+    if (eType != RES_FLYFRMFMT && eType != RES_DRAWFRMFMT)
+        return std::nullopt;
+    sw::DefaultFlyNameState& rState = rDoc.GetDefaultFlyNameState(rBase);
+    const bool bDraw = eType == RES_DRAWFRMFMT;
+    if (bDraw)
+        lcl_syncDrawNames(rDoc, rState, rBase);
+    const sw::FrameFormats<sw::SpzFrameFormat*>& rFormats = *rDoc.GetSpzFrameFormats();
+    while (rState.nCounter < SAL_MAX_INT32)
+    {
+        const sal_Int32 nNum = ++rState.nCounter;
+        if (bDraw && rState.aDrawNumbersAbove.erase(nNum))
+            continue;
+        UIName aCandidate(rBase + OUString::number(nNum));
+        if (rFormats.findByTypeAndName(RES_FLYFRMFMT, aCandidate) != rFormats.typeAndNameEnd())
+            continue;
+        if (bDraw && rFormats.findByTypeAndName(RES_DRAWFRMFMT, aCandidate) != rFormats.typeAndNameEnd())
+            continue;
+        return aCandidate;
+    }
+    return std::nullopt;
+}
+#endif
