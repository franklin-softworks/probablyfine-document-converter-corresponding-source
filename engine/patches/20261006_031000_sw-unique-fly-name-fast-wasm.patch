+#include <sal/types.h>
+
+class SdrObject;
+
+/** FG-141 (WASM only): a bounded record of SdrObject names as they become visible.
+
+    An entry is written whenever SdrObject::SetName sets a non-empty name, and whenever an
+    object enters an SdrObjList (its name and, recursively, its sub-objects' names). Those
+    are the only ways a name can appear on an object that a document can reach, so a
+    reader that has seen every object once and then reads every entry written since knows
+    every name in use. Writer's default shape naming (sw/source/core/doc/doclay.cxx,
+    lcl_GetUniqueDefaultFlyName) relies on this to avoid walking every object per name.
+
+    Process-wide and unsynchronised: the WASM build runs single-threaded. The entries are
+    a ring of nCapacity; a reader that falls further behind than that must start over.
+*/
+namespace svx::objnamelog
+{
+constexpr sal_uInt64 nCapacity = 4096;
+
+/// Serial number the next entry will get; the entries [GetSerial() - nCapacity, GetSerial())
+/// (those >= 0) are readable.
+SVXCORE_DLLPUBLIC sal_uInt64 GetSerial();
+
+/// The entry with serial nSerial; requires nSerial < GetSerial() <= nSerial + nCapacity.
+SVXCORE_DLLPUBLIC const OUString& GetEntry(sal_uInt64 nSerial);
+
+/// Records rName (nothing if empty). Called by SdrObject::SetName.
+SVXCORE_DLLPUBLIC void NoteName(const OUString& rName);
+
+/// Records rObj's name and those of everything in its sub-list, recursively. Called when
+/// rObj enters an SdrObjList.
+SVXCORE_DLLPUBLIC void NoteInserted(const SdrObject& rObj);
+}
+
+#endif
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
