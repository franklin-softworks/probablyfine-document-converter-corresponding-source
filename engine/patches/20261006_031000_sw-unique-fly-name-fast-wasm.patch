+namespace sw
+{
+/// FG-141: what lcl_GetUniqueFlyName (doclay.cxx) remembers about one default name base
+/// ("Frame", "Image", "Shape", "DrawObject", ...) of one SwDoc, so that a unique default
+/// name costs O(1) amortised instead of a walk over every fly. Kept on the SwDoc, never
+/// process-global: documents are loaded one after another in one WASM instance.
+struct DefaultFlyNameState
+{
+    /// Every number <= nCounter has been handed out or skipped, and is never proposed again.
+    sal_Int32 nCounter = 0;
+    /// Draw objects only: aDrawNumbersAbove was built by a full walk of the document.
+    bool bDrawWalked = false;
+    /// Draw objects only: svx::objnamelog serial up to which names have been absorbed.
+    sal_uInt64 nDrawLogSerial = 0;
+    /// Draw objects only: every number > nCounter for which some SdrObject may be named
+    /// <base><number> (a superset; see lcl_syncDrawNames in doclay.cxx).
+    std::unordered_set<sal_Int32> aDrawNumbersAbove;
+};
+}
+#endif
