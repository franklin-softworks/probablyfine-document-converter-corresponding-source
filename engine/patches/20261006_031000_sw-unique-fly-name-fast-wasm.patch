+#ifdef __EMSCRIPTEN__
+// FG-141: see include/svx/svdobjnamelog.hxx.
+namespace svx::objnamelog
+{
+namespace
+{
+std::array<OUString, static_cast<std::size_t>(nCapacity)> g_aEntries;
+sal_uInt64 g_nSerial = 0;
+}
+
+sal_uInt64 GetSerial() { return g_nSerial; }
+
+const OUString& GetEntry(sal_uInt64 nSerial)
+{
+    assert(nSerial < g_nSerial && g_nSerial - nSerial <= nCapacity);
+    return g_aEntries[static_cast<std::size_t>(nSerial % nCapacity)];
+}
+
+void NoteName(const OUString& rName)
+{
+    if (rName.isEmpty())
+        return;
+    g_aEntries[static_cast<std::size_t>(g_nSerial % nCapacity)] = rName;
+    ++g_nSerial;
+}
+
+void NoteInserted(const SdrObject& rObj)
+{
+    NoteName(rObj.GetName());
+    if (const SdrObjList* pSub = rObj.GetSubList())
+    {
+        for (const rtl::Reference<SdrObject>& pObj : *pSub)
+            NoteInserted(*pObj);
+    }
+}
+}
+#endif
