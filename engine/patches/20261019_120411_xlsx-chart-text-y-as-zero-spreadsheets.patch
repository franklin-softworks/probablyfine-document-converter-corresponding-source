+    // text cell as 0 (its <c:numCache> holds 0); Calc read NaN and dropped the point.
+    // Only for the y values of a document loaded with one of Excel's filters; empty
+    // cells stay gaps, and every other role and format is unchanged.
+    const bool bTextAsZero = m_aRole == u"values-y" && lcl_isExcelDocument(m_pDocument);
+#endif
 
     for (const auto& rxToken : m_aTokens)
     {
@@ -2633,11 +2660,29 @@ void ScChart2DataSequence::BuildDataCache()
                                     aItem.mfValue = pFCell->GetValue();
