diff --git a/sc/source/filter/oox/excelchartconverter.cxx b/sc/source/filter/oox/excelchartconverter.cxx
index 3800cf6..690d60a 100644
--- a/sc/source/filter/oox/excelchartconverter.cxx
+++ b/sc/source/filter/oox/excelchartconverter.cxx
@@ -30,6 +30,10 @@
 #include <oox/drawingml/chart/datasourcemodel.hxx>
 #include <oox/helper/containerhelper.hxx>
 #include <formulaparser.hxx>
+#include <PivotTableDataSequence.hxx>
+
+#include <algorithm>
+#include <vector>
 
 namespace oox::xls {
 
@@ -116,6 +120,49 @@ Reference< XDataSequence > ExcelChartConverter::createDataSequence(
                 OSL_FAIL( "ExcelChartConverter::createDataSequence - cannot create data sequence" );
             }
         }
+
+        // FG-051: an inline literal (<c:numLit>/<c:strLit>) is not a cell
+        // reference, so the sheet data provider cannot compile the array
+        // string above and xDataSeq is still null here. In a chart whose
+        // other sources DO reference the sheet nothing else supplies this
+        // sequence -- the all-literal fallback in oox Shape::createAndInsert
+        // re-imports a chart with an internal data table only when its FIRST
+        // used sequence has no values -- so the literal was silently dropped:
+        // a bubble lost its size, a bar chart its category labels. Materialise
+        // it as a literal-backed sequence (values, no source range) instead.
+        // All-literal charts never enter this block and keep taking the
+        // internal-data-table fallback exactly as before. So does a chart in
+        // which ANY reference fails to resolve (e.g. an external workbook
+        // name, tdf140489.xlsx): its first used sequence may be null, the
+        // fallback then re-imports the chart from its caches, and that only
+        // works if the literal was left null as well.
+        if (!xDataSeq.is() && hasReferencedData() && allReferencedSourcesResolve(rxDataProvider))
+        {
+            // ptCount and the point indices come from the file: bound the
+            // allocation to Calc's row limit, above which the sequence stays
+            // null (today's behaviour) rather than exhausting memory.
+            constexpr sal_Int64 nMaxLiteralPoints = 1048576;
+            sal_Int64 nCount = std::max<sal_Int64>(rDataSeq.mnPointCount, 0);
+            if (!rDataSeq.maData.empty())
+                nCount = std::max<sal_Int64>(nCount, sal_Int64(rDataSeq.maData.rbegin()->first) + 1);
+            if (nCount > 0 && nCount <= nMaxLiteralPoints)
+            {
+                // a point missing from the map stays an empty ValueAndFormat (NaN)
+                std::vector<sc::ValueAndFormat> aValues(static_cast<size_t>(nCount));
+                for (const auto& rEntry : rDataSeq.maData)
+                {
+                    if (rEntry.first < 0 || rEntry.first >= nCount)
+                        continue;
+                    double fValue = 0.0;
+                    OUString aString;
+                    if (rEntry.second >>= fValue)
+                        aValues[rEntry.first] = sc::ValueAndFormat(fValue, 0);
+                    else if (rEntry.second >>= aString)
+                        aValues[rEntry.first] = sc::ValueAndFormat(aString);
+                }
+                xDataSeq.set(new sc::PivotTableDataSequence(&getScDocument(), OUString(), std::move(aValues)));
+            }
+        }
     }
     return xDataSeq;
 }
