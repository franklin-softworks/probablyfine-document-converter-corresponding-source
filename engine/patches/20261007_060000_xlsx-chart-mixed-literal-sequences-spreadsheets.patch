     return aBuffer.makeStringAndClear();
 }
 
+namespace {
+
+/** A data source references the sheet when its formula is not a quoted
+    string constant. TextContext stores a literal <c:tx><c:v> series name as
+    the formula "\"name\"" (titlecontext.cxx), which is a literal too. */
+bool lclIsReferencedSource( const DataSourceModel* pSource )
+{
+    if( !pSource || !pSource->mxDataSeq.is() )
+        return false;
+    const OUString& rFormula = pSource->mxDataSeq->maFormula;
+    return !rFormula.isEmpty() && !rFormula.startsWith( "\"" );
+}
+
+/** Calls rFunc for every referenced series data source (values, categories,
+    point sizes, error-bar values) of the chart; stops and returns true as
+    soon as rFunc returns true. */
+template< typename Func >
+bool lclAnyReferencedSource( const ChartSpaceModel& rChartModel, Func&& rFunc )
+{
+    if( !rChartModel.mxPlotArea.is() )
+        return false;
+    for( const auto& rxTypeGroup : rChartModel.mxPlotArea->maTypeGroups )
+    {
+        if( !rxTypeGroup )
+            continue;
+        for( const auto& rxSeries : rxTypeGroup->maSeries )
+        {
+            if( !rxSeries )
+                continue;
+            for( const auto& rSource : rxSeries->maSources )
+                if( lclIsReferencedSource( rSource.second.get() ) && rFunc( *rSource.second->mxDataSeq ) )
+                    return true;
+            for( const auto& rxErrorBar : rxSeries->maErrorBars )
+                if( rxErrorBar )
+                    for( const auto& rSource : rxErrorBar->maSources )
+                        if( lclIsReferencedSource( rSource.second.get() ) && rFunc( *rSource.second->mxDataSeq ) )
+                            return true;
+        }
+    }
+    return false;
+}
+
+/** Whether any series of the chart takes values, categories, point sizes or
+    error-bar values from a cell reference. */
+bool lclHasReferencedData( const ChartSpaceModel& rChartModel )
+{
+    return lclAnyReferencedSource( rChartModel, []( const DataSequenceModel& ) { return true; } );
+}
+
+} // namespace
+
+bool ChartConverter::allReferencedSourcesResolve( const Reference< XDataProvider >& rxDataProvider )
+{
+    if( moReferencesResolve.has_value() )
+        return *moReferencesResolve;
+    bool bAllResolve = mpChartModel && rxDataProvider.is();
+    if( bAllResolve )
+    {
+        // Create and discard. This mirrors the test Shape::createAndInsert
+        // applies to the first used sequence: null, OR no data. A defined
+        // name whose code is a formula rather than a range (tdf140489:
+        // GrowthIR = Capital*(1+InterestRate/12)^vector) gives a sequence
+        // that exists but resolves to no cells; the chart must then stay on
+        // the cache path exactly as if the reference had failed.
+        bAllResolve = !lclAnyReferencedSource( *mpChartModel, [&]( const DataSequenceModel& rDataSeq ) {
+            Reference< XDataSequence > xSeq = createDataSequence( rxDataProvider, rDataSeq, OUString(), OUString() );
+            return !xSeq.is() || !xSeq->getData().hasElements();
+        } );
+    }
+    moReferencesResolve = bAllResolve;
+    return bAllResolve;
+}
+
 ChartConverter::ChartConverter()
 {
 }
