+/// FG-178: is the object in one of Writer's background ("hell") layers -- the layers
+/// DOCX export marks behindDoc="1" (see the layer test in startDMLAnchorInline)?
+bool lcl_isInBackgroundLayer(const SdrObject& rObj)
+{
+    const SdrLayer* pLayer
+        = rObj.getSdrModelFromSdrObject().GetLayerAdmin().GetLayerPerID(rObj.GetLayer());
+    if (!pLayer)
+        return false;
+    const OUString& rName = pLayer->GetName();
+    return rName == u"Hell" || rName == u"HeaderFooterHell" || rName == u"InvisibleHell";
+}
+}
