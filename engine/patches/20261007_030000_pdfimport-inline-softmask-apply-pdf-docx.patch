+
+// FG-175: ExtGState soft masks (/SMask with a luminosity or alpha group).
+//
+// PDFOutDev emits editable draw shapes and has no transparency groups, so
+// content painted under a soft mask used to arrive unmasked: a bubble's
+// glow, which the source shows only through a circular luminosity mask,
+// became a large grey square over the bubble. poppler never hands the mask
+// group's stream to an OutputDev; the only correct renderer of it is
+// poppler's own Gfx driving a SplashOutputDev. So each page that declares a
+// soft mask is rendered twice:
+//
+//   1. pre-pass  MaskLayerRecorder (a SplashOutputDev) at ~2 px/pt. Splash
+//                applies every soft mask natively. The recorder paints ONLY
+//                content that is effectively masked, into a bitmap cleared at
+//                the start of each soft-mask SPAN, and crops the result into
+//                one RGBA layer per span (SoftMaskLayerStore).
+//   2. main pass PDFOutDev suppresses the masked content and, where the span
+//                begins, emits the recorded layer through the existing
+//                "shadedFill <x0> <y0> <x1> <y1> PNG <n>" record (a bitmap
+//                stretched over a device-space rectangle, FG-142).
+//
+// A SPAN is a maximal run of drawing during which a soft mask is in effect.
+// Both devices derive the span sequence from the same poppler hook events
+// (saveState / restoreState / setSoftMask / clearSoftMask / transparency
+// groups) through one shared state machine, SoftMaskSpanTracker, so span
+// ordinals agree by construction rather than by matching anything.
+//
+// Text is exempt: it stays text (editable) and is emitted unmasked. The
+// bundled poppler is built without FreeType, so Splash could not rasterize
+// glyphs anyway.
+//
+// Any failure of the pre-pass (exception, memory budget, span-count mismatch)
+// marks the page's store unusable, and PDFOutDev then behaves exactly as
+// before: masked content is emitted unmasked. Nothing is ever dropped.
+//
+// Known limits (documented, not silent):
+//  - Text as clip (Tr 7 / text clipping modes): the recorder draws no glyphs,
+//    so a text-shaped clip does not constrain what the recorder paints; the
+//    masked content inside such a clip is recorded unclipped by the text.
+//  - pageDeclaresSoftMask() scans the page resources (recursively through
+//    form XObjects and patterns) but not annotation appearance streams; a
+//    soft mask declared only there gets no pre-pass and is emitted unmasked.
+//  - Z-order: a layer is emitted when its span BEGINS (under the clip in
+//    effect at the "gs"), so text drawn later in the span lands above the
+//    masked content painted after it, which is the usual intent (labels over
+//    glows). A span is ended by every Q while it is active and resumed
+//    afterwards as a new span, so every layer is emitted under a clip that
+//    is at least as wide as any clip its pixels were painted under.
+//  - Capability answers: Gfx consults the device before deciding whether a
+//    /Group form is a transparency group (checkTransparencyGroup), whether
+//    to run a tiling pattern itself, etc. The recorder answers exactly as
+//    PDFOutDev does wherever the answer changes the hook sequence.
+//  - Pattern-filled stencil masks (doPatternImageMask): both devices pause
+//    the tracker between setSoftMaskFromImageMask and unsetSoftMaskFromImageMask.
+//  - Tiling patterns rendered privately (PDFOutDev) vs by Splash's nested
+//    Gfx (recorder) can make the two devices see different span sequences.
+//    Every span carries a begin AND an end signature (hook count, state
+//    depth, group depth); PDFOutDev compares the begin signature before
+//    emitting (fallback is lossless: unmasked emission for the rest of the
+//    page) and the end signature when its own span ends. An end mismatch is
+//    NOT recoverable — the layer was emitted at begin and the span's content
+//    suppressed — so it is logged distinctly ("ended out of step — content
+//    may be missing") for a gate to assert against, and the page falls back
+//    from there on. To keep the sequences identical the recorder returns
+//    PDFOutDev's own verdict from tilingPatternFill whenever it is not
+//    painting, and never lets Splash decline a tile it IS painting (it runs
+//    Gfx's per-tile fallback itself, outside the tracker).
+
+#ifndef INCLUDED_SDEXT_SOURCE_PDFIMPORT_XPDFWRAPPER_PDFISOFTMASK_HXX
+#define INCLUDED_SDEXT_SOURCE_PDFIMPORT_XPDFWRAPPER_PDFISOFTMASK_HXX
+
+#include <algorithm>
+#include <cstddef>
+#include <functional>
+#include <vector>
+
+namespace pdfi
+{
+    /// Where in the hook sequence a span began. Both devices compute it from
+    /// the same events, so a mismatch proves their sequences diverged.
+    struct SoftMaskSpanSignature
+    {
+        long nHooks  = 0; ///< tracker events seen before the span began
+        int  nLevels = 0; ///< GfxState levels
+        int  nGroups = 0; ///< open transparency groups
+        bool bNested = false;
+        bool operator==( const SoftMaskSpanSignature& r ) const
+        { return nHooks == r.nHooks && nLevels == r.nLevels && nGroups == r.nGroups && bNested == r.bNested; }
+        bool operator!=( const SoftMaskSpanSignature& r ) const { return !(*this == r); }
+    };
+
+    /// Span state machine shared by MaskLayerRecorder and PDFOutDev.
+    /// Drive it from the poppler hooks named after its methods; every method
+    /// returns which span (if any) ended and which began as a consequence.
+    class SoftMaskSpanTracker
+    {
+    public:
+        struct Transition
+        {
+            int  nEnded      = -1;    ///< ordinal of the span that ended, or -1
+            bool bEndedNested = false;
+            int  nBegan      = -1;    ///< ordinal of the span that began, or -1
+            bool bBeganNested = false; ///< began inside a masked group / mask definition
+            SoftMaskSpanSignature aBeganSignature;
+            SoftMaskSpanSignature aEndedSignature; ///< where the ended span ended
+        };
+
+        SoftMaskSpanTracker() { reset(); }
+
+        void reset()
+        {
+            m_aMask.assign(1, false);
+            m_aGroups.clear();
+            m_nActive = -1;
+            m_bActiveNested = false;
+            m_nNext = 0;
+            m_nSoftMaskDepth = 0;
+            m_nMaskedGroupDepth = 0;
+            m_nHooks = 0;
+        }
+
+        /// Gfx::saveState / saveStateStack: the new level inherits the mask.
+        Transition saveState()
+        {
+            ++m_nHooks;
+            m_aMask.push_back(m_aMask.back());
+            return Transition();
+        }
+
+        /// Gfx::restoreState: the popped level's mask dies; the mask of the
+        /// level below, if any, is in effect again (poppler's Splash keeps the
+        /// soft mask in its own state stack, which this mirrors). An active
+        /// span always ENDS here, even when the restored level is masked too:
+        /// the layer is emitted under the clip at span begin, and the clip
+        /// restored by Q may be wider than the one set inside, so content
+        /// painted after Q gets a span (and a layer) of its own.
+        Transition restoreState()
+        {
+            ++m_nHooks;
+            if (m_aMask.size() > 1)
+                m_aMask.pop_back();
+            Transition aT = endIfActive();
+            if (m_aMask.back())
+                begin(aT);
+            return aT;
+        }
+
+        /// OutputDev::setSoftMask: a (new) mask is in effect at this level.
+        /// A new mask always starts a new span, even if one was active.
+        Transition setSoftMask()
+        {
+            ++m_nHooks;
+            Transition aT = endIfActive();
+            m_aMask.back() = true;
+            begin(aT);
+            return aT;
+        }
+
+        /// OutputDev::clearSoftMask: "/SMask /None", or the top of every
+        /// Gfx::drawForm transparency group.
+        Transition clearSoftMask()
+        {
+            ++m_nHooks;
+            m_aMask.back() = false;
+            return sync();
+        }
+
+        /// OutputDev::beginTransparencyGroup. Gfx has already pushed a state
+        /// level and cleared the mask on it, so the mask that applies to the
+        /// group as a whole (through paintTransparencyGroup) is the one on the
+        /// level below.
+        Transition beginGroup(bool bForSoftMask)
+        {
+            ++m_nHooks;
+            Transition aT = endIfActive();
+            bool bMasked = false;
+            if (!bForSoftMask)
+            {
+                const size_t n = m_aMask.size();
+                bMasked = m_aMask.back() || (n >= 2 && m_aMask[n - 2]);
+            }
+            m_aGroups.push_back(Group{bForSoftMask, bMasked});
+            if (bForSoftMask)
+                ++m_nSoftMaskDepth;
+            else if (bMasked)
+                ++m_nMaskedGroupDepth;
+            return aT;
+        }
+
+        /// OutputDev::endTransparencyGroup. A mask set inside the group dies
+        /// with it (Splash discards the group's state).
+        Transition endGroup()
+        {
+            ++m_nHooks;
+            if (m_aGroups.empty())
+                return Transition();
+            const Group aG = m_aGroups.back();
+            m_aGroups.pop_back();
+            if (aG.bForSoftMask)
+                m_nSoftMaskDepth = std::max(0, m_nSoftMaskDepth - 1);
+            else if (aG.bMasked)
+                m_nMaskedGroupDepth = std::max(0, m_nMaskedGroupDepth - 1);
+            m_aMask.back() = false;
+            return endIfActive();
+        }
+
+        Transition endPage() { return endIfActive(); }
+
+        bool spanActive() const { return m_nActive >= 0; }
+        int  activeOrdinal() const { return m_nActive; }
+        bool activeNested() const { return m_bActiveNested; }
+        /// Ordinal the next span will get.
+        int  nextOrdinal() const { return m_nNext; }
+        /// Number of spans begun so far on this page.
+        int  spanCount() const { return m_nNext; }
+        /// Inside the definition of a soft mask (the mask group itself).
+        int  softMaskDepth() const { return m_nSoftMaskDepth; }
+        /// Inside a transparency group that will be composited through a mask.
+        int  maskedGroupDepth() const { return m_nMaskedGroupDepth; }
+        /// Content drawn now is composited through a soft mask.
+        bool effectivelyMasked() const { return spanActive() || m_nMaskedGroupDepth > 0; }
+
+    private:
+        struct Group { bool bForSoftMask; bool bMasked; };
+
+        Transition endIfActive()
+        {
+            Transition aT;
+            if (m_nActive >= 0)
+            {
+                aT.nEnded = m_nActive;
+                aT.bEndedNested = m_bActiveNested;
+                aT.aEndedSignature.nHooks  = m_nHooks;
+                aT.aEndedSignature.nLevels = static_cast<int>(m_aMask.size());
+                aT.aEndedSignature.nGroups = static_cast<int>(m_aGroups.size());
+                aT.aEndedSignature.bNested = m_bActiveNested;
+                m_nActive = -1;
+                m_bActiveNested = false;
+            }
+            return aT;
+        }
+
+        void begin(Transition& rT)
+        {
+            m_nActive = m_nNext++;
+            m_bActiveNested = m_nMaskedGroupDepth > 0 || m_nSoftMaskDepth > 0;
+            rT.nBegan = m_nActive;
+            rT.bBeganNested = m_bActiveNested;
+            rT.aBeganSignature.nHooks  = m_nHooks;
+            rT.aBeganSignature.nLevels = static_cast<int>(m_aMask.size());
+            rT.aBeganSignature.nGroups = static_cast<int>(m_aGroups.size());
+            rT.aBeganSignature.bNested = m_bActiveNested;
+        }
+
+        /// Make the span state agree with the mask flag of the current level.
+        Transition sync()
+        {
+            const bool bWant = m_aMask.back();
+            if (bWant && m_nActive < 0)
+            {
+                Transition aT;
+                begin(aT);
+                return aT;
+            }
+            if (!bWant && m_nActive >= 0)
+                return endIfActive();
+            return Transition();
+        }
+
+        std::vector<bool>  m_aMask;    ///< mask present, one entry per GfxState level
+        std::vector<Group> m_aGroups;  ///< open transparency groups
+        int  m_nActive;
+        bool m_bActiveNested;
+        int  m_nNext;
+        int  m_nSoftMaskDepth;
+        int  m_nMaskedGroupDepth;
+        long m_nHooks;
+    };
+
+    /// One recorded span: the masked content, composited, cropped to its
+    /// visible pixels, in recorder page pixels (top-down, origin at the
+    /// page's top-left, same device space as PDFOutDev at a different scale).
+    struct SoftMaskLayer
+    {
+        bool bNested = false; ///< inside a masked group: covered by the enclosing span
+        SoftMaskSpanSignature aSignature;    ///< where the recorder saw the span begin
+        SoftMaskSpanSignature aEndSignature; ///< where the recorder saw it end
+        int  nX = 0, nY = 0, nW = 0, nH = 0; ///< nW == 0: nothing visible
+        std::vector<unsigned char> aRGB;     ///< nW * nH * 3
+        std::vector<unsigned char> aAlpha;   ///< nW * nH
+    };
+
+    /// Everything the pre-pass learned about one page.
+    struct SoftMaskLayerStore
+    {
+        std::vector<SoftMaskLayer> aLayers;
+        bool   bUsable = false;   ///< false: PDFOutDev falls back to unmasked emission
+        double fDpi = 144.0;      ///< recorder resolution
+        int    nPageW = 0, nPageH = 0; ///< recorder bitmap size in px
+        size_t nBytes = 0;        ///< raw bytes held by aLayers
+        int    nSpans = 0;        ///< spans the recorder counted
+        int    nLayersWithPixels = 0;
+        const char* pFailure = nullptr; ///< why bUsable is false, for the log
+
+        void clear()
+        {
+            aLayers.clear();
+            bUsable = false;
+            nPageW = nPageH = 0;
+            nBytes = 0;
+            nSpans = 0;
+            nLayersWithPixels = 0;
+            pFailure = nullptr;
+        }
+        const SoftMaskLayer* get(int n) const
+        {
+            if (n < 0 || static_cast<size_t>(n) >= aLayers.size())
+                return nullptr;
+            return &aLayers[n];
+        }
+    };
+}
