+void PDFOutDev::clearSoftMask(GfxState* state)
+{
+    if (spanTrackerActive())
+        applySpanTransition(state, m_aSpans.clearSoftMask());
+}
+
+void PDFOutDev::applySpanTransition( GfxState* state, const SoftMaskSpanTracker::Transition& rT )
+{
+    if (rT.nEnded >= 0 && layersUsable())
+    {
+        // The span's layer went out at its begin and its content was
+        // suppressed since; if the recorder ended this span elsewhere, part
+        // of that content may not be in the layer. Not recoverable here —
+        // say so distinctly, and stop trusting the store for the page.
+        const SoftMaskLayer* pEnded = m_pLayers->get(rT.nEnded);
+        if (!pEnded || pEnded->aEndSignature != rT.aEndedSignature)
+        {
+            fprintf(stderr, "[SMASK] page %d: span %d ended out of step - content may be missing "
+                            "(hooks %ld/%ld, levels %d/%d, groups %d/%d)\n",
+                    m_nBeatPage, rT.nEnded,
+                    rT.aEndedSignature.nHooks, pEnded ? pEnded->aEndSignature.nHooks : -1L,
+                    rT.aEndedSignature.nLevels, pEnded ? pEnded->aEndSignature.nLevels : -1,
+                    rT.aEndedSignature.nGroups, pEnded ? pEnded->aEndSignature.nGroups : -1);
+            m_bLayersUsable = false;
+        }
+    }
+    if (rT.nBegan < 0 || !layersUsable())
+        return;
+    // Every span (nested ones too) must have begun at the same point of the
+    // hook sequence in the recorder, or the two sequences diverged and the
+    // ordinals would pair the wrong layers. Fall back for the rest of the
+    // page BEFORE anything is suppressed or emitted: unmasked, never lost.
+    const SoftMaskLayer* pLayer = m_pLayers->get(rT.nBegan);
+    if (!pLayer || pLayer->aSignature != rT.aBeganSignature)
+    {
+        fprintf(stderr, "[SMASK] page %d: span %d %s (recorder saw %d spans; hooks %ld/%ld, "
+                        "levels %d/%d, groups %d/%d); unmasked emission for the rest of the page\n",
+                m_nBeatPage, rT.nBegan, pLayer ? "began elsewhere in the recorder" : "has no recorded layer",
+                m_pLayers->nSpans,
+                rT.aBeganSignature.nHooks, pLayer ? pLayer->aSignature.nHooks : -1L,
+                rT.aBeganSignature.nLevels, pLayer ? pLayer->aSignature.nLevels : -1,
+                rT.aBeganSignature.nGroups, pLayer ? pLayer->aSignature.nGroups : -1);
+        m_bLayersUsable = false;
+        return;
+    }
+    if (!rT.bBeganNested)
+        emitSoftMaskLayer(state, rT.nBegan);
+}
+
+void PDFOutDev::emitSoftMaskLayer( GfxState* state, int nOrdinal )
+{
+    if (!layersUsable() || m_bSkipImages)
+        return;
+    const SoftMaskLayer* pLayer = m_pLayers->get(nOrdinal);
+    if (!pLayer)
+        return; // applySpanTransition already fell back
+    if (pLayer->bNested || pLayer->nW <= 0 || pLayer->nH <= 0)
+        return; // covered by the enclosing span, or the mask hid everything
+    const size_t nPixels = static_cast<size_t>(pLayer->nW) * pLayer->nH;
+    if (pLayer->aRGB.size() != nPixels * 3 || pLayer->aAlpha.size() != nPixels)
+        return;
+
+    // Same record and space as shadedFillImpl: a bitmap stretched over a
+    // device-space rectangle. Recorder px -> this device's units.
+    const double k = m_fLayerDevPerPx;
+    const double fX0 = pLayer->nX * k;
+    const double fY0 = pLayer->nY * k;
+    const double fX1 = (pLayer->nX + pLayer->nW) * k;
+    const double fY1 = (pLayer->nY + pLayer->nH) * k;
+
+    // MemStream does not write through its buffer; the store is read-only here.
+    char* pRgb = const_cast<char*>(reinterpret_cast<const char*>(pLayer->aRGB.data()));
+    char* pAlpha = const_cast<char*>(reinterpret_cast<const char*>(pLayer->aAlpha.data()));
+#if POPPLER_CHECK_VERSION(25, 5, 0)
+    std::unique_ptr<MemStream> pRgbStr(new MemStream(pRgb, 0, nPixels * 3, Object::null()));
+    std::unique_ptr<MemStream> pAlphaStr(new MemStream(pAlpha, 0, nPixels, Object::null()));
+    auto aDecode = Object::null();
+#else
+    std::unique_ptr<MemStream> pRgbStr(new MemStream(pRgb, 0, nPixels * 3, Object(objNull)));
+    std::unique_ptr<MemStream> pAlphaStr(new MemStream(pAlpha, 0, nPixels, Object(objNull)));
+    auto aDecode = Object(objNull);
+#endif
+#if POPPLER_CHECK_VERSION(24, 10, 0)
+    std::unique_ptr<GfxImageColorMap> pRgbIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        std::make_unique<GfxDeviceRGBColorSpace>()));
+    std::unique_ptr<GfxImageColorMap> pGrayIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        std::make_unique<GfxDeviceGrayColorSpace>()));
+#else
+    std::unique_ptr<GfxImageColorMap> pRgbIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        new GfxDeviceRGBColorSpace()));
+    std::unique_ptr<GfxImageColorMap> pGrayIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        new GfxDeviceGrayColorSpace()));
+#endif
+
+    // Splash applied the fill/stroke opacity (/ca, /CA) per operation while
+    // recording, and it may change within the span, so the layer already
+    // carries it. The LibreOffice side would apply the current fill alpha to
+    // the bitmap-filled polygon as well (draw:opacity): emit the layer at
+    // alpha 1 and restore the colour record afterwards.
+    const bool bAlpha = state && state->getFillOpacity() != 1.0;
+    GfxRGB aRGB = { 0, 0, 0 };
+    if (bAlpha)
+    {
+        state->getFillRGB( &aRGB );
+        printf( "updateFillColor %f %f %f %f\n",
+                normalize(colToDbl(aRGB.r)), normalize(colToDbl(aRGB.g)),
+                normalize(colToDbl(aRGB.b)), 1.0 );
+    }
+
+    printf( "shadedFill %f %f %f %f",
+            normalize(fX0), normalize(fY0), normalize(fX1), normalize(fY1) );
+    OutputBuffer aBuf; initBuf(aBuf);
+    writePng_(aBuf, pRgbStr.get(), pLayer->nW, pLayer->nH, pRgbIdentityColorMap.get(),
+        pAlphaStr.get(), pLayer->nW, pLayer->nH, pGrayIdentityColorMap.get());
+    writeBinaryBuffer(aBuf);
+
+    if (bAlpha)
+        printf( "updateFillColor %f %f %f %f\n",
+                normalize(colToDbl(aRGB.r)), normalize(colToDbl(aRGB.g)),
+                normalize(colToDbl(aRGB.b)), normalize(state->getFillOpacity()) );
+    ++m_nLayersEmitted;
+    beat();
+}
+
+// FG-175: an inline image whose data nobody read. Gfx::opBeginImage then
+// scans the undecoded stream for "EI" from wherever the stream was left, so
+// skip over the data exactly as Gfx's own disabled-drawing branch does.
+static void lcl_drainInlineImage( Stream* str, int width, int height, int nComps, int nBits )
+{
+    if (!str || width <= 0 || height <= 0)
+        return;
+    if (!str->reset())
+        return;
+    const long long n = static_cast<long long>(height) * ((static_cast<long long>(width) * nComps * nBits + 7) / 8);
+    for (long long i = 0; i < n; ++i)
+        str->getChar();
+    str->close();
 }
 
