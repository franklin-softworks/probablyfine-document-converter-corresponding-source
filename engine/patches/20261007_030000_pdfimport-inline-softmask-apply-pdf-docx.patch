+    /// A SplashOutputDev that paints only soft-masked content and cuts it
+    /// into one RGBA layer per span.
+    class MaskLayerRecorder : public SplashOutputDev
+    {
+    public:
+        MaskLayerRecorder( SoftMaskLayerStore& rStore, const std::function<void()>& rBeat )
+            : SplashOutputDev( splashModeRGB8, 1 /* rowPad */, false /* reverseVideo */, nullptr /* paper */ )
+            , m_rStore( rStore )
+            , m_rBeat( rBeat )
+        {
+            setEnableFreeType( false ); // the bundled poppler has no FreeType
+            setVectorAntialias( true );
+        }
+
+        int spanCount() const { return m_aSpans.spanCount(); }
+
+        //----- capability answers mirror PDFOutDev so that Gfx issues the
+        //      same hook sequence (and therefore the same spans) to both.
+        bool interpretType3Chars() override { return false; }
+        bool useShadedFills( int type ) override { return type >= 1 && type <= 7; }
+        bool needNonText() override { return true; }
+        bool useDrawChar() override { return true; }
+        bool useTilingPatternFill() override { return true; }
+        // Gfx::doForm draws a /Group form as a transparency group only if
+        // the device says so. OutputDev's default (PDFOutDev) is "always";
+        // Splash declines plain groups (opacity 1, Normal, no mask) as an
+        // optimisation, which would silently drop three tracked hooks per
+        // form on this side only (fahr page 14: 2,971 forms, 8,913 hooks).
+        bool checkTransparencyGroup( GfxState*, bool ) override { return true; }
+
+        //----- page / state
+        void startPage( int pageNum, GfxState* state, XRef* xref ) override
+        {
+            SplashOutputDev::startPage( pageNum, state, xref );
+            m_aSpans.reset();
+            m_aOffsets.clear();
+            m_nOffX = m_nOffY = 0;
+            m_rStore.nPageW = getBitmapWidth();
+            m_rStore.nPageH = getBitmapHeight();
+        }
+
+        void endPage() override
+        {
+            apply( m_aSpans.endPage() );
+            SplashOutputDev::endPage();
+        }
+
+        void saveState( GfxState* state ) override
+        {
+            SplashOutputDev::saveState( state );
+            if (trackerActive())
+                m_aSpans.saveState();
+        }
+
+        void restoreState( GfxState* state ) override
+        {
+            const Transition aT = trackerActive() ? m_aSpans.restoreState() : Transition();
+            onEnd( aT );
+            SplashOutputDev::restoreState( state );
+            onBegin( aT );
+        }
+
+        //----- soft masks
+        void setSoftMask( GfxState* state, const std::array<double, 4>& bbox, bool alpha,
+                          Function* transferFunc, GfxColor* backdropColor ) override
+        {
+            const Transition aT = trackerActive() ? m_aSpans.setSoftMask() : Transition();
+            onEnd( aT );
+            tick( true );
+            SplashOutputDev::setSoftMask( state, bbox, alpha, transferFunc, backdropColor );
+            onBegin( aT );
+        }
+
+        void clearSoftMask( GfxState* state ) override
+        {
+            if (trackerActive())
+                apply( m_aSpans.clearSoftMask() );
+            SplashOutputDev::clearSoftMask( state );
+        }
+
+        // A pattern-filled stencil mask (Gfx::doPatternImageMask): Splash
+        // keeps a private transparency group open from set... to unset...,
+        // and the pattern fill in between issues tracked hooks
+        // (doTilingPatternFill's saveStateStack/restoreStateStack, per-tile
+        // forms) while getBitmap() is that private group. The tracker is
+        // PAUSED from set to unset on BOTH devices (PDFOutDev does the same),
+        // so no span ends or begins in there and no cut/clear touches the
+        // private group; Gfx's own saveState/restoreState around the pair
+        // keep the levels balanced. The group-offset bookkeeping in the
+        // group overrides stays symmetric.
+        void setSoftMaskFromImageMask( GfxState* state, Object* ref, Stream* str, int width, int height,
+                                       bool invert, bool inlineImg, double* baseMatrix ) override
+        {
+            ++m_nSplashInternalGroups; // paused until unsetSoftMaskFromImageMask
+            SplashOutputDev::setSoftMaskFromImageMask( state, ref, str, width, height, invert, inlineImg, baseMatrix );
+        }
+        void unsetSoftMaskFromImageMask( GfxState* state, double* baseMatrix ) override
+        {
+            SplashOutputDev::unsetSoftMaskFromImageMask( state, baseMatrix );
+            if (m_nSplashInternalGroups > 0)
+                --m_nSplashInternalGroups;
+        }
+
+        //----- transparency groups. Splash shifts the GfxState CTM by the
+        //      group origin (shiftCTMAndClip); the shift is read back from
+        //      the CTM so that layers cut from a group bitmap land in page px.
+        void beginTransparencyGroup( GfxState* state, const std::array<double, 4>& bbox,
+                                     GfxColorSpace* blendingColorSpace, bool isolated,
+                                     bool knockout, bool forSoftMask ) override
+        {
+            if (trackerActive())
+                apply( m_aSpans.beginGroup( forSoftMask ) );
+            const double* pBefore = state->getCTM();
+            const double fX = pBefore[4], fY = pBefore[5];
+            SplashOutputDev::beginTransparencyGroup( state, bbox, blendingColorSpace,
+                                                     isolated, knockout, forSoftMask );
+            const double* pAfter = state->getCTM();
+            const int nTx = static_cast<int>( std::lround( fX - pAfter[4] ) );
+            const int nTy = static_cast<int>( std::lround( fY - pAfter[5] ) );
+            m_aOffsets.push_back( std::make_pair( nTx, nTy ) );
+            m_nOffX += nTx;
+            m_nOffY += nTy;
+        }
+
+        void endTransparencyGroup( GfxState* state ) override
+        {
+            // A span still open here was set inside the group: cut its layer
+            // from the group bitmap before Splash discards it.
+            if (trackerActive())
+                apply( m_aSpans.endGroup() );
+            SplashOutputDev::endTransparencyGroup( state );
+            if (!m_aOffsets.empty())
+            {
+                m_nOffX -= m_aOffsets.back().first;
+                m_nOffY -= m_aOffsets.back().second;
+                m_aOffsets.pop_back();
+            }
+        }
+
+        //----- painting: only what a soft mask will apply to. Unmasked
+        //      content is PDFOutDev's business and is skipped here
+        //      (image streams are left unread).
+        void stroke( GfxState* state ) override
+        {
+            if (paintAllowed()) { tick(); SplashOutputDev::stroke( state ); }
+        }
+        void fill( GfxState* state ) override
+        {
+            if (paintAllowed()) { tick(); SplashOutputDev::fill( state ); }
+        }
+        void eoFill( GfxState* state ) override
+        {
+            if (paintAllowed()) { tick(); SplashOutputDev::eoFill( state ); }
+        }
+
+        // Text is exempt: it stays text in PDFOutDev (editable), and Splash
+        // has no glyph rasterizer in this build anyway.
+        void drawChar( GfxState*, double, double, double, double, double, double,
+                       CharCode, int, const Unicode*, int ) override {}
+
+        void drawImageMask( GfxState* state, Object* ref, Stream* str, int width, int height,
+                            bool invert, bool interpolate, bool inlineImg ) override
+        {
+            if (paintAllowed())
+            {
+                tick();
+                SplashOutputDev::drawImageMask( state, ref, str, width, height, invert, interpolate, inlineImg );
+            }
+            else if (inlineImg)
+                lcl_drainInlineImage( str, width, height, 1, 1 );
+        }
+        void drawImage( GfxState* state, Object* ref, Stream* str, int width, int height,
+                        GfxImageColorMap* colorMap, bool interpolate, const int* maskColors,
+                        bool inlineImg ) override
+        {
+            if (paintAllowed())
+            {
+                tick();
+                SplashOutputDev::drawImage( state, ref, str, width, height, colorMap, interpolate, maskColors, inlineImg );
+            }
+            else if (inlineImg && colorMap)
+                lcl_drainInlineImage( str, width, height, colorMap->getNumPixelComps(), colorMap->getBits() );
+        }
+        void drawMaskedImage( GfxState* state, Object* ref, Stream* str, int width, int height,
+                              GfxImageColorMap* colorMap, bool interpolate, Stream* maskStr,
+                              int maskWidth, int maskHeight, bool maskInvert, bool maskInterpolate ) override
+        {
+            if (paintAllowed())
+            {
+                tick();
+                SplashOutputDev::drawMaskedImage( state, ref, str, width, height, colorMap, interpolate,
+                                                  maskStr, maskWidth, maskHeight, maskInvert, maskInterpolate );
+            }
+        }
+        void drawSoftMaskedImage( GfxState* state, Object* ref, Stream* str, int width, int height,
+                                  GfxImageColorMap* colorMap, bool interpolate, Stream* maskStr,
+                                  int maskWidth, int maskHeight, GfxImageColorMap* maskColorMap,
+                                  bool maskInterpolate ) override
+        {
+            if (paintAllowed())
+            {
+                tick();
+                SplashOutputDev::drawSoftMaskedImage( state, ref, str, width, height, colorMap, interpolate,
+                                                      maskStr, maskWidth, maskHeight, maskColorMap, maskInterpolate );
+            }
+        }
+
+        bool tilingPatternFill( GfxState* state, Gfx* gfx, Catalog* cat, GfxTilingPattern* tPat,
+                                const std::array<double, 6>& mat, int x0, int y0, int x1, int y1,
+                                double xStep, double yStep ) override
+        {
+            const std::array<double, 4>& rBBox = tPat->getBBox();
+            if (!paintAllowed())
+            {
+                // Not painting: answer exactly as PDFOutDev::tilingPatternFill
+                // does for unmasked content, because a "false" makes Gfx run
+                // the per-tile drawForm fallback, whose save/restore hooks the
+                // tracker counts. PDFOutDev declines gapped patterns only.
+                const bool bGapped = xStep != rBBox[2] - rBBox[0] || yStep != rBBox[3] - rBBox[1];
+                return !bGapped;
+            }
+            tick();
+            // Painting (PDFOutDev is suppressed here and returned true): the
+            // tile must be rendered WITHOUT any tracked hook. Splash renders
+            // it with a nested Gfx on this device; if Splash declines
+            // (gapped, few repeats, odd CTM), run Gfx's own per-tile fallback
+            // here rather than let Gfx run it through the tracker.
+            ++m_nNestedRender;
+            try
+            {
+                const bool bDone = SplashOutputDev::tilingPatternFill( state, gfx, cat, tPat, mat,
+                                                                       x0, y0, x1, y1, xStep, yStep );
+                if (!bDone && !gfx)
+                    fail( "tile fallback without a Gfx" ); // nothing painted: page falls back
+                else if (!bDone)
+                {
+                    // Mirror of the fallback in Gfx::doTilingPatternFill.
+                    updatePatternOpacity( state );
+                    std::array<double, 6> aM1 = mat;
+                    for (int yi = y0; yi < y1; ++yi)
+                    {
+                        for (int xi = x0; xi < x1; ++xi)
+                        {
+                            const double x = xi * xStep;
+                            const double y = yi * yStep;
+                            aM1[4] = x * mat[0] + y * mat[2] + mat[4];
+                            aM1[5] = x * mat[1] + y * mat[3] + mat[5];
+                            gfx->drawForm( tPat->getContentStream(), tPat->getResDict(), aM1, rBBox );
+                        }
+                        tick();
+                    }
+                    clearPatternOpacity( state );
+                }
+            }
+            catch (...)
+            {
+                --m_nNestedRender;
+                throw;
+            }
+            --m_nNestedRender;
+            return true;
+        }
+        bool functionShadedFill( GfxState* state, GfxFunctionShading* shading ) override
+        {
+            if (!paintAllowed()) return true;
+            tick();
+            return SplashOutputDev::functionShadedFill( state, shading );
+        }
+        bool axialShadedFill( GfxState* state, GfxAxialShading* shading, double tMin, double tMax ) override
+        {
+            if (!paintAllowed()) return true;
+            tick();
+            return SplashOutputDev::axialShadedFill( state, shading, tMin, tMax );
+        }
+        bool radialShadedFill( GfxState* state, GfxRadialShading* shading, double tMin, double tMax ) override
+        {
+            if (!paintAllowed()) return true;
+            tick();
+            return SplashOutputDev::radialShadedFill( state, shading, tMin, tMax );
+        }
+        bool gouraudTriangleShadedFill( GfxState* state, GfxGouraudTriangleShading* shading ) override
+        {
+            if (!paintAllowed()) return true;
+            tick();
+            return SplashOutputDev::gouraudTriangleShadedFill( state, shading );
+        }
+        // patchMeshShadedFill: OutputDev's default (false) lets Gfx subdivide
+        // the mesh into fills, which fill() above gates.
+
+    private:
+        bool paintAllowed() const
+        {
+            if (m_nNestedRender > 0)
+                return true; // inside a tile Splash is rendering for an allowed fill
+            return m_aSpans.softMaskDepth() > 0 || m_aSpans.effectivelyMasked();
+        }
+
+        /// False while Splash drives hooks PDFOutDev will never see.
+        bool trackerActive() const
+        {
+            return m_nSplashInternalGroups == 0 && m_nNestedRender == 0;
+        }
+
+        void tick( bool bForce = false )
+        {
+            if (m_rBeat && (bForce || (++m_nTicks & 63) == 0))
+                m_rBeat();
+        }
+
+        void apply( const Transition& rT )
+        {
+            onEnd( rT );
+            onBegin( rT );
+        }
+
+        void onBegin( const Transition& rT )
+        {
+            if (rT.nBegan < 0 || m_rStore.pFailure)
+                return;
+            if (m_rStore.aLayers.size() <= static_cast<size_t>( rT.nBegan ))
+                m_rStore.aLayers.resize( rT.nBegan + 1 );
+            m_rStore.aLayers[rT.nBegan].bNested = rT.bBeganNested;
+            m_rStore.aLayers[rT.nBegan].aSignature = rT.aBeganSignature;
+            m_rStore.nSpans = m_aSpans.spanCount();
+            if (rT.bBeganNested)
+                return; // painted into the enclosing group / mask; nothing to isolate
+            // Start the span from a transparent bitmap. Everything painted so
+            // far on it belongs to earlier spans, already cut out.
+            Splash* pSplash = getSplash();
+            if (pSplash)
+            {
+                SplashColor aClear = { 0, 0, 0, 0 };
+                pSplash->clear( aClear, 0 );
+            }
+        }
+
+        void onEnd( const Transition& rT )
+        {
+            if (rT.nEnded < 0 || m_rStore.pFailure)
+                return;
+            if (m_rStore.aLayers.size() <= static_cast<size_t>( rT.nEnded ))
+                m_rStore.aLayers.resize( rT.nEnded + 1 );
+            m_rStore.aLayers[rT.nEnded].aEndSignature = rT.aEndedSignature;
+            if (rT.bEndedNested)
+                return;
+            cutLayer( m_rStore.aLayers[rT.nEnded] );
+        }
+
+        /// Crop the current bitmap to its painted pixels and store it as the
+        /// layer, converting the group's colour mode to RGB.
+        void cutLayer( SoftMaskLayer& rLayer )
+        {
+            tick( true );
+            SplashBitmap* pBmp = getBitmap();
+            if (!pBmp || !pBmp->getDataPtr() || !pBmp->getAlphaPtr())
+            {
+                fail( "bitmap without alpha" );
+                return;
+            }
+            const SplashColorMode eMode = pBmp->getMode();
+            int nComps = 0;
+            switch (eMode)
+            {
+                case splashModeMono8:  nComps = 1; break;
+                case splashModeRGB8:   nComps = 3; break;
+                case splashModeBGR8:   nComps = 3; break;
+                case splashModeXBGR8:  nComps = 4; break;
+                case splashModeCMYK8:  nComps = 4; break;
+                default:
+                    fail( "unsupported group colour mode" );
+                    return;
+            }
+            const int nW = pBmp->getWidth();
+            const int nH = pBmp->getHeight();
+            const unsigned char* pAlpha = pBmp->getAlphaPtr();
+            const int nAlphaRow = pBmp->getAlphaRowSize();
+
+            // Bounding box of the painted pixels.
+            int nX0 = nW, nY0 = nH, nX1 = -1, nY1 = -1;
+            for (int y = 0; y < nH; ++y)
+            {
+                const unsigned char* pRow = pAlpha + static_cast<size_t>( y ) * nAlphaRow;
+                int xFirst = -1, xLast = -1;
+                for (int x = 0; x < nW; ++x)
+                {
+                    if (pRow[x])
+                    {
+                        if (xFirst < 0) xFirst = x;
+                        xLast = x;
+                    }
+                }
+                if (xFirst >= 0)
+                {
+                    nX0 = std::min( nX0, xFirst );
+                    nX1 = std::max( nX1, xLast );
+                    nY0 = std::min( nY0, y );
+                    nY1 = y;
+                }
+            }
+            if (nX1 < 0)
+            {
+                rLayer.nW = rLayer.nH = 0; // the mask hid everything
+                return;
+            }
+
+            const int nLW = nX1 - nX0 + 1;
+            const int nLH = nY1 - nY0 + 1;
+            const size_t nBytes = static_cast<size_t>( nLW ) * nLH * 4;
+            if (m_rStore.nBytes + nBytes > kRecorderByteBudget)
+            {
+                fail( "layer byte budget exceeded" );
+                return;
+            }
+
+            rLayer.aRGB.resize( static_cast<size_t>( nLW ) * nLH * 3 );
+            rLayer.aAlpha.resize( static_cast<size_t>( nLW ) * nLH );
+            const unsigned char* pData = pBmp->getDataPtr();
+            const int nRow = pBmp->getRowSize();
+            for (int y = 0; y < nLH; ++y)
+            {
+                const unsigned char* pSrc = pData + static_cast<size_t>( nY0 + y ) * nRow
+                                            + static_cast<size_t>( nX0 ) * nComps;
+                const unsigned char* pSrcA = pAlpha + static_cast<size_t>( nY0 + y ) * nAlphaRow + nX0;
+                unsigned char* pDst = rLayer.aRGB.data() + static_cast<size_t>( y ) * nLW * 3;
+                unsigned char* pDstA = rLayer.aAlpha.data() + static_cast<size_t>( y ) * nLW;
+                for (int x = 0; x < nLW; ++x, pSrc += nComps, pDst += 3)
+                {
+                    switch (eMode)
+                    {
+                        case splashModeMono8:
+                            pDst[0] = pDst[1] = pDst[2] = pSrc[0];
+                            break;
+                        case splashModeRGB8:
+                            pDst[0] = pSrc[0]; pDst[1] = pSrc[1]; pDst[2] = pSrc[2];
+                            break;
+                        case splashModeBGR8:
+                            pDst[0] = pSrc[2]; pDst[1] = pSrc[1]; pDst[2] = pSrc[0];
+                            break;
+                        case splashModeXBGR8:
+                            pDst[0] = pSrc[2]; pDst[1] = pSrc[1]; pDst[2] = pSrc[0];
+                            break;
+                        case splashModeCMYK8:
+                        {
+                            const int k = pSrc[3];
+                            pDst[0] = static_cast<unsigned char>( 255 - std::min( 255, pSrc[0] + k ) );
+                            pDst[1] = static_cast<unsigned char>( 255 - std::min( 255, pSrc[1] + k ) );
+                            pDst[2] = static_cast<unsigned char>( 255 - std::min( 255, pSrc[2] + k ) );
+                            break;
+                        }
+                        default:
+                            break;
+                    }
+                    pDstA[x] = pSrcA[x];
+                }
+            }
+            // Group bitmaps are offset from the page; translate back.
+            rLayer.nX = nX0 + m_nOffX;
+            rLayer.nY = nY0 + m_nOffY;
+            rLayer.nW = nLW;
+            rLayer.nH = nLH;
+            m_rStore.nBytes += nBytes;
+            ++m_rStore.nLayersWithPixels;
+        }
+
+        void fail( const char* pWhy )
+        {
+            if (!m_rStore.pFailure)
+                m_rStore.pFailure = pWhy;
+        }
+
+        SoftMaskLayerStore&               m_rStore;
+        const std::function<void()>&      m_rBeat;
+        SoftMaskSpanTracker               m_aSpans;
+        std::vector<std::pair<int, int>>  m_aOffsets; ///< per open group: its origin in the parent bitmap
+        int                               m_nOffX = 0; ///< current bitmap origin in page px
+        int                               m_nOffY = 0;
+        unsigned                          m_nTicks = 0;
+        int                               m_nSplashInternalGroups = 0; ///< stencil-mask pattern fill open (set..unset)
+        int                               m_nNestedRender = 0;         ///< inside Splash's tilingPatternFill
+    };
+
+    bool lcl_resourcesDeclareSoftMask( Dict* pRes, int nDepth, std::set<int>& rVisited )
+    {
+        if (!pRes || nDepth > 8)
+            return false;
+
+        Object aExt = pRes->lookup( "ExtGState" );
+        if (aExt.isDict())
+        {
+            Dict* pExt = aExt.getDict();
+            for (int i = 0; i < pExt->getLength(); ++i)
+            {
+                Object aGS = pExt->getVal( i );
+                if (!aGS.isDict())
+                    continue;
+                Object aSMask = aGS.getDict()->lookup( "SMask" );
+                if (aSMask.isDict())
+                    return true;
+            }
+        }
+
+        static const char* const aNested[] = { "XObject", "Pattern" };
+        for (const char* pKey : aNested)
+        {
+            Object aDictObj = pRes->lookup( pKey );
+            if (!aDictObj.isDict())
+                continue;
+            Dict* pDict = aDictObj.getDict();
+            for (int i = 0; i < pDict->getLength(); ++i)
+            {
+                const Object& rRef = pDict->getValNF( i );
+                if (rRef.isRef() && !rVisited.insert( rRef.getRef().num ).second)
+                    continue;
+                Object aVal = pDict->getVal( i );
+                if (!aVal.isStream())
+                    continue;
+                Object aSub = aVal.streamGetDict()->lookup( "Resources" );
+                if (aSub.isDict() && lcl_resourcesDeclareSoftMask( aSub.getDict(), nDepth + 1, rVisited ))
+                    return true;
+            }
+        }
+        return false;
+    }
+}
+
+double chooseSoftMaskRecorderDpi( double fPageWidthPt, double fPageHeightPt )
+{
+    const double fLongest = std::max( std::max( fPageWidthPt, fPageHeightPt ), 1.0 );
+    double fDpi = kRecorderPixelsPerPoint * 72.0;
+    if (fLongest * fDpi / 72.0 > kRecorderMaxSide)
+        fDpi = kRecorderMaxSide * 72.0 / fLongest;
+    if (fDpi < kRecorderMinDpi)
+        fDpi = kRecorderMinDpi;
+    return fDpi;
+}
+
+bool pageDeclaresSoftMask( Page* pPage )
+{
+    if (!pPage)
+        return false;
+    std::set<int> aVisited;
+    return lcl_resourcesDeclareSoftMask( pPage->getResourceDict(), 0, aVisited );
+}
+
+void recordSoftMaskLayers( PDFDoc& rDoc, int nPage, double fDpi,
+                           SoftMaskLayerStore& rStore,
+                           const std::function<void()>& rBeat )
+{
+    rStore.clear();
+    rStore.fDpi = fDpi;
+    try
+    {
+        MaskLayerRecorder aRecorder( rStore, rBeat );
+        aRecorder.startDoc( &rDoc );
+        // Same page geometry as the main pass: rotate 0, media box, cropped.
+        rDoc.displayPage( &aRecorder, nPage, fDpi, fDpi, 0, true, true, true );
+        if (!rStore.pFailure)
+        {
+            rStore.nSpans = aRecorder.spanCount();
+            rStore.aLayers.resize( rStore.nSpans );
+            rStore.bUsable = true;
+        }
+    }
+    catch (...)
+    {
+        rStore.pFailure = "exception in pre-pass";
+    }
+    if (!rStore.bUsable)
+    {
+        rStore.aLayers.clear();
+        rStore.nBytes = 0;
+        if (!rStore.pFailure)
+            rStore.pFailure = "unknown";
+    }
+}
+
+} // namespace pdfi
+
+#endif // PDFI_SOFTMASK_RECORDER
