+    const double kRecorderPixelsPerPoint = 2.0;   ///< ~144 dpi, like the shading rasters
+    const double kRecorderMaxSide        = 4096.0; ///< px; a 4096^2 RGBA page is 64 MB
+    const double kRecorderMinDpi         = 18.0;
+    const size_t kRecorderByteBudget     = static_cast<size_t>(96) << 20; ///< raw layer bytes per page (4 GiB WASM heap shared with LibreOffice)
+
+    typedef SoftMaskSpanTracker::Transition Transition;
+
+    /// Skip an inline image's data the way Gfx's disabled-drawing branch does,
+    /// so Gfx::opBeginImage finds the EI tag where it expects it.
+    void lcl_drainInlineImage( Stream* str, int width, int height, int nComps, int nBits )
+    {
+        if (!str || width <= 0 || height <= 0)
+            return;
+        if (!str->reset())
+            return;
+        const long long n = static_cast<long long>( height )
+                            * ((static_cast<long long>( width ) * nComps * nBits + 7) / 8);
+        for (long long i = 0; i < n; ++i)
+            str->getChar();
+        str->close();
+    }
