+                    {
+                        // Mirrors OutASC_SwTextNode's line-end rule for the anchor
+                        // line: the last node of the range gets one only when empty.
+                        const bool bAnchorLast = m_pCurrentPam->GetPoint()->GetNode()
+                                                 == m_pCurrentPam->GetMark()->GetNode();
+                        bool bNeedLineEnd = bAnchorLast
+                            && !(pNd->GetText().isEmpty() && !m_bWriteClipboardDoc
+                                 && !m_bASCII_NoLastLineEnd);
+                        lcl_WriteAnchoredFlyText(*this, *m_pDoc, *pNd, bIncludeHidden,
+                                                 bNeedLineEnd);
+                    }
+#endif
                 }
