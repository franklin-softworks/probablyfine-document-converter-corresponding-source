@@ -88,6 +88,62 @@ SwASCWriter::SwASCWriter( std::u16string_view rFltNm )
 
 SwASCWriter::~SwASCWriter() {}
 
+#ifdef __EMSCRIPTEN__
+// FG-147: Writer's plain-text export walks only the body text, so the text of
+// text boxes and frames was silently dropped (stock LibreOffice too; only the
+// one-frame clipboard case was written). For a whole-document export, write
+// the text of every frame anchored to a paragraph right after that paragraph,
+// in anchor order; frames nested inside a frame are handled by the recursion.
+// The writer reads its position from m_pCurrentPam, so it is pointed at each
+// frame paragraph in turn and restored afterwards. Each frame paragraph is
+// written as its own one-node range, and OutASC_SwTextNode writes no line end
+// after the last node of a range unless it is empty, so the line end is written
+// here instead (with the writer's own suppression switched on, so an empty
+// paragraph does not get two). bNeedLineEnd: the anchor line was written without
+// its line end (the anchor is the last line), so one goes before the first frame
+// paragraph.
+// Draw shapes without a text frame (no content section) are skipped, as are
+// hidden paragraphs.
+static void lcl_WriteAnchoredFlyText(SwASCWriter& rWrt, SwDoc& rDoc,
+                                     const SwTextNode& rAnchorNd, bool bIncludeHidden,
+                                     bool& bNeedLineEnd, int nDepth = 0)
+{
+    if (nDepth > 8)
+        return;
+    const std::vector<SwFrameFormat*> aFlys = rAnchorNd.GetAnchoredFlys();
+    for (const SwFrameFormat* pFormat : aFlys)
+    {
+        if (!pFormat || pFormat->Which() != RES_FLYFRMFMT)
+            continue;
+        const SwNodeIndex* pIdx = pFormat->GetContent().GetContentIdx();
+        if (!pIdx)
+            continue;
+        const SwNodeOffset nEnd = pIdx->GetNode().EndOfSectionIndex();
+        for (SwNodeOffset n = pIdx->GetIndex() + 1; n < nEnd; ++n)
+        {
+            SwTextNode* pNd = rDoc.GetNodes()[n]->GetTextNode();
+            if (!pNd || (pNd->IsHidden() && !bIncludeHidden))
+                continue;
+            if (bNeedLineEnd)
+            {
+                rWrt.Strm().WriteUnicodeOrByteText(rWrt.GetLineEnd());
+                bNeedLineEnd = false;
+            }
+            auto pSaved = rWrt.m_pCurrentPam;
+            const bool bSavedNoLast = rWrt.m_bASCII_NoLastLineEnd;
+            rWrt.m_bASCII_NoLastLineEnd = true;
+            rWrt.m_pCurrentPam = Writer::NewUnoCursor(rDoc, n, n);
+            rWrt.m_pCurrentPam->Exchange();
+            Out(aASCNodeFnTab, *pNd, rWrt);
+            rWrt.m_pCurrentPam = pSaved;
+            rWrt.m_bASCII_NoLastLineEnd = bSavedNoLast;
+            rWrt.Strm().WriteUnicodeOrByteText(rWrt.GetLineEnd());
+            lcl_WriteAnchoredFlyText(rWrt, rDoc, *pNd, bIncludeHidden, bNeedLineEnd, nDepth + 1);
+        }
+    }
+}
+#endif
+
 ErrCode SwASCWriter::WriteStream()
 {
     static constexpr OUString STR_CR = u"\015"_ustr;
@@ -194,6 +250,20 @@ ErrCode SwASCWriter::WriteStream()
                         WriteTable(pTableNd, pNd);
                     else
                         Out( aASCNodeFnTab, *pNd, *this );
+#ifdef __EMSCRIPTEN__
