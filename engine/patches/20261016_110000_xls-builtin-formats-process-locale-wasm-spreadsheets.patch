+    // meSysLang) fell to the language-neutral default: en-US built-in 14 became
+    // MM/DD/YYYY instead of M/D/YYYY and a date that fits on desktop printed ###.
+    // Use the process locale instead: LANG, which the worker sets from INIT's
+    // formatLocale, and which desktop's VCL language is derived from. Setting
+    // VCL's language itself (Application::SetSettings) traps in this build.
+    meSysLang( MsLangId::getSystemLanguage() ),
+    meDocLang( MsLangId::getSystemLanguage() ),
+#else
     meSysLang( Application::GetSettings().GetLanguageTag().getLanguageType() ),
     meDocLang( Application::GetSettings().GetLanguageTag().getLanguageType() ),
+#endif
     meUILang( Application::GetSettings().GetUILanguageTag().getLanguageType() ),
