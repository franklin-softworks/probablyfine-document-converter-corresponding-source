     meTextEnc( eTextEnc ),
+#ifdef __EMSCRIPTEN__
+    // FG-183: VCL's language is never set in WASM (LibreOfficeKit init skips
+    // setLanguageAndLocale; measured: Application::GetSettings().GetLanguageTag()
