+namespace
+{
+// BUG-94: the subsets of the fonts a document uses are kept in a std::map keyed by the font face's ADDRESS, so iterating it writes the font objects in
+// address order, which is not the same from one run to the next (heap layout): two runs of one conversion gave PDFs that differ only in the order of
+// the font objects. Each face's first subset takes its font id when the face is first used, so that id is the deterministic order (document order of
+// first use); the address is only the tie-break for an entry with no subset.
+template <typename Map, typename FirstId>
+std::vector<const typename Map::value_type*> inFirstUseOrder(const Map& rMap, FirstId firstId)
+{
+    std::vector<const typename Map::value_type*> aOrder;
+    aOrder.reserve(rMap.size());
+    for (const auto& rEntry : rMap)
+        aOrder.push_back(&rEntry);
+    std::stable_sort(aOrder.begin(), aOrder.end(),
+                     [&](const typename Map::value_type* a, const typename Map::value_type* b) { return firstId(*a) < firstId(*b); });
+    return aOrder;
+}
+template <typename Entry>
+sal_Int32 firstSubsetId(const Entry& rEntry)
+{
+    return rEntry.second.m_aSubsets.empty() ? SAL_MAX_INT32 : rEntry.second.m_aSubsets.front().m_nFontID;
+}
+}
