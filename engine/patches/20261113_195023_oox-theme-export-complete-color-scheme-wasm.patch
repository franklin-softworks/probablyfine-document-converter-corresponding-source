+    // BUG-79: Office refuses a theme part whose theme, color scheme or font scheme name is empty, or whose color scheme lacks colors.
     OUString aThemeName = rTheme.GetName();
+    if (aThemeName.isEmpty())
+        aThemeName = u"Office"_ustr;
 
     mpFS->startElementNS(XML_a, XML_theme, FSNS(XML_xmlns, XML_a),
                          mpFilterBase->getNamespaceURL(OOX_NS(dml)), FSNS(XML_xmlns, XML_r),
@@ -57,14 +88,24 @@ void ThemeExport::write(OUString const& rPath, model::Theme const& rTheme)
 
     mpFS->startElementNS(XML_a, XML_themeElements);
 
+    // A theme made without a color set (a null pointer) was dereferenced here: the name came out empty and no color was written.
     const auto& pColorSet = rTheme.getColorSet();
 
-    mpFS->startElementNS(XML_a, XML_clrScheme, XML_name, pColorSet->getName());
-    writeColorSet(rTheme);
+    OUString aColorSchemeName = pColorSet ? pColorSet->getName() : OUString();
+    if (aColorSchemeName.isEmpty())
+        aColorSchemeName = u"Office"_ustr;
+    mpFS->startElementNS(XML_a, XML_clrScheme, XML_name, aColorSchemeName);
+    if (pColorSet)
+        writeColorSet(rTheme);
+    else
+        writeOfficeDefaultColorScheme(mpFS);
     mpFS->endElementNS(XML_a, XML_clrScheme);
 
     model::FontScheme const& rFontScheme = rTheme.getFontScheme();
-    mpFS->startElementNS(XML_a, XML_fontScheme, XML_name, rFontScheme.getName());
+    OUString aFontSchemeName = rFontScheme.getName();
+    if (aFontSchemeName.isEmpty())
+        aFontSchemeName = u"Office"_ustr;
+    mpFS->startElementNS(XML_a, XML_fontScheme, XML_name, aFontSchemeName);
     writeFontScheme(rFontScheme);
     mpFS->endElementNS(XML_a, XML_fontScheme);
 
@@ -284,7 +325,8 @@ void ThemeExport::writeColorSystem(model::ComplexColor const& rComplexColor)
         mpFS->startElementNS(XML_a, XML_sysClr, XML_val, sValue);
         //XML_lastClr
         writeColorTransformations(rComplexColor.getTransformations());
-        mpFS->endElementNS(XML_a, XML_schemeClr);
+        // BUG-86: a sysClr was closed with the schemeClr end tag (malformed XML, which Office refuses)
