+// FG-141 / CB-005: progress heartbeat for the emitting visit.
+//
+// WriterXmlEmitter::visit(DocumentElement) streams the whole document into
+// Writer synchronously (SaxEmitter -> SvXMLImport); for a large PDF that is
+// minutes (vision2030: 596 s) in which nothing reported progress, so the web
+// driver's 45 s no-progress watchdog stopped a conversion that was working.
+//
+// Calling setValue(PageNumber) is not enough. The indicator is the framework
+// StatusIndicator that LoadEnv put into the MediaDescriptor; under LOK it
+// forwards a value only if its percentage is >= the last one forwarded, and
+// the optimizing and style-collecting visitors have already driven it to
+// 100 % (page n of n) before emitting starts. So the emitting visit restarts
+// it (start() resets that high-water mark) with a fixed range and advances it
+// over "work units" (pass 1: one per page-anchored draw element; pass 2: one
+// per child of each page), which is monotonic and stays within the range.
+//
+// File-local state is safe: the emitting visitor is not re-entrant and the
+// WASM build runs it on one thread.
+struct EmitHeartbeat
+{
+    static constexpr sal_Int32 nRange = 10000;
+    sal_Int64 nTotal = 0;
+    sal_Int64 nDone = 0;
+    bool bActive = false; // only between the document visit's start() and its end
+    std::chrono::steady_clock::time_point aStart;
+
+    void beat(const EmitContext& rCtx) const
+    {
+        if (!bActive || !rCtx.xStatusIndicator.is() || nTotal <= 0)
+            return;
+        rCtx.xStatusIndicator->setValue(static_cast<sal_Int32>(
+            std::min(nDone, nTotal) * nRange / nTotal));
+    }
+    long long elapsedMs() const
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now() - aStart).count();
+    }
+};
+EmitHeartbeat g_aEmitBeat;
+constexpr size_t nEmitBeatEvery = 500;
+}
+#endif
