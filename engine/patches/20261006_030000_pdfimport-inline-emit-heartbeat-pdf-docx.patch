+// FG-141 / CB-005: progress heartbeat for the Draw/Impress emitting visit
+// (pdf-pptx). Same reasoning as EmitHeartbeat in writertreevisiting.cxx: the
+// optimizing and style-collecting visitors have already driven the LOK
+// StatusIndicator to 100 %, and it drops any lower value, so the per-page
+// setValue(PageNumber) here was dropped for every page but the last. The
+// visit restarts the indicator and advances it over one work unit per page
+// child. Names differ from the Writer file's so the two can share a
+// translation unit.
+struct DrawEmitHeartbeat
+{
+    static constexpr sal_Int32 nRange = 10000;
+    sal_Int64 nTotal = 0;
+    sal_Int64 nDone = 0;
+    bool bActive = false; // only between the document visit's start() and its end
+    std::chrono::steady_clock::time_point aStart;
+
+    void beat(const EmitContext& rCtx) const
+    {
+        if (!bActive || !rCtx.xStatusIndicator.is() || nTotal <= 0)
+            return;
+        rCtx.xStatusIndicator->setValue(static_cast<sal_Int32>(
+            std::min(nDone, nTotal) * nRange / nTotal));
+    }
+    long long elapsedMs() const
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now() - aStart).count();
+    }
+};
+DrawEmitHeartbeat g_aDrawEmitBeat;
+constexpr size_t nDrawEmitBeatEvery = 500;
+}
