+// digit advance (em) of the Normal font as Excel prints column widths, by the index of aAliases (measured per font and size on the Office reference; every size of a font gave one value
+// that rounds to the printed whole 1/600 inch): 0 arial 1 calibri 2 cambria 3 comic sans ms 4 courier new 5 segoe ui 6 tahoma 7 times new roman 8 trebuchet ms 9 verdana
+const double aDigitAdvanceEm[10] = { 0.5565, 0.5086, 0.5542, 0.6112, 0.6000, 0.5400, 0.5468, 0.5037, 0.5235, 0.6378 };
+
 // printed units of a row whose screen height is nPx pixels (custom rows, taller fonts, wrapped lines)
 int path2Units(int nPx) { return static_cast<int>(std::floor(nPx * 6.059 + 0.15)); }
 
