+double GetExcelColumnDigitTwips(const OUString& rFontName, double fHeightPt)
+{
+    const char* pEnv = std::getenv("LO_WASM_EXCEL_PRINT_ROWS");
+    if (!pEnv || pEnv[0] != '1')
+        return 0.0;
+    int nFont = -1;
+    for (const Alias& rAlias : aAliases)
+        if (rFontName.equalsIgnoreAsciiCaseAscii(rAlias.pName))
+        {
+            nFont = rAlias.nFont;
+            break;
+        }
+    // "Century" is not a row-pitch font (no oracle for its rows) but its columns print like Arial's
+    if (nFont < 0 && rFontName.equalsIgnoreAsciiCaseAscii("century"))
+        nFont = 0;
+    if (nFont < 0 || fHeightPt < 5.75 || fHeightPt > 20.25)
+        return 0.0;
+    // whole 1/600 inch per character; an exact half goes to the even unit (measured: Segoe UI 9 pt, 40.5, prints 40; Segoe UI 11 pt, 49.5, prints 50)
+    const double fUnits = aDigitAdvanceEm[nFont] * fHeightPt * 600.0 / 72.0;
+    const double fFloor = std::floor(fUnits);
+    long nUnits = std::lround(fUnits);
+    if (std::abs(fUnits - fFloor - 0.5) < 1e-6)
+        nUnits = (static_cast<long>(fFloor) % 2 == 0) ? static_cast<long>(fFloor) : static_cast<long>(fFloor) + 1;
+    return nUnits * kTwipsPerUnit;
+}
