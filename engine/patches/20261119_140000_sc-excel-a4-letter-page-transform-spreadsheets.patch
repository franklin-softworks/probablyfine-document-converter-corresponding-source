         rInfos.erase(it);   // once per document: a second call (a second render of the same document) must not apply it again
     }
 }
+
+// ---------------------------------------------------------------------------------------------------------------------------------------------------------
+// A4 -> Letter (see the header). Excel lays an A4-declared sheet out on A4 and scales every A4 page onto the Letter page: along the long axis the A4 page is fitted into
+// Letter's printable length (15.4 pt of it are not printable on the oracle's printer), the short axis is centred, and the page sits 4.2 pt from the leading edge
+// (measured on the oracle, Microsoft Print to PDF at 600 dpi; scale 0.9224 on every page of every file). All lengths here are 1/100 mm.
+bool GetA4LetterPageTransform(ScDocument& rDoc, tools::Long nWidth, tools::Long nHeight, PageTransform& rOut)
+{
+    const char* pEnv = std::getenv("LO_WASM_A4_LETTER_MAPPING");
+    if (!pEnv || pEnv[0] != '1' || !isExcelDocument(rDoc))
+        return false;
+    constexpr tools::Long kA4Short = 20999, kA4Long = 29700, kLetterShort = 21590, kLetterLong = 27940;
+    constexpr double kUnprintableLong = 15.4 * 2540.0 / 72.0;     // 15.4 pt
+    constexpr double kLeadingOffset = 4.2 * 2540.0 / 72.0;        // 4.2 pt
+    const bool bLandscape = nWidth > nHeight;
+    const tools::Long nLong = bLandscape ? nWidth : nHeight, nShort = bLandscape ? nHeight : nWidth;
+    if (std::abs(nLong - kA4Long) > 30 || std::abs(nShort - kA4Short) > 30)
+        return false;   // not an A4 page: Letter, Legal and the rest are not touched
+    const double fScale = (kLetterLong - kUnprintableLong) / kA4Long;
+    const double fShortOffset = (kLetterShort - fScale * kA4Short) / 2.0;
+    rOut.fScale = fScale;
+    rOut.fOffsetX = bLandscape ? kLeadingOffset : fShortOffset;
+    rOut.fOffsetY = bLandscape ? fShortOffset : kLeadingOffset;
+    rOut.nContentWidth = nWidth;
+    rOut.nContentHeight = nHeight;
+    rOut.nPageWidth = bLandscape ? kLetterLong : kLetterShort;
+    rOut.nPageHeight = bLandscape ? kLetterShort : kLetterLong;
+    return true;
+}
 }
 
