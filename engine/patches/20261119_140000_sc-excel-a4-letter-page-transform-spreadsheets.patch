+void PDFWriterImpl::setPageTransform( double fScale, double fOffsetX, double fOffsetY )
+{
+    if( m_aPages.empty() || m_aPages.back().m_bPageTransform )
+        return;   // once per page, right after newPage
+    if( fScale == 1.0 && fOffsetX == 0.0 && fOffsetY == 0.0 )
+        return;
+    PDFPage& rPage = m_aPages.back();
+    const double fPt = 72.0 / 2540.0;                               // 1/100 mm -> points
+    const double fOffsetXPt = fOffsetX * fPt, fOffsetYPt = fOffsetY * fPt;
+    rPage.m_bPageTransform = true;
+    rPage.m_fPageScale = fScale;
+    rPage.m_fPageOffsetXPx = fOffsetXPt * fDivisor;
+    // the rectangles convertRect produces are in PDF user space (y up, from the bottom of the page): the same map as the matrix below, y' = s*y + H*(1-s) - oy
+    rPage.m_fPageOffsetYPx = ( rPage.m_nPageHeight * ( 1.0 - fScale ) - fOffsetYPt ) * fDivisor;
+    // user space is y-up: a point at top-down y of the laid-out page goes to  oy + s*y  from the top of THIS page
+    OStringBuffer aBuf( 128 );
+    aBuf.append( "q " );
+    appendDouble( fScale, aBuf, 8 );  aBuf.append( " 0 0 " );
+    appendDouble( fScale, aBuf, 8 );  aBuf.append( ' ' );
+    appendDouble( fOffsetXPt, aBuf, 4 );  aBuf.append( ' ' );
+    appendDouble( rPage.m_nPageHeight * ( 1.0 - fScale ) - fOffsetYPt, aBuf, 4 );
+    aBuf.append( " cm\n" );
+    writeBuffer( aBuf );
+}
