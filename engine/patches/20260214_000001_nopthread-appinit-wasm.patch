Guard pthread proxy calls for non-pthread WASM builds

When building without -pthread, emscripten_sync_run_in_main_runtime_thread
and emscripten_async_run_in_main_runtime_thread are not available. Guard
these calls with __EMSCRIPTEN_PTHREADS__ and call the functions directly
in single-threaded builds (the worker IS the main runtime thread).

Affects: desktop/source/app/appinit.cxx (initUno)
         shell/source/unix/exec/shellexec.cxx (execute)

diff --git a/desktop/source/app/appinit.cxx b/desktop/source/app/appinit.cxx
--- a/desktop/source/app/appinit.cxx
+++ b/desktop/source/app/appinit.cxx
@@ -142,10 +142,18 @@ extern "C" void resolveUnoMain(pthread_t id) {
 void initUno() {
     init_unoembind_uno();
     std::vector<std::u16string> urls;
+#if __EMSCRIPTEN_PTHREADS__
     emscripten_sync_run_in_main_runtime_thread(EM_FUNC_SIG_VI, getUnoScriptUrls, &urls);
+#else
+    getUnoScriptUrls(&urls);
+#endif
     runUnoScriptUrls(emscripten::val::array(urls).as_handle());
     setupMainChannel();
+#if __EMSCRIPTEN_PTHREADS__
     emscripten_async_run_in_main_runtime_thread(EM_FUNC_SIG_VI, resolveUnoMain, pthread_self());
+#else
+    resolveUnoMain(0);
+#endif
 }

 }
diff --git a/shell/source/unix/exec/shellexec.cxx b/shell/source/unix/exec/shellexec.cxx
--- a/shell/source/unix/exec/shellexec.cxx
+++ b/shell/source/unix/exec/shellexec.cxx
@@ -280,8 +280,12 @@ void SAL_CALL ShellExec::execute( const OUString& aCommand, const OUString& aPar

     OUString sEscapedURI(rtl::Uri::encode(aCommand, rtl_UriCharClassUric,
                                           rtl_UriEncodeIgnoreEscapes, RTL_TEXTENCODING_UTF8));
+#if __EMSCRIPTEN_PTHREADS__
     emscripten_sync_run_in_main_runtime_thread(
         EM_FUNC_SIG_VI, execute_browser, sEscapedURI.toUtf8().getStr());
+#else
+    execute_browser(sEscapedURI.toUtf8().getStr());
+#endif
 #endif
 }

