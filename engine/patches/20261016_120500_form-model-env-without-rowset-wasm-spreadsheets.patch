+#ifdef __EMSCRIPTEN__
+namespace
+{
+    // FG-165: in the WASM `spreadsheets` module a form has no row set (dbaccess is
+    // not built), so the row-set properties Command and CommandType do not exist
+    // and getPropertyValue throws UnknownPropertyException. ensureModelEnv
+    // compares forms by (Command, CommandType, DataSourceName); with every read
+    // throwing, no form ever equalled even itself, the sibling search ran past
+    // the end of the container, and getByIndex threw IndexOutOfBoundsException
+    // (empty message). That failed the whole load of an .xls with a button
+    // control. A missing property reads as void here, as an unset one would,
+    // so a form compares equal to itself again.
+    Any lcl_getDSSProperty( const Reference< XPropertySet >& _rxForm, const OUString& _rName )
+    {
+        try
+        {
+            return _rxForm->getPropertyValue( _rName );
+        }
+        catch( const UnknownPropertyException& )
+        {
+            return Any();
+        }
+    }
+
+    bool lcl_equalDSS( const Reference< XPropertySet >& _rxForm, const Any& _rCommand, const Any& _rCommandType, const Any& _rDataSource )
+    {
+        return lcl_getDSSProperty( _rxForm, FM_PROP_COMMAND ) == _rCommand
+            && lcl_getDSSProperty( _rxForm, FM_PROP_COMMANDTYPE ) == _rCommandType
+            && lcl_getDSSProperty( _rxForm, FM_PROP_DATASOURCE ) == _rDataSource;
+    }
+}
+#endif
