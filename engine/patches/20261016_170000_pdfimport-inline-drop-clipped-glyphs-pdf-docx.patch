+namespace
+{
+    // FG-157: an empty intersection means NOTHING is visible, but every reader
+    // of GraphicsContext::Clip here takes an empty B2DPolyPolygon to mean "no
+    // clip", and so does the next intersect (`if( aCurClip.count() )`), which
+    // then adopted the new path unclipped. StarOffice 9 clips each page to the
+    // page and then to an object's own (off-page) area; the empty intersection
+    // turned into "the off-page area is visible", and that text came back.
+    // Keep the state instead: a closed one-point polygon far off any page. It is
+    // non-empty, so the next intersection stays empty; it has no area, so paths
+    // and shadings clip to nothing; and no glyph origin lies near it.
+    void lcl_keepEmptyClip(basegfx::B2DPolyPolygon& rClip)
+    {
+        if (rClip.count())
+            return;
+        basegfx::B2DPolygon aNowhere;
+        aNowhere.append(basegfx::B2DPoint(-1.0e7, -1.0e7));
+        aNowhere.setClosed(true);
+        rClip = basegfx::B2DPolyPolygon(aNowhere);
+    }
