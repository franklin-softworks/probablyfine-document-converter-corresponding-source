+void PDFIProcessor::noteHiddenLine(bool bDropped)
+{
+    constexpr size_t MAX_REPORT_PAGES = 200;   // the report, and so the notice, lists at most this many pages; the totals are exact
+    ++m_nHiddenLines;
+    if (m_nLastHiddenPage != m_nPageNo)
+    {
+        m_nLastHiddenPage = m_nPageNo;
+        ++m_nHiddenPagesTotal;
+        if (m_aHiddenPages.size() < MAX_REPORT_PAGES)
+            m_aHiddenPages.emplace_back(m_nPageNo, 1);
+    }
+    else if (!m_aHiddenPages.empty() && m_aHiddenPages.back().first == m_nPageNo)
+        ++m_aHiddenPages.back().second;
+    if (bDropped)
+        ++m_nHiddenDropped;
+    m_bHiddenDirty = true;
+}
+
+void PDFIProcessor::noteUndecidedPage()
+{
+    if (!m_bReportHidden || m_nLastUndecided == m_nPageNo)
+        return;
+    constexpr size_t MAX_REPORT_PAGES = 200;   // as in noteHiddenLine
+    m_nLastUndecided = m_nPageNo;
+    ++m_nUndecidedTotal;
+    if (m_aUndecidedPages.size() < MAX_REPORT_PAGES)
+        m_aUndecidedPages.push_back(m_nPageNo);
+    m_bHiddenDirty = true;
+}
+
+// the counts the worker reads after the conversion: {"lines":N,"dropped":D,"pagesTotal":T,"pages":[[page,lines],...],"undecidedTotal":U,"undecided":[page,...]}; written once, at the end of the
+// last page (so the cost does not grow with the number of covered lines: an OCR'd scan, a text layer under a page image, covers EVERY line of every page)
+void PDFIProcessor::writeHiddenTextReport() const
+{
+    std::ofstream aOut("/tmp/lo_pdf_hidden_text.json", std::ios::trunc);
+    if (!aOut)
+        return;
+    aOut << "{\"lines\":" << m_nHiddenLines << ",\"dropped\":" << m_nHiddenDropped << ",\"pagesTotal\":" << m_nHiddenPagesTotal << ",\"pages\":[";
+    for (size_t i = 0; i < m_aHiddenPages.size(); ++i)
+        aOut << (i ? "," : "") << "[" << m_aHiddenPages[i].first << "," << m_aHiddenPages[i].second << "]";
+    aOut << "],\"undecidedTotal\":" << m_nUndecidedTotal << ",\"undecided\":[";
+    for (size_t i = 0; i < m_aUndecidedPages.size(); ++i)
+        aOut << (i ? "," : "") << m_aUndecidedPages[i];
+    aOut << "]}";
 }
 #endif
 
