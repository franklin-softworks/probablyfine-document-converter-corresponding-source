+                m_nBeatPage, nOrdinal, pLayer ? "began elsewhere in the recorder" : "has no recorded layer",
+                m_pLayers->nBlendGroups,
+                aNow.nHooks, pLayer ? pLayer->aSignature.nHooks : -1L,
+                aNow.nLevels, pLayer ? pLayer->aSignature.nLevels : -1,
+                aNow.nGroups, pLayer ? pLayer->aSignature.nGroups : -1);
