+int PDFOutDev::fillLuminance( const GfxState* state )
+{
+    GfxRGB aRGB = { 0, 0, 0 };
+    if (state)
+        const_cast<GfxState*>(state)->getFillRGB( &aRGB );
+    const int r = colToByte(aRGB.r), g = colToByte(aRGB.g), b = colToByte(aRGB.b);
+    return (54 * r + 183 * g + 18 * b + 127) / 255;
+}
