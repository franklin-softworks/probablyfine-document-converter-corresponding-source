+    const size_t nPixels = static_cast<size_t>(rLayer.nW) * rLayer.nH;
+    if (rLayer.aAlpha.size() != nPixels)
+        return;
+    // The group's own /ca, and every /ca inside it, is in the layer: Splash
+    // applied them while compositing. What the LibreOffice side must still
+    // apply (draw:opacity, from the fill colour record) is the ENCLOSING
+    // groups' alpha, so set the record to that for this one shape. Gfx has
+    // reset the state's own opacity to 1 for the group's content; restore
+    // the record the way updateFillColor would write it now.
+    GfxRGB aRGB = { 0, 0, 0 };
+    state->getFillRGB( &aRGB );
+    printf( "updateFillColor %f %f %f %f\n",
+            normalize(colToDbl(aRGB.r)), normalize(colToDbl(aRGB.g)),
+            normalize(colToDbl(aRGB.b)), normalize(fEnclosingAlpha) );
+    emitLayerBitmap(nullptr /* black */, rLayer.aAlpha.data(), rLayer.nW, rLayer.nH,
+                    rLayer.nX, rLayer.nY, rLayer.nRectW, rLayer.nRectH);
+    printf( "updateFillColor %f %f %f %f\n",
+            normalize(colToDbl(aRGB.r)), normalize(colToDbl(aRGB.g)),
+            normalize(colToDbl(aRGB.b)), normalize(state->getFillOpacity() * m_fGroupAlpha) );
+    ++m_nBlendLayersEmitted;
     beat();
 }
