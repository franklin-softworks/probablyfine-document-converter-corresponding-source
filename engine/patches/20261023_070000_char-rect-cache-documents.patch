diff --git a/sw/source/core/layout/anchoredobject.cxx b/sw/source/core/layout/anchoredobject.cxx
--- a/sw/source/core/layout/anchoredobject.cxx
+++ b/sw/source/core/layout/anchoredobject.cxx
@@ -35,6 +35,104 @@
 
 using namespace ::com::sun::star;
 
+namespace
+{
+// After a text frame is formatted, SwContentNotify re-checks every object anchored at its
+// characters, and objects at one position ask GetAutoPos/GetTopOfLine the same question of the
+// same frame: on round-trip documents with thousands of anchors in one paragraph that is n
+// identical lookups per format. The last answer of each lookup is kept, keyed like the
+// per-object cache (the frame, its globally unique format generation, its frame and print
+// areas, whether it is a follow, its upper's areas, the position), and used only while the
+// frame and its upper are valid and the frame has its portion or is empty (then the lookups
+// only read).
+struct CharFrameQuery
+{
+    const SwTextFrame* pFrame = nullptr;
+    sal_uInt64 nGeneration = 0;
+    SwRect aFrameArea, aPrtArea, aUpperFrameArea, aUpperPrtArea;
+    bool bFollow = false;
+    SwNodeOffset nNode;
+    const SwNode* pNode = nullptr;
+    sal_Int32 nContent = -1;
+    bool bResult = false;
+};
+
+bool lcl_IsQueryCacheable(const SwTextFrame& rFrame)
+{
+    const SwFrame* pUpper = rFrame.GetUpper();
+    return pUpper && rFrame.isFrameAreaDefinitionValid() && pUpper->isFrameAreaDefinitionValid()
+           && (rFrame.HasPara() || rFrame.IsEmpty());
+}
+
+bool lcl_IsSameQuery(const CharFrameQuery& rQuery, const SwTextFrame& rFrame, const SwPosition& rPos)
+{
+    const SwFrame* pUpper = rFrame.GetUpper();
+    return rQuery.pFrame == &rFrame && rQuery.nGeneration == rFrame.GetFormatGeneration()
+           && rQuery.aFrameArea == rFrame.getFrameArea() && rQuery.aPrtArea == rFrame.getFramePrintArea()
+           && rQuery.aUpperFrameArea == pUpper->getFrameArea() && rQuery.aUpperPrtArea == pUpper->getFramePrintArea()
+           && rQuery.bFollow == rFrame.IsFollow() && rQuery.nNode == rPos.GetNodeIndex()
+           && rQuery.pNode == &rPos.GetNode()
+           && rQuery.nContent == rPos.GetContentIndex();
+}
+
+void lcl_SetQuery(CharFrameQuery& rQuery, const SwTextFrame& rFrame, const SwPosition& rPos, bool bResult)
+{
+    const SwFrame* pUpper = rFrame.GetUpper();
+    rQuery.pFrame = &rFrame;
+    rQuery.nGeneration = rFrame.GetFormatGeneration();
+    rQuery.aFrameArea = rFrame.getFrameArea();
+    rQuery.aPrtArea = rFrame.getFramePrintArea();
+    rQuery.aUpperFrameArea = pUpper->getFrameArea();
+    rQuery.aUpperPrtArea = pUpper->getFramePrintArea();
+    rQuery.bFollow = rFrame.IsFollow();
+    rQuery.nNode = rPos.GetNodeIndex();
+    rQuery.pNode = &rPos.GetNode();
+    rQuery.nContent = rPos.GetContentIndex();
+    rQuery.bResult = bResult;
+}
+
+CharFrameQuery g_aAutoPosQuery;
+SwRect g_aAutoPosRect;
+CharFrameQuery g_aTopOfLineQuery;
+SwTwips g_nTopOfLine = 0;
+
+bool lcl_GetAutoPos(const SwTextFrame& rFrame, SwRect& rRect, const SwPosition& rPos)
+{
+    if (lcl_IsQueryCacheable(rFrame) && lcl_IsSameQuery(g_aAutoPosQuery, rFrame, rPos))
+    {
+        rRect = g_aAutoPosRect;
+        return g_aAutoPosQuery.bResult;
+    }
+    const bool bResult = rFrame.GetAutoPos(rRect, rPos);
+    if (lcl_IsQueryCacheable(rFrame))
+    {
+        lcl_SetQuery(g_aAutoPosQuery, rFrame, rPos, bResult);
+        g_aAutoPosRect = rRect;
+    }
+    else
+        g_aAutoPosQuery.pFrame = nullptr;
+    return bResult;
+}
+
+bool lcl_GetTopOfLine(const SwTextFrame& rFrame, SwTwips& rTop, const SwPosition& rPos)
+{
+    if (lcl_IsQueryCacheable(rFrame) && lcl_IsSameQuery(g_aTopOfLineQuery, rFrame, rPos))
+    {
+        rTop = g_nTopOfLine;
+        return g_aTopOfLineQuery.bResult;
+    }
+    const bool bResult = rFrame.GetTopOfLine(rTop, rPos);
+    if (lcl_IsQueryCacheable(rFrame))
+    {
+        lcl_SetQuery(g_aTopOfLineQuery, rFrame, rPos, bResult);
+        g_nTopOfLine = rTop;
+    }
+    else
+        g_aTopOfLineQuery.pFrame = nullptr;
+    return bResult;
+}
+}
