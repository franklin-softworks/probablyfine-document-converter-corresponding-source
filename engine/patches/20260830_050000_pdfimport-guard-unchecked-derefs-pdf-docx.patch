 void PDFIProcessor::popState()
 {
+    // BUG-28 HARDENING. On underflow, pop_back() runs ~GraphicsContext() over the
+    // memory BEFORE the vector's buffer, destroying a std::vector<double> and a
+    // ref-counted B2DPolyPolygon -- i.e. freeing two arbitrary pointers -- and every
+    // later getCurrentContext() then writes outside the allocation. That is the
+    // cleanest "stray write whose landing site depends on allocator state" in this
+    // file, which is exactly the layout-sensitivity BUG-28 exhibits. Poppler's
+    // Gfx::opRestore guards unbalanced Q, so reachability is rated low.
+    if (m_aGCStack.empty())
+    {
+        fprintf(stderr, "[GUARD] popState on empty graphics-context stack\n"); fflush(stderr);
+        return;
+    }
     m_aGCStack.pop_back();
 }
 
