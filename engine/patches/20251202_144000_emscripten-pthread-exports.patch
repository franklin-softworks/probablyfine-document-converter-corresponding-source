From: Claude <claude@anthropic.com>
Date: Fri, 2 Dec 2024 14:40:00 +0000
Subject: [PATCH] Emscripten: SIMD, memory growth, profiling, pthread exports, INVOKE_RUN=0

Ported for LibreOffice 25.8 from original 7.6 patch.

Consolidated Emscripten platform changes:
- SIMD (-msimd128) for faster string/memory operations
- Memory growth (256MB to 4GB) for large files
- Profiling flags (--profiling --profiling-funcs) for DevTools
- PROXY_TO_PTHREAD=1 for worker thread support
- FS, allocateUTF8, printErr exports in EXPORTED_RUNTIME_METHODS
- INVOKE_RUN=0 to prevent main() from running on module load
  (our WASM module is used as a library via cwrap, not as a standalone app;
   running main() triggers soffice_main/SVMain which conflicts with LOK init)

diff --git a/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk b/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk
index 462992588abb..f85f97d77559 100644
--- a/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk
+++ b/solenv/gbuild/platform/EMSCRIPTEN_INTEL_GCC.mk
@@ -11,14 +11,15 @@ include $(GBUILDDIR)/platform/unxgcc.mk

 gb_RUN_CONFIGURE := $(SRCDIR)/solenv/bin/run-configure
 # avoid -s SAFE_HEAP=1 - c.f. gh#8584 this breaks source maps
-gb_EMSCRIPTEN_CPPFLAGS := -pthread -s USE_PTHREADS=1 -D_LARGEFILE64_SOURCE -D_LARGEFILE_SOURCE -s SUPPORT_LONGJMP=wasm
+# WASM SIMD for faster string/memory ops; profiling preserves function names for DevTools
+gb_EMSCRIPTEN_CPPFLAGS := -pthread -s USE_PTHREADS=1 -msimd128 -D_LARGEFILE64_SOURCE -D_LARGEFILE_SOURCE -s SUPPORT_LONGJMP=wasm --profiling --profiling-funcs
 gb_EMSCRIPTEN_LDFLAGS := $(gb_EMSCRIPTEN_CPPFLAGS)

-# Initial memory size
-gb_EMSCRIPTEN_LDFLAGS += -s TOTAL_MEMORY=1GB
+# Memory growth: 256MB initial, up to 4GB for large files
+gb_EMSCRIPTEN_LDFLAGS += -s INITIAL_MEMORY=256MB -s MAXIMUM_MEMORY=4GB -s ALLOW_MEMORY_GROWTH=1

 ifeq ($(ENABLE_EMSCRIPTEN_PROXY_TO_PTHREAD),)
-gb_EMSCRIPTEN_LDFLAGS += -sPTHREAD_POOL_SIZE=7
+gb_EMSCRIPTEN_LDFLAGS += -sPTHREAD_POOL_SIZE=7 -s PROXY_TO_PTHREAD=1
 endif

 # Double the main thread stack size, but keep the default value for other threads:
@@ -27,7 +28,7 @@ gb_EMSCRIPTEN_LDFLAGS += -sSTACK_SIZE=131072 -sDEFAULT_PTHREAD_STACK_SIZE=65536
 # To keep the link time (and memory) down, prevent all rewriting options from wasm-emscripten-finalize
 # See emscripten.py, finalize_wasm, modify_wasm = True
 # So we need WASM_BIGINT=1 and ASSERTIONS=1 (2 implies STACK_OVERFLOW_CHECK)
-gb_EMSCRIPTEN_LDFLAGS += --bind -s FORCE_FILESYSTEM=1 -s WASM_BIGINT=1 -s ERROR_ON_UNDEFINED_SYMBOLS=1 -s FETCH=1 -s ASSERTIONS=1 -s EXIT_RUNTIME=0 -s EXPORTED_RUNTIME_METHODS=["UTF16ToString","stringToUTF16","UTF8ToString","ccall","cwrap","addOnPreMain","addOnPostRun","registerType","throwBindingError","ClassHandle","HEAPU16","HEAPU32"$(if $(ENABLE_QT6),$(COMMA)"FS"$(COMMA)"callMain"$(COMMA)"specialHTMLTargets")]
+gb_EMSCRIPTEN_LDFLAGS += --bind -s FORCE_FILESYSTEM=1 -s WASM_BIGINT=1 -s ERROR_ON_UNDEFINED_SYMBOLS=1 -s FETCH=1 -s ASSERTIONS=1 -s EXIT_RUNTIME=0 -s INVOKE_RUN=0 -s EXPORTED_RUNTIME_METHODS=["UTF16ToString","stringToUTF16","UTF8ToString","ccall","cwrap","addOnPreMain","addOnPostRun","registerType","throwBindingError","ClassHandle","HEAPU16","HEAPU32","FS","allocateUTF8","printErr"$(if $(ENABLE_QT6),$(COMMA)"callMain"$(COMMA)"specialHTMLTargets")]
 gb_EMSCRIPTEN_QTDEFS := -DQT_NO_LINKED_LIST -DQT_NO_JAVA_STYLE_ITERATORS -DQT_NO_EXCEPTIONS -DQT_NO_DEBUG -DQT_WIDGETS_LIB -DQT_GUI_LIB -DQT_CORE_LIB

 ifeq ($(ENABLE_EMSCRIPTEN_JSPI),TRUE)
