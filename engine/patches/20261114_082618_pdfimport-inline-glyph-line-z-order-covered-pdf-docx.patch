+#ifdef __EMSCRIPTEN__
+namespace
+{
+    // a graphic with more vertices than this is not tested (treated as not covering): the test is a bounded decision, not a rasteriser
+    constexpr sal_uInt32 MAX_COVER_VERTICES = 10000;
+    // at most this many glyph centres are tested per graphic, evenly spaced over the line (deterministic: the output must be reproducible)
+    constexpr size_t MAX_COVER_SAMPLES = 64;
+
+    sal_uInt32 lcl_vertexCount(const basegfx::B2DPolyPolygon& rPoly)
+    {
+        sal_uInt32 nCount = 0;
+        for (sal_uInt32 i = 0; i < rPoly.count(); ++i)
+            nCount += rPoly.getB2DPolygon(i).count();
+        return nCount;
+    }
+}
+
+// BUG-83: spend from the page's budget; once it is spent every test says no, so the page keeps the order it had before this fix (never dropping text)
+bool PDFIProcessor::chargeCoverWork(sal_Int64 nUnits)
+{
+    if (m_nCoverBudget < nUnits)
+    {
+        m_nCoverBudget = 0;
+        return false;
+    }
+    m_nCoverBudget -= nUnits;
+    return true;
+}
+
+// BUG-83: a glyph line is only closed when the NEXT glyph does not continue it, so a line sat pending in m_GlyphsList while later graphics were drawn, and took its
+// z-order (m_nNextZOrder) AFTER them: text a PDF draws and then covers with an opaque picture or fill (a page-number artifact under a background strip, text under a
+// box, a poor redaction) came out ON TOP of the cover, visible. The text is kept (complete conversions only); what changes is where it sits: the line is closed, and
+// numbered, before the covering graphic. Only when the graphic covers at least half of the pending glyphs' centres, so an underline, a rule or a table border
+// (which touch a line without covering it) never split one. BOUNDED: the centres are kept incrementally, at most MAX_COVER_SAMPLES of them (evenly spaced) are tested
+// per graphic, a graphic of more than MAX_COVER_VERTICES vertices is not tested, and the page has a work budget (chargeCoverWork).
+void PDFIProcessor::flushGlyphLineIfCoveredBy(const basegfx::B2DPolyPolygon& rArea)
+{
+    if (m_aGlyphCentres.empty() || !rArea.count())
+        return;
+    if (!rArea.getB2DRange().overlaps(m_aGlyphCentreRange))
+        return;
+    const sal_uInt32 nVertices = lcl_vertexCount(rArea);
+    if (nVertices > MAX_COVER_VERTICES)
+        return;
+    const size_t nGlyphs = m_aGlyphCentres.size();
+    const size_t nSamples = std::min(nGlyphs, MAX_COVER_SAMPLES);
+    if (!chargeCoverWork(static_cast<sal_Int64>(nSamples) * (nVertices + 1)))
+        return;
+    size_t nCovered = 0;
+    for (size_t i = 0; i < nSamples; ++i)
+    {
+        const size_t nIndex = nSamples > 1 ? (i * (nGlyphs - 1)) / (nSamples - 1) : 0;
+        if (basegfx::utils::isInside(rArea, m_aGlyphCentres[nIndex], true))
+            ++nCovered;
+    }
+    if (nCovered * 2 >= nSamples)
+        processGlyphLine();
 }
+#endif
 
