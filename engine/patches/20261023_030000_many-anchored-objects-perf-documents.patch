diff --git a/sw/source/core/layout/sortedobjs.cxx b/sw/source/core/layout/sortedobjs.cxx
index d15c4e7..92fd6c8 100644
--- a/sw/source/core/layout/sortedobjs.cxx
+++ b/sw/source/core/layout/sortedobjs.cxx
@@ -32,12 +32,52 @@
 
 using namespace ::com::sun::star;
 
+namespace
+{
+// BulkInsertScope state: nesting depth, and the lists verified in the current scope.
+int s_nBulkInsertDepth = 0;
+std::vector<SwSortedObjs*>& BulkInsertTouched()
+{
+    static std::vector<SwSortedObjs*> aTouched;
+    return aTouched;
+}
+}
+
 SwSortedObjs::SwSortedObjs()
 {
 }
 
 SwSortedObjs::~SwSortedObjs()
 {
+    if (mbVerifiedInBulk)
+    {
+        auto& rTouched = BulkInsertTouched();
+        std::erase(rTouched, this);
+    }
+}
+
+SwSortedObjs::BulkInsertScope::BulkInsertScope()
+{
+    ++s_nBulkInsertDepth;
+}
+
+SwSortedObjs::BulkInsertScope::~BulkInsertScope()
+{
+    if (--s_nBulkInsertDepth > 0)
+        return;
+    // The scope's promise is checked, not assumed: every list it touched is sorted, or is
+    // re-sorted here as the next Insert() would have done.
+    auto& rTouched = BulkInsertTouched();
+    for (SwSortedObjs* pList : rTouched)
+    {
+        pList->mbVerifiedInBulk = false;
+        if (!pList->is_sorted())
+        {
+            SAL_WARN("sw.core", "SwSortedObjs::BulkInsertScope: object list is not sorted");
+            pList->UpdateAll();
+        }
+    }
+    rTouched.clear();
 }
 
