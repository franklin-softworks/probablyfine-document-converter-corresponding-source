-        UpdateAll();
+        if (!is_sorted())
+        {
+            SAL_WARN("sw.core", "SwSortedObjs::Insert: object list is not sorted");
+            UpdateAll();
+        }
+        if (s_nBulkInsertDepth > 0)
+        {
