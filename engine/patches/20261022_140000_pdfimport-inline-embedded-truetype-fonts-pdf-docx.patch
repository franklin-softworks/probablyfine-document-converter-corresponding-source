+// Empty when no hash backend is built in (comphelper then returns zeros): fail closed.
+static OUString lcl_contentTag(const std::vector<std::uint8_t>& rProgram)
+{
+    const std::vector<unsigned char> aHash = comphelper::Hash::calculateHash(
+        rProgram.data(), rProgram.size(), comphelper::HashType::SHA256);
+    if (std::all_of(aHash.begin(), aHash.end(), [](unsigned char c) { return c == 0; }))
+        return OUString();
+    return "-pdf" + OUString::fromUtf8(comphelper::hashToString(aHash));
