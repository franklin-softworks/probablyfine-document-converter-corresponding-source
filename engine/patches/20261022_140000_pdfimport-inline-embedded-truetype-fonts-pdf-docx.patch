+// D6: for an embedded simple TrueType font, the Unicode -> glyph pairs the import needs
+// to draw ITS OWN text with the embedded program. A PDF subset usually carries only a
+// (1,0) or (3,0) cmap keyed by the PDF's character codes, so the program cannot be
+// registered as it is. Built here from Poppler's own code -> GID map (the one it renders
+// with) and the font's ToUnicode, for all 256 codes; one text line, before the font's
+// first updateFont:
+//   fontCodeMap <fontID> <n> <unicode> <gid> ... (decimal, n <= 256)
+// Codes mapping to no glyph, to more than one character (ligatures) or to a control
+// character are left out: the import draws those through the substitute.
+void PDFOutDev::writeFontCodeMap( long long fontID, GfxFont* gfxFont ) const
+{
+    if( gfxFont->getType() != fontTrueType )
+        return;
+    std::optional<std::vector<unsigned char>> pBuf = gfxFont->readEmbFontFile( m_pDoc->getXRef() );
+    if( !pBuf || pBuf->empty() )
+        return;
+    std::unique_ptr<FoFiTrueType> pTT = FoFiTrueType::make( std::span<unsigned char>( pBuf->data(), pBuf->size() ), 0 );
+    if( !pTT )
+        return;
+    const std::vector<int> aCodeToGID = static_cast<Gfx8BitFont*>( gfxFont )->getCodeToGIDMap( pTT.get() );
+    const CharCodeToUnicode* pToUnicode = gfxFont->getToUnicode();
+    if( !pToUnicode )
+        return;
+    std::vector<std::pair<unsigned int, int>> aPairs;
+    for( size_t nCode = 0; nCode < 256 && nCode < aCodeToGID.size(); ++nCode )
+    {
+        const int nGID = aCodeToGID[nCode];
+        if( nGID <= 0 )
+            continue;
+        const Unicode* pU = nullptr;
+        if( pToUnicode->mapToUnicode( static_cast<CharCode>( nCode ), &pU ) != 1 || !pU || pU[0] < 0x20 )
+            continue;
+        aPairs.emplace_back( static_cast<unsigned int>( pU[0] ), nGID );
+    }
+    if( aPairs.empty() )
+        return;
+    printf( "fontCodeMap %lld %d", fontID, static_cast<int>( aPairs.size() ) );
+    for( const auto& rPair : aPairs )
+        printf( " %u %d", rPair.first, rPair.second );
+    printf( "\n" );
+}
