+OUString LineParser::registerEmbeddedFont( const uno::Sequence<sal_Int8>& rFile, sal_Int64 nFontID,
+                                           const FontAttributes& rFont )
+{
+    const OString aName = OUStringToOString(rFont.familyName, RTL_TEXTENCODING_UTF8);
+    if (!lcl_canNameTempFont(rFont.familyName))
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (the family name cannot name a temporary file)\n", aName.getStr());
+        return OUString();
+    }
+    const size_t nLength = rFile.getLength() > 0 ? size_t(rFile.getLength()) : 0;
+    // Written so nothing wraps: the rebuilt copy can be a little larger than the input, so
+    // the retained total may pass the limit by that margin before the next check.
+    if (m_parser.m_nFontProgramsRetained >= kMaxDocFontPrograms
+        || m_parser.m_nFontBytesRetained >= kMaxDocFontBytes
+        || nLength > (kMaxDocFontBytes - m_parser.m_nFontBytesRetained) / 2)
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (this document's embedded fonts exceed the limit of %zu "
+                        "programs or %zu MB)\n", aName.getStr(), kMaxDocFontPrograms, kMaxDocFontBytes >> 20);
+        return OUString();
+    }
+    const auto it = m_parser.m_aFontCodeMaps.find(nFontID);
+    if (it == m_parser.m_aFontCodeMaps.end())
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (not a simple TrueType font with a code map)\n", aName.getStr());
+        return OUString();
+    }
