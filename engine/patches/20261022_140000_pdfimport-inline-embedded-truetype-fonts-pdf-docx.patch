+    std::vector<std::uint8_t> aRebuilt;
+    pdffont::Program aProgram;
+    if (!pdffont::loadProgram(pData, rFile.getLength(), it->second, aProgram)
+        || !pdffont::withUnicodeCmap(aProgram.t, it->second, aRebuilt))
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (not a well-formed TrueType program)\n", aName.getStr());
+        return OUString();
+    }
+    // Registered under its own name first: that checks its rights (addEmbeddedFont, the
+    // converter's rule) and gives the import the real face's metrics.
+    const OUString aOwn = rFont.familyName + " pdf" + OUString::number(nFontID);
+    uno::Reference<io::XInputStream> xIn(new comphelper::SequenceInputStream(
+        uno::Sequence<sal_Int8>(reinterpret_cast<const sal_Int8*>(aRebuilt.data()), aRebuilt.size())));
+    const OUString aExtra = lcl_contentTag(aRebuilt);
+    if (aExtra.isEmpty())
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (no content hash for its temporary file)\n", aName.getStr());
+        return OUString();
+    }
+    if (!m_parser.m_aEmbeddedFonts.addEmbeddedFont(xIn, aOwn, aExtra, {}, false, false))
+    {
+        fprintf(stderr, "[PDFFONT] %s: not used (its rights do not allow this output, or its temporary file failed)\n",
+                aName.getStr());
+        return OUString();
+    }
+    m_parser.m_aEmbeddedFonts.activateFonts();
+    const OUString aKey = rFont.familyName + "|" + rFont.fontWeight
+                          + (rFont.isItalic ? std::u16string_view(u"|i") : std::u16string_view(u"|"));
+    auto& rFace = m_parser.m_aFaces[aKey];
+    if (rFace.aPrograms.empty())
+    {
+        rFace.aFamily = rFont.familyName;
+        m_parser.m_aFaceOrder.push_back(aKey);
+    }
+    m_parser.m_nFontProgramsRetained += 1;
+    m_parser.m_nFontBytesRetained += nLength + aRebuilt.size();
+    rFace.aPrograms.push_back(std::move(aProgram));
+    rFace.aRebuilt.push_back(std::move(aRebuilt));
+    return aOwn;
+}
