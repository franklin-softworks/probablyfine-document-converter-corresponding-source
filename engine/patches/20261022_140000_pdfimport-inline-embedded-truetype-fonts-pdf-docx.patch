+// ---------------------------------------------------------------------------------------
+// D6 (owner decisions 2026-10-18/19, docs/fonts/embedded-font-rights.md): a PDF's own
+// embedded TrueType fonts are used to lay out and draw its text. A PDF subset carries a
+// cmap keyed by the PDF's character codes, so each program is rebuilt with a Unicode cmap
+// from the code map the Poppler side sends (fontCodeMap); the subsets of one face are
+// merged into one font; it is registered under the family name the import writes, so
+// layout uses it, and an editable output names the real family and embeds nothing (D5).
+// Rights: EmbeddedFontsHelper::addEmbeddedFont applies the converter's rule (D4 patch).
+// The code below parses untrusted bytes: every read is bounds-checked (fuzzed natively
+// with ASan/UBSan, see the PR).
+// ---------------------------------------------------------------------------------------
+namespace pdffont
+{
+using Pairs = std::vector<std::pair<std::uint32_t, std::uint32_t>>; // unicode -> gid
+
+inline std::uint32_t get32(const std::uint8_t* p)
+{
+    return (std::uint32_t(p[0]) << 24) | (std::uint32_t(p[1]) << 16) | (std::uint32_t(p[2]) << 8) | p[3];
+}
+inline std::uint16_t get16(const std::uint8_t* p) { return std::uint16_t((p[0] << 8) | p[1]); }
+inline void put16(std::vector<std::uint8_t>& v, std::uint32_t x)
+{
+    v.push_back(std::uint8_t((x >> 8) & 0xff));
+    v.push_back(std::uint8_t(x & 0xff));
+}
+inline void put32(std::vector<std::uint8_t>& v, std::uint32_t x)
+{
+    put16(v, x >> 16);
+    put16(v, x & 0xffff);
+}
+inline void set16(std::vector<std::uint8_t>& v, std::size_t at, std::uint32_t x)
+{
+    if (at + 2 <= v.size()) { v[at] = std::uint8_t((x >> 8) & 0xff); v[at + 1] = std::uint8_t(x & 0xff); }
+}
+inline std::uint32_t checksum(const std::uint8_t* p, std::size_t n)
+{
+    std::uint32_t s = 0;
+    for (std::size_t i = 0; i < n; i += 4)
+    {
+        std::uint32_t w = 0;
+        for (std::size_t k = 0; k < 4; ++k)
+            w = (w << 8) | (i + k < n ? p[i + k] : 0);
+        s += w;
+    }
+    return s;
+}
+
+constexpr std::uint32_t TAG(char a, char b, char c, char d)
+{
+    return (std::uint32_t(std::uint8_t(a)) << 24) | (std::uint32_t(std::uint8_t(b)) << 16)
+           | (std::uint32_t(std::uint8_t(c)) << 8) | std::uint8_t(d);
+}
+
+struct Table
+{
+    std::uint32_t tag;
+    std::vector<std::uint8_t> data;
+};
+
+/** The tables of a TrueType-outline sfnt; false if it is not one or a bound fails. */
+inline bool readTables(const std::uint8_t* p, std::size_t n, std::map<std::uint32_t, std::vector<std::uint8_t>>& rOut)
+{
+    rOut.clear();
+    if (!p || n < 12 || n > 64 * 1024 * 1024)
+        return false;
+    const std::uint32_t v = get32(p);
+    if (v != 0x00010000 && v != TAG('t', 'r', 'u', 'e'))
+        return false;
+    const std::uint16_t nTables = get16(p + 4);
+    if (nTables == 0 || nTables > 64 || 12 + 16 * std::size_t(nTables) > n)
+        return false;
+    // Tables may not overlap beyond the buffer's size in total: 64 entries each claiming the
+    // whole buffer would otherwise copy 64 times its size.
+    std::size_t nTotal = 0;
+    for (std::uint16_t i = 0; i < nTables; ++i)
+    {
+        const std::uint8_t* r = p + 12 + 16 * std::size_t(i);
+        const std::uint32_t t = get32(r), off = get32(r + 8), len = get32(r + 12);
+        if (off > n || len > n - off)
+            return false;
+        nTotal += len;
+        if (nTotal > n)
+            return false;
+        rOut[t].assign(p + off, p + off + len);
+    }
+    for (std::uint32_t req : { TAG('g', 'l', 'y', 'f'), TAG('l', 'o', 'c', 'a'), TAG('h', 'e', 'a', 'd'),
+                               TAG('h', 'h', 'e', 'a'), TAG('h', 'm', 't', 'x'), TAG('m', 'a', 'x', 'p') })
+        if (!rOut.count(req))
+            return false;
+    if (rOut[TAG('h', 'e', 'a', 'd')].size() < 54 || rOut[TAG('m', 'a', 'x', 'p')].size() < 6
+        || rOut[TAG('h', 'h', 'e', 'a')].size() < 36)
+        return false;
+    return true;
+}
+
+/** A cmap table with one (3,1) format-4 subtable, one segment per character. */
+inline std::vector<std::uint8_t> unicodeCmap(Pairs aPairs, std::uint32_t nGlyphs)
+{
+    std::sort(aPairs.begin(), aPairs.end());
+    Pairs aMap;
+    for (const auto& r : aPairs)
+        if (r.first < 0xFFFF && r.second > 0 && r.second < nGlyphs && (aMap.empty() || aMap.back().first != r.first))
+            aMap.push_back(r);
+    std::vector<std::uint8_t> v;
+    if (aMap.empty() || aMap.size() > 8000)
+        return v;
+    const std::uint32_t nSeg = std::uint32_t(aMap.size()) + 1;
+    std::uint32_t nPow = 1, nLog = 0;
+    while (nPow * 2 <= nSeg) { nPow *= 2; ++nLog; }
+    put16(v, 0); put16(v, 1);
+    put16(v, 3); put16(v, 1); put32(v, 12);
+    const std::size_t nFmt = v.size();
+    put16(v, 4); put16(v, 0); put16(v, 0);
+    put16(v, nSeg * 2); put16(v, nPow * 2); put16(v, nLog); put16(v, nSeg * 2 - nPow * 2);
+    for (const auto& r : aMap) put16(v, r.first);
+    put16(v, 0xFFFF);
+    put16(v, 0);
+    for (const auto& r : aMap) put16(v, r.first);
+    put16(v, 0xFFFF);
+    for (const auto& r : aMap) put16(v, (r.second - r.first) & 0xFFFF);
+    put16(v, 1);
+    for (std::uint32_t i = 0; i < nSeg; ++i) put16(v, 0);
+    set16(v, nFmt + 2, std::uint32_t(v.size() - nFmt));
+    return v;
+}
+
+/** Serialize tables (sorted by tag) as an sfnt with version 1.0. */
+inline std::vector<std::uint8_t> writeSfnt(std::vector<Table> aTables)
+{
+    std::sort(aTables.begin(), aTables.end(), [](const Table& a, const Table& b) { return a.tag < b.tag; });
+    const std::uint32_t nT = std::uint32_t(aTables.size());
+    std::uint32_t nPow = 1, nLog = 0;
+    while (nPow * 2 <= nT) { nPow *= 2; ++nLog; }
+    std::vector<std::uint8_t> out;
+    put32(out, 0x00010000);
+    put16(out, nT); put16(out, nPow * 16); put16(out, nLog); put16(out, nT * 16 - nPow * 16);
+    std::size_t nOffset = 12 + 16 * std::size_t(nT);
+    for (const Table& t : aTables)
+    {
+        put32(out, t.tag);
+        put32(out, checksum(t.data.data(), t.data.size()));
+        put32(out, std::uint32_t(nOffset));
+        put32(out, std::uint32_t(t.data.size()));
+        nOffset += (t.data.size() + 3) & ~std::size_t(3);
+    }
+    for (const Table& t : aTables)
+    {
+        out.insert(out.end(), t.data.begin(), t.data.end());
+        while (out.size() % 4)
+            out.push_back(0);
+    }
+    return out;
+}
+
+/** Tables read by readTables, written out with the cmap replaced by a Unicode one built from rPairs. */
+inline bool withUnicodeCmap(const std::map<std::uint32_t, std::vector<std::uint8_t>>& t, const Pairs& rPairs,
+                            std::vector<std::uint8_t>& rOut)
+{
+    const std::uint32_t nGlyphs = get16(t.at(TAG('m', 'a', 'x', 'p')).data() + 4);
+    std::vector<std::uint8_t> aCmap = unicodeCmap(rPairs, nGlyphs);
+    if (nGlyphs == 0 || aCmap.empty())
+        return false;
+    std::vector<Table> aOut;
+    for (auto& r : t)
+        if (r.first != TAG('c', 'm', 'a', 'p'))
+            aOut.push_back({ r.first, r.second });
+    aOut.push_back({ TAG('c', 'm', 'a', 'p'), std::move(aCmap) });
+    rOut = writeSfnt(std::move(aOut));
+    return true;
+}
+
+/** The program with its cmap replaced by a Unicode one built from rPairs. */
+inline bool withUnicodeCmap(const std::uint8_t* p, std::size_t n, const Pairs& rPairs, std::vector<std::uint8_t>& rOut)
+{
+    std::map<std::uint32_t, std::vector<std::uint8_t>> t;
+    return readTables(p, n, t) && withUnicodeCmap(t, rPairs, rOut);
+}
+
+// ---- merging subsets of one font -----------------------------------------------------
+
+struct Program
+{
+    std::map<std::uint32_t, std::vector<std::uint8_t>> t;
+    Pairs pairs;
+    std::uint32_t nGlyphs = 0, nHMetrics = 0;
+    bool bLongLoca = false;
+
+    bool glyph(std::uint32_t g, const std::uint8_t*& rP, std::size_t& rN) const
+    {
+        const auto& loca = t.at(TAG('l', 'o', 'c', 'a'));
+        const auto& glyf = t.at(TAG('g', 'l', 'y', 'f'));
+        if (g >= nGlyphs)
+            return false;
+        std::size_t a, b;
+        if (bLongLoca)
+        {
+            if (4 * (std::size_t(g) + 2) > loca.size()) return false;
+            a = get32(loca.data() + 4 * g); b = get32(loca.data() + 4 * (g + 1));
+        }
+        else
+        {
+            if (2 * (std::size_t(g) + 2) > loca.size()) return false;
+            a = 2 * std::size_t(get16(loca.data() + 2 * g)); b = 2 * std::size_t(get16(loca.data() + 2 * (g + 1)));
+        }
+        if (a > b || b > glyf.size())
+            return false;
+        rP = glyf.data() + a;
+        rN = b - a;
+        return true;
+    }
+    void metric(std::uint32_t g, std::uint16_t& rAdv, std::uint16_t& rLsb) const
+    {
+        const auto& hmtx = t.at(TAG('h', 'm', 't', 'x'));
+        rAdv = 0; rLsb = 0;
+        const std::uint32_t nH = std::min<std::uint32_t>(nHMetrics, std::uint32_t(hmtx.size() / 4));
+        if (nH == 0)
+            return;
+        if (g < nH) { rAdv = get16(hmtx.data() + 4 * g); rLsb = get16(hmtx.data() + 4 * g + 2); return; }
+        rAdv = get16(hmtx.data() + 4 * (nH - 1));
+        const std::size_t at = 4 * std::size_t(nH) + 2 * std::size_t(g - nH);
+        if (at + 2 <= hmtx.size()) rLsb = get16(hmtx.data() + at);
+    }
+};
+
+inline bool loadProgram(const std::uint8_t* p, std::size_t n, const Pairs& rPairs, Program& rOut)
+{
+    if (!readTables(p, n, rOut.t))
+        return false;
+    rOut.pairs = rPairs;
+    rOut.nGlyphs = get16(rOut.t[TAG('m', 'a', 'x', 'p')].data() + 4);
+    rOut.nHMetrics = get16(rOut.t[TAG('h', 'h', 'e', 'a')].data() + 34);
+    rOut.bLongLoca = get16(rOut.t[TAG('h', 'e', 'a', 'd')].data() + 50) != 0;
+    return rOut.nGlyphs > 0;
+}
+
+/** Component glyph ids of a composite glyph, with their byte offsets; false if malformed. */
+inline bool components(const std::uint8_t* p, std::size_t n, std::vector<std::pair<std::size_t, std::uint16_t>>& rOut)
+{
+    rOut.clear();
+    if (n < 10 || std::int16_t(get16(p)) >= 0)
+        return true; // empty or simple
+    std::size_t at = 10;
+    for (int nGuard = 0; nGuard < 1024; ++nGuard)
+    {
+        if (at + 4 > n) return false;
+        const std::uint16_t flags = get16(p + at);
+        rOut.emplace_back(at + 2, get16(p + at + 2));
+        at += 4 + ((flags & 0x0001) ? 4 : 2);
+        if (flags & 0x0008) at += 2;
+        else if (flags & 0x0040) at += 4;
+        else if (flags & 0x0080) at += 8;
+        if (!(flags & 0x0020)) return at <= n;
+    }
+    return false;
+}
+
+/**
+ * Merge subsets of ONE font into one program: the union of their characters. Safe only
+ * when they are cut from the same font: same unitsPerEm, identical hinting programs, and
+ * an identical glyph for every character two of them share (simple glyphs compared
+ * byte for byte). false when it is not safe (the caller then uses one program alone).
+ */
+inline bool mergeSubsets(const std::vector<Program>& rProgs, std::vector<std::uint8_t>& rOut)
+{
+    if (rProgs.size() < 2 || rProgs.size() > 64)
+        return false;
+    const Program& p0 = rProgs[0];
+    const auto head0 = p0.t.at(TAG('h', 'e', 'a', 'd'));
+    for (const Program& p : rProgs)
+    {
+        if (get16(p.t.at(TAG('h', 'e', 'a', 'd')).data() + 18) != get16(head0.data() + 18))
+            return false; // unitsPerEm
+        for (std::uint32_t tag : { TAG('f', 'p', 'g', 'm'), TAG('p', 'r', 'e', 'p'), TAG('c', 'v', 't', ' ') })
+        {
+            const bool a = p.t.count(tag) != 0, b = p0.t.count(tag) != 0;
+            if (a != b || (a && p.t.at(tag) != p0.t.at(tag)))
+                return false;
+        }
+    }
+
+    std::vector<std::vector<std::uint8_t>> aGlyphs;  // merged glyph data
+    std::vector<std::pair<std::uint16_t, std::uint16_t>> aMetrics;
+    std::map<std::uint32_t, std::uint32_t> aCmap;     // unicode -> merged gid
+    std::vector<std::map<std::uint32_t, std::uint32_t>> aGidMap(rProgs.size());
+
+    // Copy glyph g of program k (and its components) into the merged font; its new id.
+    std::function<bool(std::size_t, std::uint32_t, std::uint32_t&, int)> add;
+    add = [&](std::size_t k, std::uint32_t g, std::uint32_t& rNew, int nDepth) -> bool {
+        auto it = aGidMap[k].find(g);
+        if (it != aGidMap[k].end()) { rNew = it->second; return true; }
+        if (nDepth > 16 || aGlyphs.size() >= 65535) return false;
+        const std::uint8_t* gp; std::size_t gn;
+        if (!rProgs[k].glyph(g, gp, gn)) return false;
+        std::vector<std::uint8_t> data(gp, gp + gn);
+        std::vector<std::pair<std::size_t, std::uint16_t>> comps;
