+void Parser::finishEmbeddedFonts()
+{
+    // Each face's programs, merged when they are subsets of one font, registered under
+    // the family name the document's text uses. Layout happens after the parse.
+    for (const OUString& rKey : m_aFaceOrder)
+    {
+        PdfFace& rFace = m_aFaces[rKey];
+        const OString aName = OUStringToOString(rFace.aFamily, RTL_TEXTENCODING_UTF8);
+        std::vector<std::uint8_t> aMerged;
+        const std::vector<std::uint8_t>* pUse = &rFace.aRebuilt[0];
+        if (rFace.aPrograms.size() > 1)
+        {
+            if (pdffont::mergeSubsets(rFace.aPrograms, aMerged))
+            {
+                pUse = &aMerged;
+                fprintf(stderr, "[PDFFONT] %s: %zu subsets merged\n", aName.getStr(), rFace.aPrograms.size());
+            }
+            else
+            {
+                // Not subsets of one font: the program with the most characters; the
+                // others' characters fall back to the substitute (never a box).
+                size_t nBest = 0;
+                for (size_t i = 1; i < rFace.aPrograms.size(); ++i)
+                    if (rFace.aPrograms[i].pairs.size() > rFace.aPrograms[nBest].pairs.size())
+                        nBest = i;
+                pUse = &rFace.aRebuilt[nBest];
+                fprintf(stderr, "[PDFFONT] %s: %zu programs not merged (not one font); the largest is used\n",
+                        aName.getStr(), rFace.aPrograms.size());
+            }
+        }
+        uno::Reference<io::XInputStream> xIn(new comphelper::SequenceInputStream(
+            uno::Sequence<sal_Int8>(reinterpret_cast<const sal_Int8*>(pUse->data()), pUse->size())));
+        const OUString aExtra = lcl_contentTag(*pUse);
+        if (!aExtra.isEmpty() && m_aEmbeddedFonts.addEmbeddedFont(xIn, rFace.aFamily, aExtra, {}, false, false))
+            fprintf(stderr, "[PDFFONT] %s: embedded program used\n", aName.getStr());
+        else
+            fprintf(stderr, "[PDFFONT] %s: not used (its rights do not allow this output, or its temporary file failed)\n",
+                    aName.getStr());
+    }
+    m_aEmbeddedFonts.activateFonts();
+    m_aFaceOrder.clear();
+    m_aFaces.clear();
+    m_nFontProgramsRetained = 0;
+    m_nFontBytesRetained = 0;
+}
