+#ifdef __EMSCRIPTEN__
+namespace {
+// FG-173: doc_saveAs gives the export filter no status indicator, so a long
+// PDF export (a large Calc sheet: one page per setValue in PDFExport) reports
+// nothing until it returns, and the web driver's no-progress watchdog stops it.
+// This forwards the filter's progress to the LOK status-indicator callback
+// (comphelper -> lo_status_indicator_callback -> the office callback), which
+// the WASM bridge relays to the page. Rate-limited to whole-percent changes.
+class LokSaveStatusIndicator : public cppu::WeakImplHelper<css::task::XStatusIndicator>
+{
+    sal_Int32 mnRange = 0;
+    int mnLastPercent = -1;
+
+public:
+    void SAL_CALL start(const OUString& rText, sal_Int32 nRange) override
+    {
+        mnRange = nRange;
+        mnLastPercent = -1;
+        comphelper::LibreOfficeKit::statusIndicatorStart(rText);
+    }
+    void SAL_CALL end() override { comphelper::LibreOfficeKit::statusIndicatorFinish(); }
+    void SAL_CALL setText(const OUString&) override {}
+    void SAL_CALL setValue(sal_Int32 nValue) override
+    {
+        if (mnRange <= 0)
+            return;
+        const int nPercent = static_cast<int>(
+            std::clamp<sal_Int64>(sal_Int64(nValue) * 100 / mnRange, 0, 100));
+        if (nPercent == mnLastPercent)
+            return;
+        mnLastPercent = nPercent;
+        comphelper::LibreOfficeKit::statusIndicatorSetValue(nPercent);
+    }
+    void SAL_CALL reset() override { mnLastPercent = -1; }
+};
+}
+#endif
