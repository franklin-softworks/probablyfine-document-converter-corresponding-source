+
+// ---------------------------------------------------------------------------
+// FG-142: shaded fills.
+//
+// PDFOutDev had no shading support, so for every `sh` operator (and every
+// shading-pattern fill) poppler's Gfx decomposed the shading into flat fills:
+// up to 256 colour bands for axial/radial shadings (each radial band is two
+// 200-gons), and up to 4^6 flat quads per patch for mesh shadings. Each of
+// those fills then went through basegfx's general polygon clipper in
+// PDFIProcessor::fillPath and became its own draw:path in the output. One
+// InDesign page produced 56,000 fills for 335 shadings; the whole document
+// 282,000 draw elements, which the Writer layout could not finish.
+//
+// Instead, each shading is rasterized ONCE, in-process, into a nested
+// SplashOutputDev (already linked and used the same way by
+// tilingPatternFill above) covering the current clip's bounding box, which is
+// exactly the region a shading paints. It is emitted as
+//
+//     shadedFill <x0> <y0> <x1> <y1> PNG <size>\n   + <size> bytes of PNG
+//
+// where the rectangle is in device space, i.e. the space a path is in after
+// the current transformation on the LibreOffice side, which is also the space
+// PDFIProcessor keeps its clip in. The sink fills (clip ∩ rect) with the
+// image stretched over the rect. Axial, radial, function and Gouraud
+// shadings are painted by Splash itself; patch meshes (types 6/7) have no
+// Splash hook and are subdivided here, mirroring Gfx::fillPatch, into flat
+// quads painted into the nested device. Any failure returns false BEFORE
+// anything is written, so poppler falls back to its band decomposition and
+// nothing is lost silently.
+// ---------------------------------------------------------------------------
+namespace
+{
+    // ~144 dpi: smooth at print size, and a 300 pt gradient is a 600 px PNG.
+    const double kShadedFillPixelsPerPoint = 2.0;
+    const int    kShadedFillMaxSide        = 1024;
+    const int    kShadedFillMinSide        = 4;
+
+    // mirrors Gfx.cc: patchMaxDepth, patchColorDelta, gouraudParameterizedColorDelta
+    const int    kPatchMaxDepth                   = 6;
+    const double kGouraudParameterizedColorDelta  = 5e-3;
+
+    void lcl_cubicAxisExtrema( double p0, double p1, double p2, double p3,
+                               double& rMin, double& rMax )
+    {
+        // endpoints
+        rMin = std::min(rMin, std::min(p0, p3));
+        rMax = std::max(rMax, std::max(p0, p3));
+        // interior extrema: roots of dB/dt = 3(a t^2 + b t + c)
+        const double a = -p0 + 3.0 * p1 - 3.0 * p2 + p3;
+        const double b = 2.0 * (p0 - 2.0 * p1 + p2);
+        const double c = p1 - p0;
+        double aRoots[2];
+        int nRoots = 0;
+        if (std::fabs(a) < 1e-12)
+        {
+            if (std::fabs(b) > 1e-12)
+                aRoots[nRoots++] = -c / b;
+        }
+        else
+        {
+            const double fDisc = b * b - 4.0 * a * c;
+            if (fDisc >= 0.0)
+            {
+                const double fSq = std::sqrt(fDisc);
+                aRoots[nRoots++] = (-b + fSq) / (2.0 * a);
+                aRoots[nRoots++] = (-b - fSq) / (2.0 * a);
+            }
+        }
+        for (int i = 0; i < nRoots; ++i)
+        {
+            const double t = aRoots[i];
+            if (t <= 0.0 || t >= 1.0)
+                continue;
+            const double u = 1.0 - t;
+            const double v = u * u * u * p0 + 3.0 * u * u * t * p1 + 3.0 * u * t * t * p2 + t * t * t * p3;
+            rMin = std::min(rMin, v);
+            rMax = std::max(rMax, v);
+        }
+    }
+
+    /// Tight device-space bounds of a path (Bezier curves bounded exactly,
+    /// not by their control points). Returns false for an empty path.
+    bool lcl_tightPathBounds( const GfxState* state, const GfxPath* pPath,
+                              double& rXMin, double& rYMin, double& rXMax, double& rYMax )
+    {
+        rXMin = rYMin = std::numeric_limits<double>::infinity();
+        rXMax = rYMax = -std::numeric_limits<double>::infinity();
+        bool bAny = false;
+        const int nSub = pPath ? pPath->getNumSubpaths() : 0;
+        for (int s = 0; s < nSub; ++s)
+        {
+            const GfxSubpath* pSub = pPath->getSubpath(s);
+            const int n = pSub->getNumPoints();
+            if (n <= 0)
+                continue;
+            double fPrevX, fPrevY;
+            state->transform(pSub->getX(0), pSub->getY(0), &fPrevX, &fPrevY);
+            rXMin = std::min(rXMin, fPrevX); rXMax = std::max(rXMax, fPrevX);
+            rYMin = std::min(rYMin, fPrevY); rYMax = std::max(rYMax, fPrevY);
+            bAny = true;
+            int i = 1;
+            while (i < n)
+            {
+                if (pSub->getCurve(i) && i + 2 < n)
+                {
+                    // curveTo: two control points flagged as curve, then the end point
+                    double x1, y1, x2, y2, x3, y3;
+                    state->transform(pSub->getX(i),     pSub->getY(i),     &x1, &y1);
+                    state->transform(pSub->getX(i + 1), pSub->getY(i + 1), &x2, &y2);
+                    state->transform(pSub->getX(i + 2), pSub->getY(i + 2), &x3, &y3);
+                    lcl_cubicAxisExtrema(fPrevX, x1, x2, x3, rXMin, rXMax);
+                    lcl_cubicAxisExtrema(fPrevY, y1, y2, y3, rYMin, rYMax);
+                    fPrevX = x3; fPrevY = y3;
+                    i += 3;
+                }
+                else
+                {
+                    state->transform(pSub->getX(i), pSub->getY(i), &fPrevX, &fPrevY);
+                    rXMin = std::min(rXMin, fPrevX); rXMax = std::max(rXMax, fPrevX);
+                    rYMin = std::min(rYMin, fPrevY); rYMax = std::max(rYMax, fPrevY);
+                    ++i;
+                }
+            }
+        }
+        return bAny;
+    }
+
+    GfxColor lcl_patchFlatColor( const GfxPatch* pPatch, int nColorComps,
+                                 const GfxPatchMeshShading* pShading )
+    {
+        GfxColor aColor = {};
+        if (pShading->isParameterized())
+        {
+            pShading->getParameterizedColor(pPatch->color[0][0].c[0], &aColor);
+        }
+        else
+        {
+            for (int i = 0; i < nColorComps; ++i)
+                aColor.c[i] = GfxColorComp(pPatch->color[0][0].c[i]);
+        }
+        return aColor;
+    }
+
+    /// Port of Gfx::fillPatch (poppler 25.10) painting into the nested device.
+    void lcl_fillPatch( SplashOutputDev& rOut, GfxState& rState,
+                        const GfxPatch* patch, int colorComps, int patchColorComps,
+                        double refineColorThreshold, int depth,
+                        const GfxPatchMeshShading* shading )
+    {
+        int i;
+        for (i = 0; i < patchColorComps; ++i)
+        {
+            if (std::fabs(patch->color[0][0].c[i] - patch->color[0][1].c[i]) > refineColorThreshold
+                || std::fabs(patch->color[0][1].c[i] - patch->color[1][1].c[i]) > refineColorThreshold
+                || std::fabs(patch->color[1][1].c[i] - patch->color[1][0].c[i]) > refineColorThreshold
+                || std::fabs(patch->color[1][0].c[i] - patch->color[0][0].c[i]) > refineColorThreshold)
+            {
+                break;
+            }
+        }
+        if (i == patchColorComps || depth == kPatchMaxDepth)
+        {
+            const GfxColor aFlat = lcl_patchFlatColor(patch, colorComps, shading);
+            rState.setFillColor(&aFlat);
+            rOut.updateFillColor(&rState);
+            rState.moveTo(patch->x[0][0], patch->y[0][0]);
+            rState.curveTo(patch->x[0][1], patch->y[0][1], patch->x[0][2], patch->y[0][2], patch->x[0][3], patch->y[0][3]);
+            rState.curveTo(patch->x[1][3], patch->y[1][3], patch->x[2][3], patch->y[2][3], patch->x[3][3], patch->y[3][3]);
+            rState.curveTo(patch->x[3][2], patch->y[3][2], patch->x[3][1], patch->y[3][1], patch->x[3][0], patch->y[3][0]);
+            rState.curveTo(patch->x[2][0], patch->y[2][0], patch->x[1][0], patch->y[1][0], patch->x[0][0], patch->y[0][0]);
+            rState.closePath();
+            rOut.fill(&rState);
+            rState.clearPath();
+            return;
+        }
+
+        GfxPatch patch00, patch01, patch10, patch11;
+        double xx[4][8], yy[4][8];
+        double xxm, yym;
+        for (i = 0; i < 4; ++i)
+        {
+            xx[i][0] = patch->x[i][0];
+            yy[i][0] = patch->y[i][0];
+            xx[i][1] = 0.5 * (patch->x[i][0] + patch->x[i][1]);
+            yy[i][1] = 0.5 * (patch->y[i][0] + patch->y[i][1]);
+            xxm = 0.5 * (patch->x[i][1] + patch->x[i][2]);
+            yym = 0.5 * (patch->y[i][1] + patch->y[i][2]);
+            xx[i][6] = 0.5 * (patch->x[i][2] + patch->x[i][3]);
+            yy[i][6] = 0.5 * (patch->y[i][2] + patch->y[i][3]);
+            xx[i][2] = 0.5 * (xx[i][1] + xxm);
+            yy[i][2] = 0.5 * (yy[i][1] + yym);
+            xx[i][5] = 0.5 * (xxm + xx[i][6]);
+            yy[i][5] = 0.5 * (yym + yy[i][6]);
+            xx[i][3] = xx[i][4] = 0.5 * (xx[i][2] + xx[i][5]);
+            yy[i][3] = yy[i][4] = 0.5 * (yy[i][2] + yy[i][5]);
+            xx[i][7] = patch->x[i][3];
+            yy[i][7] = patch->y[i][3];
+        }
+        for (i = 0; i < 4; ++i)
+        {
+            patch00.x[0][i] = xx[0][i];
+            patch00.y[0][i] = yy[0][i];
+            patch00.x[1][i] = 0.5 * (xx[0][i] + xx[1][i]);
+            patch00.y[1][i] = 0.5 * (yy[0][i] + yy[1][i]);
+            xxm = 0.5 * (xx[1][i] + xx[2][i]);
+            yym = 0.5 * (yy[1][i] + yy[2][i]);
+            patch10.x[2][i] = 0.5 * (xx[2][i] + xx[3][i]);
+            patch10.y[2][i] = 0.5 * (yy[2][i] + yy[3][i]);
+            patch00.x[2][i] = 0.5 * (patch00.x[1][i] + xxm);
+            patch00.y[2][i] = 0.5 * (patch00.y[1][i] + yym);
+            patch10.x[1][i] = 0.5 * (xxm + patch10.x[2][i]);
+            patch10.y[1][i] = 0.5 * (yym + patch10.y[2][i]);
+            patch00.x[3][i] = 0.5 * (patch00.x[2][i] + patch10.x[1][i]);
+            patch00.y[3][i] = 0.5 * (patch00.y[2][i] + patch10.y[1][i]);
+            patch10.x[0][i] = patch00.x[3][i];
+            patch10.y[0][i] = patch00.y[3][i];
+            patch10.x[3][i] = xx[3][i];
+            patch10.y[3][i] = yy[3][i];
+        }
+        for (i = 4; i < 8; ++i)
+        {
+            patch01.x[0][i - 4] = xx[0][i];
+            patch01.y[0][i - 4] = yy[0][i];
+            patch01.x[1][i - 4] = 0.5 * (xx[0][i] + xx[1][i]);
+            patch01.y[1][i - 4] = 0.5 * (yy[0][i] + yy[1][i]);
+            xxm = 0.5 * (xx[1][i] + xx[2][i]);
+            yym = 0.5 * (yy[1][i] + yy[2][i]);
+            patch11.x[2][i - 4] = 0.5 * (xx[2][i] + xx[3][i]);
+            patch11.y[2][i - 4] = 0.5 * (yy[2][i] + yy[3][i]);
+            patch01.x[2][i - 4] = 0.5 * (patch01.x[1][i - 4] + xxm);
+            patch01.y[2][i - 4] = 0.5 * (patch01.y[1][i - 4] + yym);
+            patch11.x[1][i - 4] = 0.5 * (xxm + patch11.x[2][i - 4]);
+            patch11.y[1][i - 4] = 0.5 * (yym + patch11.y[2][i - 4]);
+            patch01.x[3][i - 4] = 0.5 * (patch01.x[2][i - 4] + patch11.x[1][i - 4]);
+            patch01.y[3][i - 4] = 0.5 * (patch01.y[2][i - 4] + patch11.y[1][i - 4]);
+            patch11.x[0][i - 4] = patch01.x[3][i - 4];
+            patch11.y[0][i - 4] = patch01.y[3][i - 4];
+            patch11.x[3][i - 4] = xx[3][i];
+            patch11.y[3][i - 4] = yy[3][i];
+        }
+        for (i = 0; i < patchColorComps; ++i)
+        {
+            patch00.color[0][0].c[i] = patch->color[0][0].c[i];
+            patch00.color[0][1].c[i] = (patch->color[0][0].c[i] + patch->color[0][1].c[i]) / 2.;
+            patch01.color[0][0].c[i] = patch00.color[0][1].c[i];
+            patch01.color[0][1].c[i] = patch->color[0][1].c[i];
+            patch01.color[1][1].c[i] = (patch->color[0][1].c[i] + patch->color[1][1].c[i]) / 2.;
+            patch11.color[0][1].c[i] = patch01.color[1][1].c[i];
+            patch11.color[1][1].c[i] = patch->color[1][1].c[i];
+            patch11.color[1][0].c[i] = (patch->color[1][1].c[i] + patch->color[1][0].c[i]) / 2.;
+            patch10.color[1][1].c[i] = patch11.color[1][0].c[i];
+            patch10.color[1][0].c[i] = patch->color[1][0].c[i];
+            patch10.color[0][0].c[i] = (patch->color[1][0].c[i] + patch->color[0][0].c[i]) / 2.;
+            patch00.color[1][0].c[i] = patch10.color[0][0].c[i];
+            patch00.color[1][1].c[i] = (patch00.color[1][0].c[i] + patch01.color[1][1].c[i]) / 2.;
+            patch01.color[1][0].c[i] = patch00.color[1][1].c[i];
+            patch11.color[0][0].c[i] = patch00.color[1][1].c[i];
+            patch10.color[0][1].c[i] = patch00.color[1][1].c[i];
+        }
+        lcl_fillPatch(rOut, rState, &patch00, colorComps, patchColorComps, refineColorThreshold, depth + 1, shading);
+        lcl_fillPatch(rOut, rState, &patch10, colorComps, patchColorComps, refineColorThreshold, depth + 1, shading);
+        lcl_fillPatch(rOut, rState, &patch01, colorComps, patchColorComps, refineColorThreshold, depth + 1, shading);
+        lcl_fillPatch(rOut, rState, &patch11, colorComps, patchColorComps, refineColorThreshold, depth + 1, shading);
+    }
+}
+
+void PDFOutDev::ClipBox::intersect( double x0, double y0, double x1, double y1 )
+{
+    if (x0 > x1) std::swap(x0, x1);
+    if (y0 > y1) std::swap(y0, y1);
+    if (!bValid)
+    {
+        bValid = true;
+        fXMin = x0; fYMin = y0; fXMax = x1; fYMax = y1;
+        return;
+    }
+    fXMin = std::max(fXMin, x0);
+    fYMin = std::max(fYMin, y0);
+    fXMax = std::min(fXMax, x1);
+    fYMax = std::min(fYMax, y1);
+}
+
+void PDFOutDev::intersectTightClipWithPath( const GfxState* state )
+{
+    double xMin, yMin, xMax, yMax;
+    if (lcl_tightPathBounds(state, state->getPath(), xMin, yMin, xMax, yMax))
+        m_aTightClip.intersect(xMin, yMin, xMax, yMax);
+    else
+        m_aTightClip.intersect(0, 0, 0, 0); // empty clip
+}
+
+poppler_bool PDFOutDev::useShadedFills(int type)
+{
+    return type >= 1 && type <= 7;
+}
+
+poppler_bool PDFOutDev::shadedFillImpl( GfxState* state, GfxShading* shading,
+                                        const std::function<bool(SplashOutputDev&, GfxState&)>& rPaint )
+{
+    assert(state);
+    assert(shading);
+
+    // Same contract as tilingPatternFill: with images skipped, claim the fill
+    // so poppler does not decompose it into thousands of band fills.
+    if (m_bSkipImages)
+        return true;
+
+    // The region a shading paints is the current clip (Gfx::opShFill and
+    // doShadingPatternFill have already intersected it with the shading's
+    // BBox and, for pattern fills, the filled path). Start from GfxState's
+    // clip bbox and tighten it with the exact curve bounds tracked in clip().
+    double xMin, yMin, xMax, yMax;
+    state->getClipBBox(&xMin, &yMin, &xMax, &yMax);
+    if (m_aTightClip.bValid)
+    {
+        xMin = std::max(xMin, m_aTightClip.fXMin);
+        yMin = std::max(yMin, m_aTightClip.fYMin);
+        xMax = std::min(xMax, m_aTightClip.fXMax);
+        yMax = std::min(yMax, m_aTightClip.fYMax);
+    }
+    if (!std::isfinite(xMin) || !std::isfinite(yMin) || !std::isfinite(xMax) || !std::isfinite(yMax))
+        return false;
+    if (!(xMax > xMin) || !(yMax > yMin))
+    {
+        // Empty clip: the shading paints nothing. Claiming it is exact and
+        // saves poppler the band decomposition.
+        return true;
+    }
+
+    // Raster size: ~2 px/pt (device space has getHDPI()/72 units per pt), longest side clamped.
+    const double fW = xMax - xMin;
+    const double fH = yMax - yMin;
+    const double fLongest = std::max(fW, fH);
+    double fScale = kShadedFillPixelsPerPoint * 72.0 / (state->getHDPI() > 0 ? state->getHDPI() : 72.0);
+    if (fLongest * fScale > kShadedFillMaxSide)
+        fScale = kShadedFillMaxSide / fLongest;
+    if (fLongest * fScale < kShadedFillMinSide)
+        fScale = kShadedFillMinSide / fLongest;
+    const int nW = std::max(1, static_cast<int>(std::ceil(fW * fScale - 1e-9)));
+    const int nH = std::max(1, static_cast<int>(std::ceil(fH * fScale - 1e-9)));
+    // The bitmap covers [xMin, xMin + nW/fScale) x [yMin, yMin + nH/fScale),
+    // which can exceed the clip bbox by less than a pixel because of the
+    // ceil; emit THAT rectangle so the stretched image lines up exactly.
+    const double fX1 = xMin + nW / fScale;
+    const double fY1 = yMin + nH / fScale;
+
+    // Nested state in pixel space. The CTM maps user space -> device space
+    // (the current CTM) -> pixels (scale about the raster origin). Device
+    // space is already top-down (upsideDown() is true for this device), so
+    // bitmap row 0 is device y == yMin and no flip is needed; contrast with
+    // tilingPatternFill, which renders pattern space (y up) and flips.
+    PDFRectangle aBox(0, 0, nW, nH);
+    GfxState aState(72.0, 72.0, &aBox, 0, false);
+    aState.setCTM(fScale, 0, 0, fScale, -fScale * xMin, -fScale * yMin);
+    const double* pCTM = state->getCTM();
+    aState.concatCTM(pCTM[0], pCTM[1], pCTM[2], pCTM[3], pCTM[4], pCTM[5]);
+    aState.setFillColorSpace(shading->getColorSpace()->copy());
+
+    SplashOutputDev aSplashOut(splashModeRGB8, 1, false, nullptr);
+    aSplashOut.setEnableFreeType(false);
+    aSplashOut.startDoc(m_pDoc);
+    aSplashOut.startPage(0 /* pageNum */, &aState, nullptr /* xref */);
+    aSplashOut.updateFillColorSpace(&aState);
+
+    if (!rPaint(aSplashOut, aState))
+        return false; // nothing written yet: poppler falls back to bands
+
+    std::unique_ptr<SplashBitmap> pSplashBitmap(aSplashOut.takeBitmap());
+    if (!pSplashBitmap || !pSplashBitmap->getDataPtr() || !pSplashBitmap->getAlphaPtr())
+        return false;
+
+    const auto nBitmapWidth  = static_cast<size_t>(pSplashBitmap->getWidth());
+    const auto nBitmapHeight = static_cast<size_t>(pSplashBitmap->getHeight());
+    if (nBitmapWidth == 0 || nBitmapHeight == 0)
+        return false;
+    // bitmapRowPad == 1 and RGB8: rows are contiguous, 3 bytes per pixel.
+    if (static_cast<size_t>(pSplashBitmap->getRowSize()) != nBitmapWidth * 3)
+        return false;
+
+    char* pBitmapData = reinterpret_cast<char*>(pSplashBitmap->getDataPtr());
+
+#if POPPLER_CHECK_VERSION(25, 5, 0)
+    std::unique_ptr<MemStream> pRgbStr(new MemStream(pBitmapData, 0,
+        nBitmapWidth * nBitmapHeight * 3, Object::null()));
+    std::unique_ptr<MemStream> pAlphaStr(new MemStream(reinterpret_cast<char*>(pSplashBitmap->getAlphaPtr()),
+        0, nBitmapWidth * nBitmapHeight, Object::null()));
+    auto aDecode = Object::null();
+#else
+    std::unique_ptr<MemStream> pRgbStr(new MemStream(pBitmapData, 0,
+        nBitmapWidth * nBitmapHeight * 3, Object(objNull)));
+    std::unique_ptr<MemStream> pAlphaStr(new MemStream(reinterpret_cast<char*>(pSplashBitmap->getAlphaPtr()),
+        0, nBitmapWidth * nBitmapHeight, Object(objNull)));
+    auto aDecode = Object(objNull);
+#endif
+#if POPPLER_CHECK_VERSION(24, 10, 0)
+    std::unique_ptr<GfxImageColorMap> pRgbIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        std::make_unique<GfxDeviceRGBColorSpace>()));
+    std::unique_ptr<GfxImageColorMap> pGrayIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        std::make_unique<GfxDeviceGrayColorSpace>()));
+#else
+    std::unique_ptr<GfxImageColorMap> pRgbIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        new GfxDeviceRGBColorSpace()));
+    std::unique_ptr<GfxImageColorMap> pGrayIdentityColorMap(new GfxImageColorMap(8, &aDecode,
+        new GfxDeviceGrayColorSpace()));
+#endif
+
+    // Record: "shadedFill x0 y0 x1 y1" then writePng_ appends " PNG <size>\n"
+    // and writeBinaryBuffer puts the PNG on the binary stream, exactly like
+    // tilingPatternFill. Nothing may be written before this point.
+    printf( "shadedFill %f %f %f %f",
+            normalize(xMin), normalize(yMin), normalize(fX1), normalize(fY1) );
+
+    OutputBuffer aBuf; initBuf(aBuf);
+    writePng_(aBuf, pRgbStr.get(), nBitmapWidth, nBitmapHeight, pRgbIdentityColorMap.get(),
+        pAlphaStr.get(), nBitmapWidth, nBitmapHeight, pGrayIdentityColorMap.get());
+    writeBinaryBuffer(aBuf);
+
+    return true;
+}
+
+poppler_bool PDFOutDev::functionShadedFill(GfxState *state, GfxFunctionShading *shading)
+{
+    return shadedFillImpl(state, shading,
+        [shading](SplashOutputDev& rOut, GfxState& rState)
+        { return rOut.functionShadedFill(&rState, shading); });
+}
+
+poppler_bool PDFOutDev::axialShadedFill(GfxState *state, GfxAxialShading *shading,
+                                        double tMin, double tMax)
+{
+    return shadedFillImpl(state, shading,
+        [shading, tMin, tMax](SplashOutputDev& rOut, GfxState& rState)
+        { return rOut.axialShadedFill(&rState, shading, tMin, tMax); });
+}
+
+poppler_bool PDFOutDev::radialShadedFill(GfxState *state, GfxRadialShading *shading,
+                                         double sMin, double sMax)
+{
+    return shadedFillImpl(state, shading,
+        [shading, sMin, sMax](SplashOutputDev& rOut, GfxState& rState)
+        { return rOut.radialShadedFill(&rState, shading, sMin, sMax); });
+}
+
+poppler_bool PDFOutDev::gouraudTriangleShadedFill(GfxState *state, GfxGouraudTriangleShading *shading)
+{
+    return shadedFillImpl(state, shading,
+        [shading](SplashOutputDev& rOut, GfxState& rState)
+        { return rOut.gouraudTriangleShadedFill(&rState, shading); });
+}
+
+poppler_bool PDFOutDev::patchMeshShadedFill(GfxState *state, GfxPatchMeshShading *shading)
+{
+    // Splash has no patch-mesh entry point; subdivide as Gfx::doPatchMeshShFill
+    // does and paint the flat quads into the nested device, with antialiasing
+    // off so adjacent quads do not show seams.
+    return shadedFillImpl(state, shading,
+        [shading](SplashOutputDev& rOut, GfxState& rState)
+        {
+            const int nPatches = shading->getNPatches();
+            int nStart;
+            if (nPatches > 128)
+                nStart = 3;
+            else if (nPatches > 64)
+                nStart = 2;
+            else if (nPatches > 16)
+                nStart = 1;
+            else
+                nStart = 0;
+
+            const int nColorComps = shading->getColorSpace()->getNComps();
+            double fRefineColorThreshold;
+            if (shading->isParameterized())
+                fRefineColorThreshold = kGouraudParameterizedColorDelta
+                    * (shading->getParameterDomainMax() - shading->getParameterDomainMin());
+            else
+                fRefineColorThreshold = dblToCol(3. / 256.0); // patchColorDelta
+
+            rOut.setVectorAntialias(false);
+            for (int i = 0; i < nPatches; ++i)
+            {
+                lcl_fillPatch(rOut, rState, shading->getPatch(i), nColorComps,
+                              shading->isParameterized() ? 1 : nColorComps,
+                              fRefineColorThreshold, nStart, shading);
+            }
+            return true;
+        });
+}
 }
 
