+// FG-142: one rasterized shading. rRect comes from the wrapper in device
+// space, which is where a path lands after getCurrentContext().Transformation
+// and where Clip is already kept (see intersectClip), so it is NOT
+// transformed here. The painted region is the clip, cut to the rectangle the
+// bitmap covers; the bitmap is stretched over the element's bounding box, so
+// the element's bounds must be exactly that rectangle's intersection with
+// the clip's tight bounds -- the wrapper sized the raster to the same tight
+// bounds (PDFOutDev::m_aTightClip).
+void PDFIProcessor::shadedFill(const geometry::RealRectangle2D& rRect,
+                               const uno::Sequence<beans::PropertyValue>& xImage)
+{
+    const basegfx::B2DRange aRect(
+        std::min(rRect.X1, rRect.X2), std::min(rRect.Y1, rRect.Y2),
+        std::max(rRect.X1, rRect.X2), std::max(rRect.Y1, rRect.Y2));
+    if (aRect.isEmpty())
+        return;
+
+    basegfx::B2DPolyPolygon aPoly;
+    const basegfx::B2DPolyPolygon& rClip = getCurrentContext().Clip;
+    if (rClip.count())
+        aPoly = basegfx::utils::clipPolyPolygonOnRange(rClip, aRect,
+                    true, /* bInside */
+                    false /* bStroke */);
+    else
+        aPoly = basegfx::B2DPolyPolygon(basegfx::utils::createPolygonFromRect(aRect));
+    if (!aPoly.count())
+        return;
+
+    PolyPolyElement* pPoly = ElementFactory::createPolyPolyElement(
+        m_pCurElement,
+        getGCId(getCurrentContext()),
+        aPoly,
+        PATH_FILL,
+        m_aImages.addImage(xImage),
+        0, 0);
+    pPoly->StretchFillImage = true;
+    pPoly->updateGeometry();
+    pPoly->ZOrder = m_nNextZOrder++;
+}
