+++ b/external/libeot/06-libeot-checked-font-buffer-alloc-wasm.patch.1
@@ -0,0 +1,25 @@
+Check the allocation of the working copy of the font data.
+
+writeFontBuffer() copied the font into a malloc'd buffer without testing the result, so a failed allocation (the
+size comes from the font's header, bounded by the input) was written through a NULL pointer. It now returns
+EOT_CANT_ALLOCATE_MEMORY; nothing else has been allocated at that point. A request for 0 bytes asks for 1, so a NULL
+answer to it is not mistaken for a failure.
+
+Written for FG-054 (owner instruction 2026-10-29; found by the pre-merge Fable review), against libeot-0.01 with
+LibreOffice's three patches and the five before this one applied.
+
+--- a/src/writeFontFile.c
++++ b/src/writeFontFile.c
+@@ -18,7 +18,11 @@
+ enum EOTError writeFontBuffer(const uint8_t *font, unsigned fontSize, bool compressed, bool encrypted, uint8_t **finalOutBuffer, unsigned *finalFontSize)
+ {
+   enum EOTError result;
+-  uint8_t *buf = (uint8_t *)malloc(fontSize);
++  uint8_t *buf = (uint8_t *)malloc(fontSize ? fontSize : 1);
++  if (!buf)
++  {
++    return EOT_CANT_ALLOCATE_MEMORY;   /* nothing else is allocated yet */
++  }
+   for (unsigned i = 0; i < fontSize; ++i)
+   {
+     if (encrypted)
