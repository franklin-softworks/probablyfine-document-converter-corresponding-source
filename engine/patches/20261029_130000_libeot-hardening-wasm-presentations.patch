index 0000000..6944823
--- /dev/null
+++ b/external/libeot/01-libeot-lzcomp-bounds-wasm.patch.1
@@ -0,0 +1,64 @@
+Bound the LZCOMP decoder's copy source, copy length and length value.
+
+Decode() copies from ptr1[start..] where start = pos - distance - length + 1 is driven by the stream,
+and writes ptr1[pos++] for `length` bytes with the output-length test only once per item. The history
+buffer is [-preLoadSize, out_len): valid streams copy from the preloaded dictionary before it (every
+compressed font in the corpus has 239-400 such copies), so `start < 0` is NOT an error; only
+`start < -preLoadSize` is. DecodeLength() shifts until the stream says stop and overflows a signed long.
+(archive patch 01: BUG-01, BUG-02, BUG-04)
+
+Re-derived for FG-054 (owner instruction 2026-10-29), NOT the archive's file of the same intent.
+The four patches in libeot_patches_and_research.tar.xz (sha256 8afd91ed...) do not apply to libeot 0.01
+(three have malformed hunk headers; their contexts name code that is not in the source), and applied
+literally some would break valid fonts. This change keeps each patch's stated intent, written against the
+real source: libeot-0.01 (sha256 cf5091fa...) with LibreOffice's three patches applied first.
+Tests (native, ASan+UBSan+LeakSanitizer, a caller that mirrors vcl/source/gdi/embeddedfontshelper.cxx):
+the 10 decodable corpus fonts decode byte-identical to the unpatched build. Of 473 mutated copies of them
+(truncations, byte flips) the unpatched build gives 175 SEGVs, 43 heap overflows, 1 use-after-free and 13
+leaks; patched, 0 reports (437 clean errors, 36 decoded). A second set of 3,740 (other seed, splices added)
+gives 0 reports patched (3,372 clean errors, 368 decoded). Not fuzzed with libFuzzer.
+
+--- a/src/lzcomp/lzcomp.c
++++ b/src/lzcomp/lzcomp.c
+@@ -10,6 +10,7 @@
+ #include <string.h>
+ #include <ctype.h>
+ #include <stdbool.h>
++#include <limits.h>
+ 
+ #include "BITIO.H"
+ #include "AHUFF.H"
+@@ -240,10 +241,13 @@
+         }
+         done = (bits & mask) == 0;
+         bits &= ~mask;
++        /* The loop runs for as long as the stream says "more": refuse a value that no longer fits. */
++        if ( value > (LONG_MAX >> bit_Range) ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
+         value <<= bit_Range;
+         value |= bits;
+     } while ( !done );
+     
++    if ( value > LONG_MAX - len_min ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
+     value += len_min;
+ 
+     return value; /******/
+@@ -766,6 +770,11 @@
+                 distance    = DecodeDistance2( t, numDistRanges );
+                 if ( distance >=max_2Byte_Dist  ) length++;
+                 start        = pos - distance - length + 1;
++                /* ptr1 points preLoadSize bytes into the history buffer (the preloaded dictionary lies
++                   before it, and valid streams copy from it), which is out_len + preLoadSize long. */
++                if ( start < -preLoadSize || length > t->out_len - pos ) {
++                    longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
++                }
+                 for ( j = 0; j < length; j++ ) {
+                     value = ptr1[ start + j ];
+                     ptr1[ pos++ ] = value;
+@@ -827,6 +836,7 @@
+                 if ( distance >=max_2Byte_Dist  ) length++;
+                 start        = dst - distance - length + 1;
+                 assert( distance + length - 1 <= t->maxCopyDistance );
++                if ( length > t->out_len - pos ) longjmp( t->mem->env, ERR_LZCOMP_Decode_bounds );
+                 for ( j = 0; j < length; j++ ) {
+                     src = start + j;
+                     if ( src < 0 ) src = src + t->maxCopyDistance;
diff --git a/external/libeot/02-libeot-bitio-oob-read-wasm.patch.1 b/external/libeot/02-libeot-bitio-oob-read-wasm.patch.1
