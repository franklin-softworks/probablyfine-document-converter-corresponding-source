diff --git a/external/libeot/04-libeot-error-return-and-leaks-wasm.patch.1 b/external/libeot/04-libeot-error-return-and-leaks-wasm.patch.1
new file mode 100644
index 0000000..093e8c8
--- /dev/null
+++ b/external/libeot/04-libeot-error-return-and-leaks-wasm.patch.1
@@ -0,0 +1,291 @@
+Make a malformed MTX stream an error return instead of a crash, and free what it allocated.
+
+The decoder reports a malformed stream with longjmp(mem->env, ...), but libeot never setjmp()s: every
+such error jumped through an uninitialised jmp_buf. unpackMtx() now sets it, the MTX allocator tracks
+its allocations (the unused mem_pointers fields; MTX_mem_FreeAllMemory was declared and never defined)
+so the error exit can free the decoder's state, and a failed allocation is an error instead of a NULL
+dereference. Also: EOT2ttf_buffer freed no metadata strings on a failed decode (callers free them only
+after success) and reported a failed decode as success when the header had only produced a warning;
+populateGlyfAndLoca leaked its output streams on a bad glyph. unpackMtx checked offsets with an
+overflowing unsigned sum. (archive patch 04: BUG-06)
+The allocator wrappers never ask for 0 bytes: realloc(p, 0) frees p and returns NULL, which they would take for a
+failure and then free p a second time (reachable from the run-length path of the LZCOMP decoder).
+
+Re-derived for FG-054 (owner instruction 2026-10-29), NOT the archive's file of the same intent.
+The four patches in libeot_patches_and_research.tar.xz (sha256 8afd91ed...) do not apply to libeot 0.01
+(three have malformed hunk headers; their contexts name code that is not in the source), and applied
+literally some would break valid fonts. This change keeps each patch's stated intent, written against the
+real source: libeot-0.01 (sha256 cf5091fa...) with LibreOffice's three patches applied first.
+Tests (native, ASan+UBSan+LeakSanitizer, a caller that mirrors vcl/source/gdi/embeddedfontshelper.cxx):
+the 10 decodable corpus fonts decode byte-identical to the unpatched build. Of 473 mutated copies of them
+(truncations, byte flips) the unpatched build gives 175 SEGVs, 43 heap overflows, 1 use-after-free and 13
+leaks; patched, 0 reports (437 clean errors, 36 decoded). A second set of 3,740 (other seed, splices added)
+gives 0 reports patched (3,372 clean errors, 368 decoded). Not fuzzed with libFuzzer.
+
+--- a/src/lzcomp/ERRCODES.H
++++ b/src/lzcomp/ERRCODES.H
+@@ -1,4 +1,5 @@
+ #define NO_ERROR   0
++#define ERR_MTX_mem_alloc          3300 /*MTXMEM:allocation failed*/
+ #define ERR_BITIO_end_of_file      3304 /*BITIO::input_bit:UNEXPECTED END OF FILE*/
+ #define ERR_LZCOMP_Encode_bounds    3353 /*LZCOMP:Encode out of bounds i*/
+ #define ERR_LZCOMP_Decode_bounds    3354 /*LZCOMP::Decode out of bounds pos*/
+--- a/src/lzcomp/mtxmem.c
++++ b/src/lzcomp/mtxmem.c
+@@ -5,26 +5,115 @@
+ #include <string.h> /* for size_t */
+ #include <stdlib.h>
+ #include "MTXMEM.H"
++#include "ERRCODES.H"
++
++/* Live allocations are tracked (mem_pointers) so that a decoder error, which leaves the decoder by
++   longjmp from anywhere, can free everything it still holds: MTX_mem_FreeAllMemory. */
++static long track_find(MTX_MemHandler *t, void *p)
++{
++    long i;
++    for (i = t->mem_numPointers - 1; i >= 0; --i)
++    {
++        if (t->mem_pointers[i].pointermem == p)
++        {
++            return i;
++        }
++    }
++    return -1;
++}
++
++static int track_add(MTX_MemHandler *t, void *p, unsigned long size)
++{
++    if (t->mem_numPointers == t->mem_maxPointers)
++    {
++        long newMax = t->mem_maxPointers ? t->mem_maxPointers * 2 : 32;
++        mem_struct *n = (mem_struct *)t->realloc(t->mem_pointers, sizeof(mem_struct) * (size_t)newMax);
++        if (!n)
++        {
++            return 0;
++        }
++        t->mem_pointers = n;
++        t->mem_maxPointers = newMax;
++    }
++    t->mem_pointers[t->mem_numPointers].pointermem = p;
++    t->mem_pointers[t->mem_numPointers].pointersize = (long)size;
++    t->mem_numPointers++;
++    return 1;
++}
+ 
+ void *MTX_mem_malloc(MTX_MemHandler *t, unsigned long size)
+ {
+-    return t->malloc(size);
++    void *p = t->malloc(size ? size : 1);   /* never ask for 0 bytes: a NULL for 0 is not a failure */
++    if (!p || !track_add(t, p, size))
++    {
++        if (p)
++        {
++            t->free(p);
++        }
++        longjmp(t->env, ERR_MTX_mem_alloc);
++    }
++    return p;
+ }
+ 
+ void *MTX_mem_realloc(MTX_MemHandler *t, void *p, unsigned long size)
+ {
+-    return t->realloc(p, size);
++    long at = p ? track_find(t, p) : -1;
++    void *q = t->realloc(p, size ? size : 1);   /* realloc(p, 0) frees p and returns NULL: taken for a failure it would be freed twice */
++    if (!q)
++    {
++        longjmp(t->env, ERR_MTX_mem_alloc);   /* p is still tracked, and is freed by FreeAllMemory */
++    }
++    if (at >= 0)
++    {
++        t->mem_pointers[at].pointermem = q;
++        t->mem_pointers[at].pointersize = (long)size;
++    }
++    else if (!track_add(t, q, size))
++    {
++        t->free(q);
++        longjmp(t->env, ERR_MTX_mem_alloc);
++    }
++    return q;
+ }
+ 
+ void  MTX_mem_free(MTX_MemHandler *t, void *deadObject)
+ {
++    long at = deadObject ? track_find(t, deadObject) : -1;
++    if (at >= 0)
++    {
++        t->mem_pointers[at] = t->mem_pointers[--t->mem_numPointers];
++    }
+     t->free(deadObject);
+ }
+ 
++/* Frees every allocation still tracked, and the table. Call it on an abnormal (error) exit. */
++void MTX_mem_FreeAllMemory(MTX_MemHandler *t)
++{
++    long i;
++    for (i = 0; i < t->mem_numPointers; ++i)
++    {
++        t->free(t->mem_pointers[i].pointermem);
++    }
++    t->mem_numPointers = 0;
++    t->free(t->mem_pointers);
++    t->mem_pointers = NULL;
++    t->mem_maxPointers = 0;
++}
++
++/* Normal exit: frees the table and the handler, NOT what is still tracked (the caller owns it now). */
++void MTX_mem_Destroy(MTX_MemHandler *t)
++{
++    t->free(t->mem_pointers);
++    free(t);
++}
+ 
+ MTX_MemHandler *MTX_mem_Create(MTX_MALLOCPTR mptr, MTX_REALLOCPTR rptr, MTX_FREEPTR fptr)
+ {
+     MTX_MemHandler *t = (MTX_MemHandler *)malloc(sizeof(MTX_MemHandler));
++    if (!t)
++    {
++        return NULL;
++    }
+     *t = (MTX_MemHandler){0};
+     t->malloc = mptr;
+     t->realloc = rptr;
+--- a/src/lzcomp/liblzcomp.c
++++ b/src/lzcomp/liblzcomp.c
+@@ -20,6 +20,8 @@
+ {
+ 	return ((unsigned)buf[2]) | (((unsigned)buf[1]) << 8) | (((unsigned)buf[0]) << 16);
+ }
++/* a failed stream read: leave through the common error exit (which frees what the decoder holds) */
++#define CHK_FAIL(sRes) if ((sRes) != EOT_STREAM_OK) {returnedStatus = EOT_MTX_ERROR; goto FAIL;}
+ enum EOTError unpackMtx(struct Stream *buf, unsigned size, uint8_t **bufsOut, unsigned *bufSizesOut)
+ {
+ 	for (unsigned i = 0; i < 3; ++i)
+@@ -27,50 +29,64 @@
+ 		bufsOut[i] = NULL;
+ 	}
+ 	enum StreamResult sResult;
+-	enum EOTError returnedStatus = EOT_SUCCESS;
++	volatile enum EOTError returnedStatus = EOT_SUCCESS;
+ 	MTX_MemHandler *mem = MTX_mem_Create(&malloc, &realloc, &free);
+ 	if (!mem)
+ 	{
+-		goto CLEANUP;
++		return EOT_CANT_ALLOCATE_MEMORY;
+ 	}
+-	LZCOMP *lzcomp = MTX_LZCOMP_Create1(mem);
+-	if (!lzcomp)
++	/* The decoder reports malformed input by longjmp(mem->env, ...) from wherever it finds it; this
++	   is where those land. Nothing set up this jump buffer before, so such an error jumped through an
++	   uninitialised one. */
++	if (setjmp(mem->env) != 0)
+ 	{
+-		goto CLEANUP;
++		returnedStatus = EOT_MTX_ERROR;
++		goto FAIL;
+ 	}
++	LZCOMP *lzcomp = MTX_LZCOMP_Create1(mem);
+ 	uint8_t versionMagic;
+ 	uint32_t offsets[3];
+ 	offsets[0] = 10;
+ 	uint32_t copyLimit;
+ 	sResult = BEReadU8(buf, &versionMagic);
+-	CHK_CN(sResult, EOT_MTX_ERROR);
++	CHK_FAIL(sResult);
+ 	sResult = BEReadU24(buf, &copyLimit);
+-	CHK_CN(sResult, EOT_MTX_ERROR);
++	CHK_FAIL(sResult);
+ 	for (unsigned i = 1 /* sic */; i < 3; ++i)
+ 	{
+ 		sResult = BEReadU24(buf, &offsets[i]);
+-		CHK_CN(sResult, EOT_MTX_ERROR);
++		CHK_FAIL(sResult);
+ 	}
+ 	unsigned sizes[] = {offsets[1] - offsets[0], offsets[2] - offsets[1], buf->size - offsets[2]};
+ 	for (unsigned i = 0; i < 3; ++i)
+ 	{
+-		if (offsets[i] + sizes[i] > buf->size)
++		long sizeOut;
++		/* offsets and sizes come from the file: each block must lie inside the buffer */
++		if (offsets[i] > buf->size || sizes[i] > buf->size - offsets[i])
+ 		{
+ 			returnedStatus = EOT_MTX_ERROR;
+-			goto CLEANUP;
++			goto FAIL;
+ 		}
+-		long sizeOut;
+ 		bufsOut[i] = (uint8_t *)MTX_LZCOMP_UnPackMemory(lzcomp, buf->buf + offsets[i], sizes[i], &sizeOut, versionMagic);
+ 		bufSizesOut[i] = sizeOut;
+ 		if (!bufsOut[i])
+ 		{
+ 			returnedStatus = EOT_MTX_ERROR;
+-			goto CLEANUP;
++			goto FAIL;
+ 		}
+ 	}
+-CLEANUP:
++	/* Success: what is still tracked is the three outputs, which now belong to the caller. */
+ 	MTX_LZCOMP_Destroy(lzcomp);
++	MTX_mem_Destroy(mem);
++	return EOT_SUCCESS;
++FAIL:
++	/* Frees everything the decoder still holds, including blocks already decoded. */
++	MTX_mem_FreeAllMemory(mem);
+ 	free(mem);
++	for (unsigned i = 0; i < 3; ++i)
++	{
++		bufsOut[i] = NULL;
++	}
+ 	return returnedStatus;
+ }
