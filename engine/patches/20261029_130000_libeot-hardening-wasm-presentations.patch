diff --git a/external/libeot/05-libeot-uninitialised-glyph-bounds-wasm.patch.1 b/external/libeot/05-libeot-uninitialised-glyph-bounds-wasm.patch.1
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/external/libeot/05-libeot-uninitialised-glyph-bounds-wasm.patch.1
@@ -0,0 +1,43 @@
+Initialise the glyph bounding values that decodeGlyph() passes on unset.
+
+decodeGlyph() reads xMin, yMin, xMax and yMax only when the glyph carries its own bounding box
+(numContours == 0x7FFF), and otherwise hands them, never assigned, to decodeSimpleGlyph(). Using an
+indeterminate value as an argument is undefined behaviour, and clang at -O2 treats it as "undef" and
+rewrites the code around it: in the WASM build every MicroType-Express compressed font then failed to
+decode (EOT_CORRUPT_FILE or EOT_CANT_ALLOCATE_MEMORY, the latter because libeot reports any failed
+stream read as an allocation failure). gcc, and clang at -O1 or below, happen to produce working code,
+so every native build and the one uncompressed font in the fixtures decoded fine and the defect only
+showed in the shipped module. boundingBoxLocation, used only when calculateBoundingBox is set, is
+initialised for the same reason (the compiler cannot see that it is).
+
+Written for FG-054 (owner instruction 2026-10-29), against libeot-0.01 with LibreOffice's three
+patches and the four before this one applied. Test: libeot compiled with Emscripten 3.1.51 and the
+module's own C flags (-O2 -msimd128 -s SUPPORT_LONGJMP=wasm), run under Node: before, 9 of the 10
+decodable corpus fonts fail; after, all 10 decode, and the output is byte-identical to the native decode.
+Zero-initialising every local (-ftrivial-auto-var-init=zero) in parseCTF.c alone gives the same result,
+which is how the file was found (zero-initialising the locals of any other single file does not).
+
+
+--- a/src/ctf/parseCTF.c
++++ b/src/ctf/parseCTF.c
+@@ -376,7 +376,7 @@
+   struct Stream *in = streams[0];
+   enum StreamResult sResult;
+   enum EOTError returnedStatus = EOT_SUCCESS;
+-  unsigned boundingBoxLocation;
++  unsigned boundingBoxLocation = 0;   /* set and used only when calculateBoundingBox */
+   RD2(BEWriteS16, out, numContours, sResult);
+   if (calculateBoundingBox)
+   {
+@@ -624,7 +624,10 @@
+ enum EOTError decodeGlyph(struct Stream **streams, struct Stream *out)
+ {
+   struct Stream *in = streams[0];
+-  int16_t numContours, xMin, yMin, xMax, yMax;
++  int16_t numContours;
++  /* Only read when the glyph carries its own bounding box, but passed on either way: an indeterminate
++     value used as an argument is undefined behaviour, and clang's -O2 acts on it (see the patch header). */
++  int16_t xMin = 0, yMin = 0, xMax = 0, yMax = 0;
+   bool calculateBoundingBox = false;
+   enum StreamResult sResult;
+   RD2(BEReadS16, in, &numContours, sResult);
