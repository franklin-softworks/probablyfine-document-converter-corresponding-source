+// BUG-80: a formula's random VALUE is not an id and must stay random when comphelper::rng is seeded for the ids (see ScInterpreterContext).
+static double unseededUniformReal(double fMin, double fMax)
+{
+    static std::mutex aMutex;
+    static std::mt19937 aGenerator = []() {
+        sal_uInt32 nSeed = 0;
+        if (rtl_random_getBytes(nullptr, &nSeed, sizeof(nSeed)) != rtl_Random_E_None)
+            nSeed = comphelper::rng::uniform_uint_distribution(0, SAL_MAX_UINT32);
+        return std::mt19937(nSeed);
+    }();
+    std::uniform_real_distribution<double> aDist(fMin, fMax);
+    std::scoped_lock<std::mutex> aGuard(aMutex);
+    return aDist(aGenerator);
+}
