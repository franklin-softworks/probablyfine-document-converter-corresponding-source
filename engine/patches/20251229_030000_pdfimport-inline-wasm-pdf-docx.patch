+
+    // Close output files
+    fclose(pTextFile);
+    fclose(pBinaryFile);
+
+    // Now parse the output files using the Parser
+    if (bRet)
+    {
+        SAL_INFO("sdext.pdfimport", "WASM: Parsing PDFOutDev output");
+
+        // Open files for reading
+        oslFileHandle hTextRead = nullptr;
+        oslFileHandle hBinaryRead = nullptr;
+
+        if (osl_openFile(aTextOutURL.pData, &hTextRead, osl_File_OpenFlag_Read) != osl_File_E_None)
+        {
+            SAL_WARN("sdext.pdfimport", "Failed to open text output for reading");
+            bRet = false;
+        }
+        else if (osl_openFile(aBinaryOutURL.pData, &hBinaryRead, osl_File_OpenFlag_Read) != osl_File_E_None)
+        {
+            SAL_WARN("sdext.pdfimport", "Failed to open binary output for reading");
+            osl_closeFile(hTextRead);
+            bRet = false;
+        }
+        else
+        {
+            fprintf(stderr, "[PARSE] Starting parser for PDF output\n");
+            int nLineCount = 0;
+            try
+            {
+                // Use the existing Parser to process the output
+                fprintf(stderr, "[PARSE] Creating Parser object...\n");
+                Parser aParser(rSink, hBinaryRead, xContext);
+                fprintf(stderr, "[PARSE] Parser created, creating Buffering...\n");
+                Buffering aBuffering(hTextRead);
+                OStringBuffer line;
+                fprintf(stderr, "[PARSE] Beginning line parsing loop\n");
+
+                for (;;)
+                {
+                    char aChar('\n');
+                    sal_uInt64 nBytesRead;
+                    oslFileError nRes;
+
+                    // Skip garbage \r \n at start of line
+                    for (;;)
+                    {
+                        nRes = aBuffering.read(&aChar, 1, &nBytesRead);
+                        if (osl_File_E_None != nRes || nBytesRead != 1 || (aChar != '\n' && aChar != '\r'))
+                            break;
+                    }
+                    if (osl_File_E_None != nRes)
+                        break;
+
+                    if (aChar != '\n' && aChar != '\r')
+                        line.append(aChar);
+
+                    for (;;)
+                    {
+                        nRes = aBuffering.read(&aChar, 1, &nBytesRead);
+                        if (osl_File_E_None != nRes || nBytesRead != 1 || aChar == '\n' || aChar == '\r')
+                            break;
+                        line.append(aChar);
+                    }
+                    if (osl_File_E_None != nRes)
+                        break;
+                    if (line.isEmpty())
+                        break;
+
+                    nLineCount++;
+                    if (nLineCount <= 10 || nLineCount % 1000 == 0)
+                    {
+                        OString lineStr = line.makeStringAndClear();
+                        // Show first token only for brevity
+                        size_t spacePos = lineStr.indexOf(' ');
+                        OString cmd = (spacePos != -1) ? lineStr.copy(0, spacePos) : lineStr;
+                        fprintf(stderr, "[PARSE] Line %d: cmd=%s\n", nLineCount, cmd.getStr());
+                        line.append(lineStr);
+                    }
+                    aParser.parseLine(line);
+                    line.setLength(0);
+                }
+
+                fprintf(stderr, "[PARSE] Loop ended, parsed %d lines\n", nLineCount);
+                SAL_INFO("sdext.pdfimport", "WASM: Parser completed successfully");
+            }
+            catch (const uno::Exception& e)
+            {
+                fprintf(stderr, "[PARSE] uno::Exception at line %d: %s\n",
