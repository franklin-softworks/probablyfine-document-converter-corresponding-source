+            }
+            catch (...)
+            {
+                fprintf(stderr, "[PARSE] Unknown exception at line %d\n", nLineCount);
+                bRet = false;
+            }
+            fprintf(stderr, "[PARSE] Parser finished, bRet=%d\n", bRet ? 1 : 0);
+
+            osl_closeFile(hTextRead);
+            osl_closeFile(hBinaryRead);
+        }
+    }
+
+    // Clean up temp files
+    osl_removeFile(aTextOutURL.pData);
+    osl_removeFile(aBinaryOutURL.pData);
+
+    return bRet;
+}
