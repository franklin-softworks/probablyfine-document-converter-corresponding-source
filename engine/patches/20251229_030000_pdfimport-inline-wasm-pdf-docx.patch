+#ifdef EMSCRIPTEN_INLINE_PDFIMPORT
+// WASM-specific: C-style wrapper for inline PDF processing
+// This function can be called from wrapper.cxx without including pdfioutdev_gpl.hxx
+// Note: g_binary_out is defined at the top of this file (not inside extern "C")
+// so it has C++ linkage, but that's fine since we only access it within this file.
+extern "C" {
+
+bool pdfi_process_pdf_inline(
+    const char* pdfPath,
+    const char* ownerPwd,
+    const char* userPwd,
+    FILE* textOutFile,
+    FILE* binaryOutFile,
+    bool skipImages)
+{
+    fprintf(stderr, "[PDFIMPORT] pdfi_process_pdf_inline: Starting for %s\n", pdfPath);
+
+    // Save original stdout and set up redirection
+    int savedStdout = dup(fileno(stdout));
+    dup2(fileno(textOutFile), fileno(stdout));
+
+    // Set g_binary_out for PDFOutDev
+    FILE* savedBinaryOut = g_binary_out;
+    g_binary_out = binaryOutFile;
+
+    bool bSuccess = false;
+
+    try
+    {
+        // Initialize Poppler GlobalParams if not already done
+        if (!globalParams)
+        {
+#if POPPLER_CHECK_VERSION(0, 83, 0)
+            globalParams = std::make_unique<GlobalParams>(nullptr);
+#else
+            globalParams = new GlobalParams(nullptr);
+#endif
+            // Don't suppress errors so we can see poppler diagnostics
+            fprintf(stderr, "[PDFIMPORT] Poppler GlobalParams initialized\n");
+        }
+
+        fprintf(stderr, "[PDFIMPORT] Creating PDFDoc...\n");
+        // Create PDFDoc - construct with password strings if provided
+#if POPPLER_CHECK_VERSION(22, 6, 0)
+        std::optional<GooString> ownerPwdOpt = (ownerPwd && ownerPwd[0])
+            ? std::optional<GooString>(std::in_place, ownerPwd)
+            : std::nullopt;
+        std::optional<GooString> userPwdOpt = (userPwd && userPwd[0])
+            ? std::optional<GooString>(std::in_place, userPwd)
+            : std::nullopt;
+        PDFDoc aDoc(std::make_unique<GooString>(pdfPath), ownerPwdOpt, userPwdOpt);
+#else
+        GooString* pOwnerPwdStr = (ownerPwd && ownerPwd[0]) ? new GooString(ownerPwd) : nullptr;
+        GooString* pUserPwdStr = (userPwd && userPwd[0]) ? new GooString(userPwd) : nullptr;
+        PDFDoc aDoc(new GooString(pdfPath), pOwnerPwdStr, pUserPwdStr);
+#endif
+
+        fprintf(stderr, "[PDFIMPORT] PDFDoc created, isOk=%d\n", aDoc.isOk() ? 1 : 0);
+
+        if (aDoc.isOk())
+        {
+            const int nPages = aDoc.getNumPages();
+            fprintf(stderr, "[PDFIMPORT] PDF OK: pages=%d, version=%d.%d, encrypted=%d\n",
+                    nPages, aDoc.getPDFMajorVersion(), aDoc.getPDFMinorVersion(),
+                    aDoc.isEncrypted() ? 1 : 0);
+
+            // Create PDFOutDev and process pages
+            pdfi::PDFOutDev aOutDev(&aDoc);
+            if (skipImages)
+                aOutDev.setSkipImages(true);
+
+            // Output page count first
+            pdfi::PDFOutDev::setPageNum(nPages);
+
+            // Virtual resolution for PDF rendering (matches xpdfimport)
+            static const int PDF_OUTDEV_RESOLUTION = 7200;
+
+            // Process each page
+            for (int i = 1; i <= nPages; ++i)
+            {
+                fprintf(stderr, "[PDFIMPORT] Processing page %d/%d...\n", i, nPages);
+                aDoc.displayPage(&aOutDev, i,
+                                PDF_OUTDEV_RESOLUTION,
+                                PDF_OUTDEV_RESOLUTION,
+                                0, true, true, true);
+                aDoc.processLinks(&aOutDev, i);
+            }
+
+            fprintf(stderr, "[PDFIMPORT] All pages processed successfully\n");
+            bSuccess = true;
+        }
+        else
+        {
+            int errCode = aDoc.getErrorCode();
+            fprintf(stderr, "[PDFIMPORT] ERROR: PDFDoc.isOk()=false, errorCode=%d\n", errCode);
+        }
+    }
+    catch (...)
+    {
+        fprintf(stderr, "[PDFIMPORT] EXCEPTION caught!\n");
+    }
+
+    // Flush and restore stdout
+    fflush(stdout);
+    dup2(savedStdout, fileno(stdout));
+    close(savedStdout);
+
+    // Restore g_binary_out
+    fflush(g_binary_out);
+    g_binary_out = savedBinaryOut;
+
+    fprintf(stderr, "[PDFIMPORT] Returning %s\n", bSuccess ? "true" : "false");
+    return bSuccess;
+}
+
+} // extern "C"
