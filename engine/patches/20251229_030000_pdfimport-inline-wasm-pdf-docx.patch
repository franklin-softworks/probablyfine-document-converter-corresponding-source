+    osl_getSystemPathFromFileURL(aTextOutURL.pData, &aTextOutPath.pData);
+    osl_getSystemPathFromFileURL(aBinaryOutURL.pData, &aBinaryOutPath.pData);
+
+    OString aTextOutPathOStr = OUStringToOString(aTextOutPath, osl_getThreadTextEncoding());
