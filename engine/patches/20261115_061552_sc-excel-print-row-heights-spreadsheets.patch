+    // the heights as read (before the BIFF5 optimal-height pass or anything else changes them), as runs
+    for (SCROW nRow = 0; nRow <= rDoc.MaxRow();)
+    {
+        SCROW nStart = nRow, nEnd = nRow;
+        const sal_uInt16 nTwips = rDoc.GetRowHeight(nRow, nScTab, &nStart, &nEnd, false);
+        aPitchInfo.aStored.push_back({ nRow, nEnd, nTwips });
+        nRow = nEnd + 1;
+    }
+    sc::excelpitch::SetSheetInfo(rDoc, nScTab, std::move(aPitchInfo));
+
     mbDirty = false;
 }
 
