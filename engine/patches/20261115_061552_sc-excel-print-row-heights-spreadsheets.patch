+#include <utility>
+#include <vector>
+
+class ScDocument;
+
+// Row heights of an Excel workbook as Excel PRINTS them (a PDF conversion, BUG-81 sheet_rows). The Excel import records what it read per sheet
+// (SetSheetInfo); the print/PDF render path calls ApplyPrintRowHeights once before it lays pages out. Nothing happens unless the environment
+// variable LO_WASM_EXCEL_PRINT_ROWS is "1" (the bridge sets it for a PDF target only) and the document came from an Excel filter.
+namespace sc::excelpitch
+{
+enum class Kind : sal_uInt8
+{
+    Biff5,
+    Biff8,
+    Ooxml
+};
+
+struct SheetInfo
+{
+    Kind eKind = Kind::Ooxml;
+    OUString aNormalFont;                                    // BIFF: the font of the Normal style (XF 0); empty = read Calc's Default style
+    sal_Int32 nNormalHeightTwips = 0;
+    sal_Int32 nDefRowTwips = 0;                              // BIFF: DEFAULTROWHEIGHT
+    bool bDefRowFlag = false;                                // BIFF: its "height differs from the default font" flag
+    std::vector<std::pair<SCROW, SCROW>> aCustomRows;        // BIFF: rows whose own height is custom (sorted, inclusive ranges)
+    struct Run
+    {
+        SCROW nFirst;
+        SCROW nLast;
+        sal_uInt16 nTwips;
+    };
+    std::vector<Run> aStored;                                // BIFF: the heights as read, before any recomputation
+};
+
+SC_DLLPUBLIC void SetSheetInfo(const ScDocument& rDoc, SCTAB nTab, SheetInfo aInfo);
+SC_DLLPUBLIC void ApplyPrintRowHeights(ScDocument& rDoc);
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
