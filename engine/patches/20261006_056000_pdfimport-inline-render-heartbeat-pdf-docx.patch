+    if (m_pBeatFn)
+        m_pBeatFn(m_pBeatCtx, m_nBeatPage, m_nBeatPages);
+}
+
+void PDFOutDev::beat()
+{
+    if (!m_pBeatFn)
+        return;
+    const auto aNow = std::chrono::steady_clock::now();
+    if (aNow - m_aLastBeat < std::chrono::seconds(2))
+        return;
+    m_aLastBeat = aNow;
+    m_pBeatFn(m_pBeatCtx, m_nBeatPage, m_nBeatPages);
+}
