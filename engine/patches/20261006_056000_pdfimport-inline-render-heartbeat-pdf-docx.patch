+void PDFIProcessor::renderHeartbeat( sal_Int32 nPage, sal_Int32 nPages )
+{
+    // FG-142: progress for the render phase, which runs before any page
+    // element exists. The parse phase restarts the indicator at its first page.
+    if( !m_xStatusIndicator.is() || nPages <= 0 )
+        return;
+    if( !m_bRenderIndicatorStarted )
+    {
+        m_xStatusIndicator->start( u" "_ustr, nPages );
+        m_bRenderIndicatorStarted = true;
+    }
+    // A repeated value is forwarded too (LOK drops only a lower one).
+    m_xStatusIndicator->setValue( std::clamp<sal_Int32>( nPage - 1, 0, nPages ) );
+}
