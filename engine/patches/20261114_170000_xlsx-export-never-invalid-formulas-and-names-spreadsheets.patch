+/** BUG-89: the characters a defined name may have in xlsx (the formula text names it; a name with a space cannot be parsed). */
+bool lcl_IsFormulaNameParsable( const OUString& rName )
+{
+    if( rName.isEmpty() )
+        return false;
+    for( sal_Int32 i = 0; i < rName.getLength(); ++i )
+    {
+        const sal_Unicode c = rName[i];
+        const bool bLetter = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_' || c == '\\' || c > 0x7f;
+        const bool bDigitEtc = (c >= '0' && c <= '9') || c == '.' || c == '?';
+        if( !(bLetter || (i > 0 && bDigitEtc)) )
+            return false;
+    }
+    return true;
+}
+
+/** BUG-89: can the text of this formula be written to an xlsx file and read back by Excel? A formula Excel cannot parse makes Excel refuse the whole file. Not
+    expressible: an unresolved reference the import kept as a "bad" token (an external workbook of a BIFF5 file: the text comes out empty or as bare operators:
+    "+", "++", "(+)/"), a call of an unknown function (an Excel 4 macro function comes out as "#NAME!()": an error constant followed by an argument list), a name
+    Excel does not accept. Such a cell is written as its cached value only. */
+bool lcl_IsXmlFormulaExpressible( const ScTokenArray& rCode, const OUString& rText, const ScDocument& rDoc )
+{
+    const OUString aText = rText.trim();
+    if( aText.isEmpty() )
+        return false;
+    bool bOperand = false;
+    for( sal_Int32 i = 0; i < aText.getLength() && !bOperand; ++i )
+    {
+        const sal_Unicode c = aText[i];
+        bOperand = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '"' || c == '\'' || c == '#' || c == '[' || c == '{' || c == '_' || c > 0x7f;
+    }
+    if( !bOperand )
+        return false;
+    // an error constant followed by "(": #NAME!(), #REF!(), #N/A(
+    for( sal_Int32 i = aText.indexOf( '#' ); i >= 0; i = aText.indexOf( '#', i + 1 ) )
+    {
+        sal_Int32 j = i + 1;
+        while( j < aText.getLength() && ((aText[j] >= 'A' && aText[j] <= 'Z') || (aText[j] >= '0' && aText[j] <= '9') || aText[j] == '/') )
+            ++j;
+        if( j < aText.getLength() && (aText[j] == '!' || aText[j] == '?') )
+            ++j;
+        if( j > i + 1 && j < aText.getLength() && aText[j] == '(' )
+            return false;
+    }
+    const sal_uInt16 nLen = rCode.GetLen();
+    formula::FormulaToken** pTokens = rCode.GetArray();
+    for( sal_uInt16 i = 0; i < nLen; ++i )
+    {
+        const OpCode eOp = pTokens[i]->GetOpCode();
+        if( eOp == ocBad )
+            return false;
+        if( eOp == ocName )
+        {
+            const ScRangeData* pName = rDoc.FindRangeNameBySheetAndIndex( pTokens[i]->GetSheet(), pTokens[i]->GetIndex() );
+            if( pName && !lcl_IsFormulaNameParsable( pName->GetName() ) )
+                return false;
+        }
+    }
+    return true;
+}
+
+}
