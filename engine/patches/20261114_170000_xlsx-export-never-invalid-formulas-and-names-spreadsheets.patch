+#ifdef __EMSCRIPTEN__
+namespace {
+
+/** BUG-89: may this defined name be written to an xlsx file? A name Excel refuses makes Excel refuse the whole file: a name with a space or another character a name
+    cannot have (Lotus-era "123Graph_ACHART 1="), an error value, and the auto-run names Excel 4 macros use (Auto_Open, Auto_Close, Auto_Activate, Auto_Deactivate,
+    imported as Excel_BuiltIn_Auto_Open ...): this converter never writes anything that runs. */
+bool lcl_IsDefinedNameWritable( const OUString& rName, const OUString& rSymbol, sal_Unicode cBuiltIn )
+{
+    if( cBuiltIn != EXC_BUILTIN_UNKNOWN )
+    {
+        if( cBuiltIn == EXC_BUILTIN_AUTOOPEN || cBuiltIn == EXC_BUILTIN_AUTOCLOSE || cBuiltIn == EXC_BUILTIN_AUTOACTIVATE || cBuiltIn == EXC_BUILTIN_AUTODEACTIVATE )
+            return false;
+        return true;
+    }
+    if( rName.isEmpty() || rName.getLength() > 255 )
+        return false;
+    for( sal_Int32 i = 0; i < rName.getLength(); ++i )
+    {
+        const sal_Unicode c = rName[i];
+        const bool bLetter = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_' || c == '\\' || c > 0x7f;
+        const bool bDigitEtc = (c >= '0' && c <= '9') || c == '.' || c == '?';
+        if( !(bLetter || (i > 0 && bDigitEtc)) )
+            return false;
+    }
+    if( rName.equalsIgnoreAsciiCase( u"Auto_Open" ) || rName.equalsIgnoreAsciiCase( u"Auto_Close" )
+        || rName.equalsIgnoreAsciiCase( u"Auto_Activate" ) || rName.equalsIgnoreAsciiCase( u"Auto_Deactivate" )
+        || rName.startsWithIgnoreAsciiCase( u"Excel_BuiltIn_Auto_" ) )
+        return false;
+    if( rSymbol.isEmpty() || rSymbol.startsWith( "#" ) )     // no definition (written as #NAME?) or an error value (#REF!)
+        return false;
+    return true;
+}
+
+}
+#endif
